{
  "name": "@caret/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Caret's endpoint-owned encrypted relay transport",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./host": {
      "types": "./src/host.ts",
      "import": "./src/host.ts",
      "default": "./src/host.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "node": "./src/server.ts",
      "import": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./e2ee": {
      "types": "./src/e2ee.ts",
      "import": "./src/e2ee.ts",
      "default": "./src/e2ee.ts"
    }
  },
  "dependencies": {
    "base64-js": "1.5.1",
    "tweetnacl": "1.0.3",
    "ws": "8.20.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}
