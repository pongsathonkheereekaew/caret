@@ -0,0 +1,54 @@
+/* Caret: the branch and runtime chips beside the Agent Home workspace picker.
+ *
+ * The reference draws them as plain text chips on the surface - icon, label, no card
+ * fill - in a row that also holds the workspace picker. Only the chips Caret adds are
+ * styled here; the picker keeps its own base styling.
+ */
+
+.caret-agent-home-context-chip {
+	display: flex;
+	align-items: center;
+	gap: 4px;
+	flex: 0 1 auto;
+	min-width: 0;
+	height: 24px;
+	padding: 0 6px;
+	border: none;
+	border-radius: 4px;
+	background: transparent;
+	color: var(--vscode-descriptionForeground, var(--vscode-foreground));
+	font-family: inherit;
+	font-size: var(--vscode-fontSize-label1, 12px);
+	white-space: nowrap;
+	overflow: hidden;
+	text-overflow: ellipsis;
+}
+
+.caret-agent-home-context-icon {
+	display: flex;
+	align-items: center;
+	justify-content: center;
+	flex: 0 0 auto;
+	width: 16px;
+	height: 16px;
+	color: var(--vscode-icon-foreground);
+}
+
+.caret-agent-home-context-label {
+	overflow: hidden;
+	text-overflow: ellipsis;
+}
+
+button.caret-agent-home-context-branch {
+	cursor: pointer;
+}
+
+button.caret-agent-home-context-branch:hover {
+	background: var(--vscode-toolbar-hoverBackground, var(--vscode-list-hoverBackground));
+	color: var(--vscode-foreground);
+}
+
+button.caret-agent-home-context-branch:focus-visible {
+	outline: 1px solid var(--vscode-focusBorder);
+	outline-offset: -1px;
+}
