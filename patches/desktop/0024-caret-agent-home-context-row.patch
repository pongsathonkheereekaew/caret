@@ -0,0 +1,92 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Caret. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { type FunctionComponent } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+
+/**
+ * The composer's context chips as a React surface.
+ *
+ * Last of the Caret-authored Agent Home pieces to move (`appsPanelReact.ts`,
+ * `agentHomeNavReact.ts`): the reference draws this region as part of its React tree, and these
+ * two chips were the remaining hand-built DOM. The contribution keeps the decisions - which chip
+ * exists, what the branch is, whether this window runs locally - and React owns the markup from
+ * that model, with the class names the stylesheet already targets.
+ *
+ * Written in JSX (hence `.tsx`) because that is how the reference writes its own components, and
+ * the workbench build now compiles it: `src/tsconfig.json` sets `jsx: react-jsx`, the bundler runs
+ * esbuild with `jsx: 'automatic'`, and `inlineReactPlugin` inlines `react/jsx-runtime` alongside
+ * `react` so the renderer can resolve it.
+ */
+
+export interface IAgentHomeContextChip {
+	/** Chip text. */
+	readonly label: string;
+	/** The accessible name, which spells out what the chip does. */
+	readonly title: string;
+	readonly iconId: string;
+}
+
+/** An absent member means "this chip is not shown"; the reference omits both in that case. */
+export interface IAgentHomeContextModel {
+	readonly branch?: IAgentHomeContextChip;
+	readonly runtime?: IAgentHomeContextChip;
+}
+
+export interface IAgentHomeContextHandlers {
+	readonly onCopyBranch: () => void;
+}
+
+export interface IAgentHomeContextHandle {
+	update(model: IAgentHomeContextModel): void;
+	dispose(): void;
+}
+
+const ChipIcon: FunctionComponent<{ readonly iconId: string }> = ({ iconId }) => (
+	<span className="caret-agent-home-context-icon" aria-hidden="true">
+		<span className={`codicon codicon-${iconId}`} />
+	</span>
+);
+
+const ContextRow: FunctionComponent<{ readonly model: IAgentHomeContextModel; readonly handlers: IAgentHomeContextHandlers }> = ({ model, handlers }) => (
+	<>
+		{model.branch ? (
+			<button
+				type="button"
+				className="caret-agent-home-context-chip caret-agent-home-context-branch"
+				title={model.branch.title}
+				aria-label={model.branch.title}
+				onClick={handlers.onCopyBranch}
+			>
+				<ChipIcon iconId={model.branch.iconId} />
+				<span className="caret-agent-home-context-label">{model.branch.label}</span>
+			</button>
+		) : null}
+		{model.runtime ? (
+			<span
+				className="caret-agent-home-context-chip caret-agent-home-context-runtime"
+				title={model.runtime.title}
+				aria-label={model.runtime.title}
+			>
+				<ChipIcon iconId={model.runtime.iconId} />
+				<span className="caret-agent-home-context-label">{model.runtime.label}</span>
+			</span>
+		) : null}
+	</>
+);
+
+/**
+ * `host` is a `display: contents` wrapper, so React's root element does not become a flex item of
+ * the composer's picker row - the chips have to sit in that row exactly as they did before.
+ */
+export function mountAgentHomeContextRow(host: HTMLElement, model: IAgentHomeContextModel, handlers: IAgentHomeContextHandlers): IAgentHomeContextHandle {
+	host.style.display = 'contents';
+	const root: Root = createRoot(host);
+	root.render(<ContextRow model={model} handlers={handlers} />);
+	return {
+		update: next => root.render(<ContextRow model={next} handlers={handlers} />),
+		dispose: () => root.unmount(),
+	};
+}
diff --git a/src/vs/sessions/contrib/home/browser/media/agentHomeContextRow.css b/src/vs/sessions/contrib/home/browser/media/agentHomeContextRow.css
