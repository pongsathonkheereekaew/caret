+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Caret. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { $, append } from '../../../../base/browser/dom.js';
+import { Codicon } from '../../../../base/common/codicons.js';
+import { Disposable, MutableDisposable } from '../../../../base/common/lifecycle.js';
+import { autorun } from '../../../../base/common/observable.js';
+import { localize } from '../../../../nls.js';
+import { ICommandService } from '../../../../platform/commands/common/commands.js';
+import { IAgentHostConnectionsService } from '../../../../platform/agentHost/common/agentHostConnectionsService.js';
+import { LOCAL_AGENT_HOST_PROVIDER_ID } from '../../../common/agentHostSessionsProvider.js';
+import { ISessionsService } from '../../../services/sessions/browser/sessionsService.js';
+import { IAgentHomeContextModel, mountAgentHomeContextRow } from './agentHomeContextRowReact.js';
+
+/** The base's own copy-branch command, which takes the session as its argument. */
+const COPY_SESSION_BRANCH_NAME_COMMAND_ID = 'sessionsViewPane.agentHost.copySessionBranchName';
+
+/**
+ * The two chips the reference puts beside the workspace picker: the branch the
+ * session is on, and where it runs.
+ *
+ * Both are read from real state rather than assumed. The branch is the selected
+ * workspace folder's git branch, the same value the base's own session actions read,
+ * and clicking the chip runs the base's copy-branch command for that session. The
+ * runtime chip reports where the session would run: it reads "This Mac" only while no
+ * remote agent host is connected, which is the one execution target Caret can offer
+ * today. Nothing is rendered when there is no branch, so neither chip can be a control
+ * with nothing behind it.
+ */
+export class AgentHomeContextRow extends Disposable {
+
+	/** The React root and the wrapper it lives in; both go away when the composer rebuilds the row. */
+	private readonly _chips = this._register(new MutableDisposable<{
+		readonly wrapper: HTMLElement;
+		update(model: IAgentHomeContextModel): void;
+		dispose(): void;
+	}>());
+
+	private static readonly _rowSelector = '.new-session-workspace-picker-container .sessions-workspace-category-picker';
+
+	constructor(
+		@ISessionsService private readonly sessionsService: ISessionsService,
+		@IAgentHostConnectionsService private readonly connectionsService: IAgentHostConnectionsService,
+		@ICommandService private readonly commandService: ICommandService,
+	) {
+		super();
+
+		// The chips follow the session state...
+		this._register(autorun(() => this.render()));
+		this._register(this.connectionsService.onDidChangeConnections(() => this.render()));
+
+		// ...and the row they live in is rebuilt by the composer whenever its content
+		// changes, which can happen after this contribution's first pass. A cheap guard
+		// re-renders only while the row is present and Caret's chips are not, so the
+		// re-render cannot feed itself.
+		const observer = new MutationObserver(() => {
+			const row = document.querySelector(AgentHomeContextRow._rowSelector);
+			if (row && !row.querySelector('.caret-agent-home-context-chip')) {
+				this.render();
+			}
+		});
+		observer.observe(document.body, { childList: true, subtree: true });
+		this._register({ dispose: () => observer.disconnect() });
+	}
+
+	private render(): void {
+		const session = this.sessionsService.activeSession.get();
+		const branch = session?.workspace.get()?.folders[0]?.gitRepository?.branchName?.trim();
+		// The session owner is the local agent host whenever the window has no remote
+		// execution target connected; that is the truthful reading of "runs here".
+		const hasRemoteTarget = this.connectionsService.connections.some(connection => !connection.isAmbient && connection.connection !== undefined);
+		const runsLocally = !hasRemoteTarget && (session === undefined || session.providerId === LOCAL_AGENT_HOST_PROVIDER_ID);
+
+		const row = document.querySelector<HTMLElement>(AgentHomeContextRow._rowSelector);
+		if (!row) {
+			this._chips.value = undefined;
+			return;
+		}
+
+		const model: IAgentHomeContextModel = {
+			// Nothing is rendered when there is no branch, so neither chip can be a control with
+			// nothing behind it.
+			branch: branch && session ? {
+				label: branch,
+				title: localize('caret.context.copyBranch', "Copy branch {0}", branch),
+				iconId: Codicon.gitBranch.id,
+			} : undefined,
+			runtime: runsLocally ? {
+				label: localize('caret.context.thisMac', "This Mac"),
+				title: localize('caret.context.localRuntime', "Runs on this Mac"),
+				iconId: Codicon.deviceDesktop.id,
+			} : undefined,
+		};
+
+		// The composer rebuilds this row when its state changes, which takes the chips' wrapper with
+		// it; a rebuilt row needs a new root rather than an update into a detached element.
+		const mounted = this._chips.value;
+		if (mounted && mounted.wrapper.isConnected && row.contains(mounted.wrapper)) {
+			mounted.update(model);
+			return;
+		}
+		const wrapper = append(row, $('span.caret-agent-home-context-chips'));
+		const handle = mountAgentHomeContextRow(wrapper, model, {
+			onCopyBranch: () => {
+				if (session) {
+					void this.commandService.executeCommand(COPY_SESSION_BRANCH_NAME_COMMAND_ID, session);
+				}
+			},
+		});
+		this._chips.value = {
+			wrapper,
+			update: handle.update,
+			dispose: () => {
+				handle.dispose();
+				wrapper.remove();
+			},
+		};
+	}
+}
