+/**
+ * Vendor `apps/macos` registers its OMP language models under. Kept as a literal
+ * because the workbench cannot import from the extension package; the value is
+ * pinned to the extension's `CARET_OMP_MODEL_VENDOR` by
+ * `apps/macos/test/ide-native-workbench.test.ts`.
+ */
+const CARET_OMP_MODEL_VENDOR = 'caret-omp';
+
+/**
+ * Caret sessions window: project the session provider's OMP-advertised `models`
+ * option group into picker entries. Mirrors the bridge projection rules
+ * (extensionSessionsProvider `getModelsSnapshot`): entries without id/name are
+ * dropped, unknown vendors stay empty (never invented), token counts stay 0
+ * (neutral unknown). Empty catalogs stay empty — honest-disabled downstream.
+ */
+function getCaretSessionOptionModels(chatSessionsService: IChatSessionsService, languageModelsService: ILanguageModelsService, sessionType: string): ILanguageModelChatMetadataAndIdentifier[] {
+	// The option-group store is keyed by item-controller type, which matches the
+	// item URI scheme for Caret (`caret.omp`). A resource type with no groups
+	// simply contributes nothing — honest-empty downstream.
+	const groups = chatSessionsService.getOptionGroupsForSessionType(sessionType);
+	const items = groups?.find(group => group.id === 'models')?.items ?? [];
+	const models: ILanguageModelChatMetadataAndIdentifier[] = [];
+	for (const item of items) {
+		const id = item.id?.trim();
+		const name = item.name?.trim();
+		if (!id || !name) {
+			continue;
+		}
+		// OMP advertises the window; like the sessions bridge this reads it from the
+		// registered model rather than duplicating it into the option item, so a
+		// model with no advertised size keeps 0 (the neutral unknown).
+		const registered = languageModelsService.lookupLanguageModel(`${CARET_OMP_MODEL_VENDOR}/${id}`);
+		models.push({
+			// Same identifier contract as the sessions bridge: the extension host
+			// resolves the request's model by `<vendor>/<model id>` for the vendor
+			// `apps/macos` registers, so a bare OMP id here would make the send fail
+			// as "Language model unavailable".
+			identifier: `${CARET_OMP_MODEL_VENDOR}/${id}`,
+			metadata: {
+				extension: new ExtensionIdentifier('caret.caret'),
+				id,
+				name,
+				vendor: item.description?.trim() || '',
+				version: '1.0',
+				family: id,
+				tooltip: item.tooltip,
+				maxInputTokens: registered?.maxInputTokens ?? 0,
+				maxOutputTokens: registered?.maxOutputTokens ?? 0,
+				isDefaultForLocation: {},
+				targetChatSessionType: sessionType,
+				isUserSelectable: true,
+			},
+		});
+	}
+	return models;
+}
