+/* Caret: the Agent Home composer in the reference shape.
+ *
+ * The reference composer card is 605.5 x 103.5 CSS px (its fill spans x=987..2198 and
+ * y=1091..1298 of the native 3420x2224 reference capture), i.e. taller than the base
+ * card, which leaves ~15px of padding under the toolbar row instead of hugging it.
+ * The starter rows below the card are the base's own prompt options, so they need no
+ * styling here beyond the reference's own spacing.
+ *
+ * Scoped to the sessions workbench and the new-session widget, so the IDE composer and
+ * the in-session composer keep their own sizing.
+ */
+
+/* The card body is taller than the base's: the reference leaves about 15px under the
+ * toolbar row, so the placeholder, the toolbar and the card's own padding sit in a
+ * 104px box instead of hugging the 86px the base ships. */
+.agent-sessions-workbench .new-chat-widget-content .new-chat-input-area-wrapper,
+.agent-sessions-workbench .new-chat-widget-content .new-chat-input-area {
+	min-height: 104px;
+}
+
+.agent-sessions-workbench .new-chat-widget-content .new-chat-input-area {
+	padding-bottom: 8px;
+}
+
+/* The stack is a plain block by default, so the standalone prompt-option slot renders
+ * before the input. The reference puts the starters below the composer card, so the
+ * stack becomes an explicit column and the two members are ordered. */
+.agent-sessions-workbench .new-chat-widget-content .chat-input-stack {
+	display: flex;
+	flex-direction: column;
+}
+
+.agent-sessions-workbench .new-chat-widget-content .chat-input-stack > .new-chat-input-area-wrapper {
+	order: 1;
+}
+
+.agent-sessions-workbench .new-chat-widget-content .chat-input-stack > .new-session-prompt-options {
+	order: 2;
+	margin-top: 12px;
+}
+
+.agent-sessions-workbench .new-chat-widget-content .new-session-prompt-options-list {
+	display: flex;
+	flex-direction: column;
+	gap: 4px;
+}
+
+/* The reference draws a starter as one line - icon, title, then the description in a
+ * dimmer weight beside it - where the base stacks the description under the title.
+ * Same three elements, one grid row, so the list reads as a list rather than as cards. */
+.agent-sessions-workbench .new-chat-widget-content .new-session-prompt-option {
+	grid-template-columns: var(--vscode-spacing-size160) minmax(0, auto) minmax(0, 1fr);
+	grid-template-rows: auto;
+	row-gap: 0;
+	padding: 4px 8px;
+}
+
+.agent-sessions-workbench .new-chat-widget-content .new-session-prompt-option-title {
+	grid-column: 2;
+	grid-row: 1;
+}
+
+.agent-sessions-workbench .new-chat-widget-content .new-session-prompt-option-description {
+	grid-column: 3;
+	grid-row: 1;
+	padding-left: 8px;
+	color: var(--vscode-descriptionForeground);
+}
