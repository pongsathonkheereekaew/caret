+
+import { CancellationToken } from '../../../../base/common/cancellation.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { autorun } from '../../../../base/common/observable.js';
+import { INewSessionComposer, INewSessionComposerService, INewSessionPromptOptionsController, NewSessionPromptOptionsState } from '../../chat/browser/newSessionComposerService.js';
+import { createStandardPromptOptions } from '../../onboardingTours/browser/newSessionViewV3Prompt.js';
+
+/**
+ * The starter rows under the Agent Home composer.
+ *
+ * Caret already owns this surface: `INewSessionComposer` renders prompt options and
+ * inserts the chosen prompt into the input, with the placeholder selected so the user
+ * fills in the blank. In the base those rows only appear from the
+ * `sessions.onboarding.newSessionViewV3` tour, which is behind a Copilot experiment
+ * flag and a "no recent sessions" trigger, so the Agents window never showed them.
+ * Attaching the controller directly gives the empty home the base's own starters and
+ * their real insert behaviour, with no new copy and no placeholder UI.
+ */
+export class AgentHomePromptOptions extends Disposable {
+
+	private readonly _controller: INewSessionPromptOptionsController = {
+		resolve: async (): Promise<NewSessionPromptOptionsState> => ({ kind: 'resolved', options: createStandardPromptOptions() }),
+		// The composer inserts the prompt and reports the interaction; Caret has no
+		// telemetry sink for either, and the rows need no other side effect.
+		onDidSelectOption: () => { },
+		onDidClose: () => { },
+	};
+
+	constructor(
+		@INewSessionComposerService composerService: INewSessionComposerService,
+	) {
+		super();
+
+		// The active composer changes as the home is shown, hidden, or replaced, so the
+		// controller follows it rather than being attached once at construction.
+		this._register(autorun(reader => {
+			const composer = composerService.activeComposer.read(reader);
+			if (composer) {
+				this.attach(composer);
+			}
+		}));
+	}
+
+	private attach(composer: INewSessionComposer): void {
+		composer.setPromptOptionsController?.(this._controller);
+		void composer.refreshPromptOptions?.(CancellationToken.None);
+	}
+}
