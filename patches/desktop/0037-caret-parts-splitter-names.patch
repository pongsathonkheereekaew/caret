 	private readonly parts = new Map<string, Part>();
 	protected workbenchGrid!: SerializableGrid<ISerializableView>;
 
+	/**
+	 * Caret: give the sidebar and panel splitters the accessible names the reference uses.
+	 *
+	 * Called after the grid exists and whenever a part's visibility changes, because a hidden part
+	 * takes its boundary with it. A sash is matched to a part by position rather than by identity:
+	 * the grid creates the sash elements and keeps no handle to them, and geometry is what a user
+	 * actually drags.
+	 */
+	private namePartSplitters(): void {
+		const grid = this.workbenchGrid;
+		if (!grid) {
+			return;
+		}
+		const name = (element: Element, label: string): void => {
+			element.setAttribute('role', 'separator');
+			element.setAttribute('aria-orientation', 'vertical');
+			element.setAttribute('aria-label', label);
+		};
+		const within = (value: number, edge: number): boolean => Math.abs(value - edge) <= 2;
+		const sideBar = this.getPart(Parts.SIDEBAR_PART).element.getBoundingClientRect();
+		const auxiliaryBar = this.getPart(Parts.AUXILIARYBAR_PART).element.getBoundingClientRect();
+		// The Apps panel in this window is the editor part's right-hand group, so its boundary is
+		// the editor part's left edge - there is no auxiliary bar to measure here.
+		const editorPart = this.getPart(Parts.EDITOR_PART).element.getBoundingClientRect();
+		for (const sash of grid.element.querySelectorAll('.monaco-sash')) {
+			if (!(sash instanceof HTMLElement) || sash.offsetParent === null) {
+				continue;
+			}
+			const box = sash.getBoundingClientRect();
+			const centre = box.left + box.width / 2;
+			if (sideBar.width > 0 && within(centre, sideBar.right) && box.top < sideBar.bottom && box.bottom > sideBar.top) {
+				name(sash, 'Resize sidebar');
+			} else if (auxiliaryBar.width > 0 && within(centre, auxiliaryBar.left) && box.top < auxiliaryBar.bottom && box.bottom > auxiliaryBar.top) {
+				name(sash, 'Resize panel');
+			} else if (editorPart.width > 0 && within(centre, editorPart.left) && box.top < editorPart.bottom && box.bottom > editorPart.top) {
+				name(sash, 'Resize panel');
+			}
+		}
+	}
+
