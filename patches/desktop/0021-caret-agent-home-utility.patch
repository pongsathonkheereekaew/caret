index 00000000000..108e888a6bc
--- /dev/null
+++ b/src/vs/sessions/contrib/home/browser/appsPanelModel.ts
@@ -0,0 +1,204 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Caret. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { Emitter } from '../../../../base/common/event.js';
+import { Disposable, DisposableStore, toDisposable } from '../../../../base/common/lifecycle.js';
+import { generateUuid } from '../../../../base/common/uuid.js';
+import { localize } from '../../../../nls.js';
+import { createDecorator } from '../../../../platform/instantiation/common/instantiation.js';
+import { InstantiationType, registerSingleton } from '../../../../platform/instantiation/common/extensions.js';
+import { TerminalExitReason } from '../../../../platform/terminal/common/terminal.js';
+import { IBrowserViewModel, IBrowserViewWorkbenchService } from '../../../../workbench/contrib/browserView/common/browserView.js';
+import { ITerminalInstance, ITerminalService } from '../../../../workbench/contrib/terminal/browser/terminal.js';
+
+/**
+ * What a tab of the Apps panel shows.
+ *
+ * `browser` carries its own view model and `terminal` its own instance, so those two multiply
+ * (one tab per instance). `changes` and `file` are the panel's two single-instance panes: the
+ * surfaces behind them belong to this window (one active session, one workspace), so there is
+ * nothing to open a second copy of - the tab is what makes them panes of the panel instead of
+ * editor tabs somewhere else.
+ */
+export type AppsPanelTabKind = 'terminal' | 'browser' | 'changes' | 'file';
+
+/** One tab of the Apps panel: a terminal, a hosted browser view, or a single-instance pane. */
+export interface IAppsPanelTab {
+	readonly id: string;
+	readonly kind: AppsPanelTabKind;
+	readonly title: string;
+	readonly instance: ITerminalInstance | undefined;
+	readonly browser: IBrowserViewModel | undefined;
+}
+
+export interface IAppsPanelModel {
+	readonly _serviceBrand: undefined;
+	readonly onDidChange: import('../../../../base/common/event.js').Event<void>;
+	readonly tabs: readonly IAppsPanelTab[];
+	/** Whether the session summary strip above the body is showing. */
+	readonly summaryPinned: boolean;
+	createTerminal(): Promise<IAppsPanelTab | undefined>;
+	createBrowser(url?: string): Promise<IAppsPanelTab | undefined>;
+	/** The Changes pane: the active session's changes. Single instance - see {@link IAppsPanelTab}. */
+	createChanges(): IAppsPanelTab;
+	/** The Files pane: the workspace's files. Single instance - see {@link IAppsPanelTab}. */
+	createFiles(): IAppsPanelTab;
+	closeTab(id: string): void;
+	toggleSummaryPinned(): void;
+}
+
+export const IAppsPanelModel = createDecorator<IAppsPanelModel>('caretAppsPanelModel');
+
+/**
+ * Owns the Apps panel's instances.
+ *
+ * This lives outside the panel's editor pane on purpose. The Agents window layout closes
+ * and re-creates non-docked editors when it collapses the editor area, so a pane that owned
+ * its instances would drop every terminal and browser tab on each collapse - the pane is
+ * rebuilt, the instances are already gone. Here they outlive the pane: the pane attaches
+ * their DOM when it is created and detaches it when it goes away, and the instances keep
+ * running in between.
+ */
+export class AppsPanelModel extends Disposable implements IAppsPanelModel {
+
+	declare readonly _serviceBrand: undefined;
+
+	private readonly tabsByInstance: IAppsPanelTab[] = [];
+	private readonly storeByTabId = new Map<string, DisposableStore>();
+	/** The pin is window state, not pane state: a layout that re-creates the pane - collapsing the
+	 * editor area, or a switch to the IDE and back - must not silently unpin the summary. */
+	private pinnedSummary = false;
+	private readonly _onDidChange = this._register(new Emitter<void>());
+	readonly onDidChange = this._onDidChange.event;
+
+	constructor(
+		@ITerminalService private readonly terminalService: ITerminalService,
+		@IBrowserViewWorkbenchService private readonly browserViewService: IBrowserViewWorkbenchService,
+	) {
+		super();
+	}
+
+	get tabs(): readonly IAppsPanelTab[] {
+		return this.tabsByInstance;
+	}
+
+	get summaryPinned(): boolean {
+		return this.pinnedSummary;
+	}
+
+	toggleSummaryPinned(): void {
+		this.pinnedSummary = !this.pinnedSummary;
+		this._onDidChange.fire();
+	}
+
+	async createTerminal(): Promise<IAppsPanelTab | undefined> {
+		const instance = await this.terminalService.createTerminal({});
+		if (this._store.isDisposed) {
+			instance.dispose(TerminalExitReason.User);
+			return undefined;
+		}
+		const store = new DisposableStore();
+		const tab: IAppsPanelTab = { id: generateUuid(), kind: 'terminal', title: instance.title, instance, browser: undefined };
+		// Titles are snapshots so the pane can render a tab without reading the instance.
+		store.add(instance.onTitleChanged(() => this.replaceTab({ ...tab, title: instance.title })));
+		store.add(instance.onDisposed(() => this.removeTab(tab.id)));
+		this.storeByTabId.set(tab.id, store);
+		this.tabsByInstance.push(tab);
+		this._onDidChange.fire();
+		return tab;
+	}
+
+	async createBrowser(url?: string): Promise<IAppsPanelTab | undefined> {
+		const input = this.browserViewService.getOrCreateLazy({ id: generateUuid() });
+		const model = await input.resolve();
+		if (this._store.isDisposed) {
+			model.dispose();
+			return undefined;
+		}
+		const store = new DisposableStore();
+		let tab: IAppsPanelTab = { id: generateUuid(), kind: 'browser', title: model.title || 'Browser', instance: undefined, browser: model };
+		store.add(model.onDidChangeTitle(() => {
+			tab = { ...tab, title: model.title || 'Browser' };
+			this.replaceTab(tab);
+		}));
+		store.add(toDisposable(() => model.dispose()));
+		this.storeByTabId.set(tab.id, store);
+		this.tabsByInstance.push(tab);
+		this._onDidChange.fire();
+
+		if (url) {
+			await model.loadURL(url).catch(() => undefined);
+		}
+		return tab;
+	}
+
+	createChanges(): IAppsPanelTab {
+		return this.ensureSingletonPane('changes', localize('caret.agentHome.utility.review', "Changes"));
+	}
+
+	createFiles(): IAppsPanelTab {
+		return this.ensureSingletonPane('file', localize('caret.agentHome.utility.file', "File"));
+	}
+
+	/**
+	 * A pane this window owns a single one of.
+	 *
+	 * Two of the reference's four entries have nothing to multiply: the Changes pane reads the
+	 * one active session and the Files pane the one workspace. Asking for one that is already
+	 * open therefore means "show that pane", which is what the caller does with the tab it gets
+	 * back.
+	 */
+	private ensureSingletonPane(kind: 'changes' | 'file', title: string): IAppsPanelTab {
+		const existing = this.tabsByInstance.find(tab => tab.kind === kind);
+		if (existing) {
+			return existing;
+		}
+		const tab: IAppsPanelTab = { id: generateUuid(), kind, title, instance: undefined, browser: undefined };
+		this.tabsByInstance.push(tab);
+		this._onDidChange.fire();
+		return tab;
+	}
+
+	closeTab(id: string): void {
+		const tab = this.tabsByInstance.find(candidate => candidate.id === id);
+		if (!tab) {
+			return;
+		}
+		this.removeTab(id);
+		// A browser view is disposed by its tab store; a terminal owns its process.
+		tab.instance?.dispose(TerminalExitReason.User);
+	}
+
+	private replaceTab(tab: IAppsPanelTab): void {
+		const index = this.tabsByInstance.findIndex(candidate => candidate.id === tab.id);
+		if (index === -1) {
+			return;
+		}
+		this.tabsByInstance[index] = tab;
+		this._onDidChange.fire();
+	}
+
+	private removeTab(id: string): void {
+		const index = this.tabsByInstance.findIndex(candidate => candidate.id === id);
+		if (index === -1) {
+			return;
+		}
+		this.tabsByInstance.splice(index, 1);
+		this.storeByTabId.get(id)?.dispose();
+		this.storeByTabId.delete(id);
+		this._onDidChange.fire();
+	}
+
+	override dispose(): void {
+		for (const store of this.storeByTabId.values()) {
+			store.dispose();
+		}
+		this.storeByTabId.clear();
+		this.tabsByInstance.length = 0;
+		super.dispose();
+	}
+}
+
+registerSingleton(IAppsPanelModel, AppsPanelModel, InstantiationType.Delayed);
diff --git a/src/vs/sessions/contrib/home/browser/appsPanelReact.ts b/src/vs/sessions/contrib/home/browser/appsPanelReact.ts
