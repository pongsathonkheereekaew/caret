+
+	override getIcon(): ThemeIcon {
+		return AgentHomeUtilityInput.ICON;
+	}
+
+	override getTitle(_verbosity?: Verbosity): string {
+		return this.getName();
+	}
+
+	override canReopen(): boolean {
+		return true;
+	}
+
+	override matches(otherInput: EditorInput | IUntypedEditorInput): boolean {
+		return super.matches(otherInput) || otherInput instanceof AgentHomeUtilityInput;
+	}
+}
diff --git a/src/vs/sessions/contrib/home/browser/appsPanelModel.ts b/src/vs/sessions/contrib/home/browser/appsPanelModel.ts
