@@ -0,0 +1,342 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Caret. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { createElement, Fragment, type FunctionComponent } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { localize } from '../../../../nls.js';
+
+/**
+ * The first React surface in the Agents window.
+ *
+ * Why: the reference's agent UI is React (its own `react-runtime` ships next to
+ * `workbench.glass.main.js`, and its Apps panel is a component tree - see
+ * `docs/maintenance/evidence/cursor-agent-surface-decision-2026-09-15/`). Caret's panes were
+ * hand-built DOM instead, which is why every panel change was another `append`/`classList`
+ * edit. The empty Apps panel is the smallest real thing to move first: its data is already a
+ * list of launchers, so the pane keeps the model and React owns the pixels from there.
+ *
+ * `createElement` rather than JSX on purpose: the pinned base's `src/tsconfig.json` sets no
+ * `jsx` option, and turning JSX on for the whole workbench is a separate, reviewable change.
+ * The rendered markup keeps the pane's existing class names, so the Caret token layer and the
+ * parity gate see exactly what they saw before.
+ */
+
+/** One launcher card: the subset of the pane's launcher entry a card needs. */
+export interface IAppsLauncherCard {
+	readonly id: string;
+	readonly label: string;
+	readonly iconId: string;
+}
+
+/**
+ * The strip's entry for one app.
+ *
+ * `kind` is what the reference's strip switches on: `changes` opens the Changes editor, and
+ * `browser` / `terminal` are hosted here, one tab per instance.
+ */
+export interface IAppsLauncherEntry extends IAppsLauncherCard {
+	readonly kind: 'changes' | 'browser' | 'terminal' | 'file';
+	/** The reference marks the entry whose surface is the one on screen. */
+	readonly active?: boolean;
+}
+
+export interface IAppsEmptyStateHandle {
+	/** Re-render with a new card set. */
+	update(cards: readonly IAppsLauncherCard[]): void;
+	/** Tear the root down. The pane calls this when it drops its DOM. */
+	dispose(): void;
+}
+
+interface IAppsEmptyStateProps {
+	readonly cards: readonly IAppsLauncherCard[];
+	readonly onPick: (id: string) => void;
+}
+
+const AppsEmptyState: FunctionComponent<IAppsEmptyStateProps> = ({ cards, onPick }) =>
+	createElement(
+		'div',
+		{ className: 'caret-apps-empty' },
+		createElement(
+			'div',
+			{ className: 'caret-agent-home-utility-grid' },
+			cards.map(card => createElement(
+				'button',
+				{
+					key: card.id,
+					type: 'button',
+					className: 'caret-agent-home-utility-card',
+					'aria-label': card.label,
+					onClick: () => onPick(card.id),
+				},
+				createElement('span', {
+					key: 'icon',
+					className: `caret-agent-home-utility-card-icon codicon codicon-${card.iconId}`,
+					'aria-hidden': true,
+				}),
+				createElement('span', { key: 'label', className: 'caret-agent-home-utility-card-label' }, card.label),
+			)),
+		),
+	);
+
+/**
+ * Mount the empty-state cards into `host`.
+ *
+ * `host` has to be a fresh, empty element: React owns everything inside it from then on, and
+ * the pane removes `host` itself when it disposes the handle.
+ */
+export function mountAppsEmptyState(host: HTMLElement, cards: readonly IAppsLauncherCard[], onPick: (id: string) => void): IAppsEmptyStateHandle {
+	const root: Root = createRoot(host);
+	root.render(createElement(AppsEmptyState, { cards, onPick }));
+	return {
+		update: next => root.render(createElement(AppsEmptyState, { cards: next, onPick })),
+		// React 18 complains if a root is left mounted on a detached node, so unmount before
+		// the pane drops the host element.
+		dispose: () => root.unmount(),
+	};
+}
+
+export interface IAppsStripActionsHandlers {
+	/** The pane anchors the apps context menu to the button that opened it. */
+	onOpenMenu(anchor: HTMLElement): void;
+	onToggleSummary(): void;
+}
+
+export interface IAppsStripActionsHandle {
+	update(pinned: boolean): void;
+	dispose(): void;
+}
+
+interface IAppsStripActionsProps {
+	readonly pinned: boolean;
+	readonly handlers: IAppsStripActionsHandlers;
+}
+
+/**
+ * The strip's two icon buttons: `+` (the reference's "Open new tab menu") and the pinned-summary
+ * toggle.
+ *
+ * With these the whole Apps panel strip - rail entries, instance tabs and both buttons - is
+ * React, and the pane is left with bodies and the model. The `+` reports the element that was
+ * clicked rather than a stored reference, because the pane anchors a context menu to it.
+ */
+const AppsStripActions: FunctionComponent<IAppsStripActionsProps> = ({ pinned, handlers }) =>
+	createElement(
+		Fragment,
+		null,
+		createElement('button', {
+			key: 'new',
+			type: 'button',
+			className: 'caret-apps-new caret-apps-icon-button codicon codicon-add',
+			'aria-label': localize('caret.agentHome.utility.newInstance', "Open new tab menu"),
+			title: localize('caret.agentHome.utility.newInstance', "Open new tab menu"),
+			'aria-haspopup': 'menu',
+			onClick: (event: MouseEvent) => handlers.onOpenMenu(event.currentTarget as HTMLElement),
+		}),
+		createElement('button', {
+			key: 'summary',
+			type: 'button',
+			className: `caret-apps-summary-toggle caret-apps-icon-button codicon codicon-pin${pinned ? ' active' : ''}`,
+			'aria-label': localize('caret.agentHome.utility.toggleSummary', "Toggle Pinned Summary"),
+			title: localize('caret.agentHome.utility.toggleSummary', "Toggle Pinned Summary"),
+			'aria-pressed': String(pinned),
+			onClick: () => handlers.onToggleSummary(),
+		}),
+	);
+
+/**
+ * Mount the strip's icon buttons into `host`.
+ *
+ * `host` takes part in the strip's own flex layout, so the caller makes it `display: contents`
+ * - otherwise the two buttons would be one flex item instead of two and the strip would space
+ * them wrong.
+ */
+export function mountAppsStripActions(host: HTMLElement, handlers: IAppsStripActionsHandlers): IAppsStripActionsHandle {
+	host.style.display = 'contents';
+	const root: Root = createRoot(host);
+	root.render(createElement(AppsStripActions, { pinned: false, handlers }));
+	return {
+		update: pinned => root.render(createElement(AppsStripActions, { pinned, handlers })),
+		dispose: () => root.unmount(),
+	};
+}
+
+/** The pinned summary as the pane can read it: plain strings, no observables. */
+export interface IAppsSummaryState {
+	readonly title: string;
+	readonly meta: string;
+}
+
+export interface IAppsSummaryHandle {
+	update(state: IAppsSummaryState): void;
+	dispose(): void;
+}
+
+/**
+ * The pinned summary panel.
+ *
+ * Same split as the rest of this module: React owns the markup, the pane keeps the observable
+ * wiring (it is the only thing that has the services). The panel used to write `textContent`
+ * into two elements it created by hand.
+ */
+const AppsSummary: FunctionComponent<{ readonly state: IAppsSummaryState }> = ({ state }) =>
+	createElement(
+		'div',
+		{ className: 'caret-apps-summary' },
+		createElement('span', { className: 'caret-apps-summary-title' }, state.title),
+		createElement('span', { className: 'caret-apps-summary-meta' }, state.meta),
+	);
+
+export function mountAppsSummary(host: HTMLElement): IAppsSummaryHandle {
+	const root: Root = createRoot(host);
+	root.render(createElement(AppsSummary, { state: { title: '', meta: '' } }));
+	return {
+		update: state => root.render(createElement(AppsSummary, { state })),
+		dispose: () => root.unmount(),
+	};
+}
+
+/** One instance tab as the strip needs it: the pane's `IAppsPanelTab` minus its instances. */
+export interface IAppsTab {
+	readonly id: string;
+	readonly title: string;
+	readonly kind: 'terminal' | 'browser' | 'changes' | 'file';
+}
+
+/**
+ * The icon a tab wears, keyed by what it shows.
+ *
+ * All four kinds reach the strip as tabs now - the rail's own entries are the reference's four
+ * pane buttons in its order, and picking one switches to (or opens) that pane, so the tab row
+ * has to name the pane a tab stands for, not just browser-or-terminal.
+ */
+function tabIconId(kind: IAppsTab['kind']): string {
+	switch (kind) {
+		case 'browser': return 'globe';
+		case 'changes': return 'git-compare';
+		case 'file': return 'file-code';
+		default: return 'terminal';
+	}
+}
+
+export interface IAppsTabStripHandlers {
+	onSelect(id: string): void;
+	onClose(id: string): void;
+}
+
+export interface IAppsTabStripHandle {
+	update(tabs: readonly IAppsTab[], activeId: string | undefined): void;
+	dispose(): void;
+}
+
+interface IAppsTabStripProps {
+	readonly tabs: readonly IAppsTab[];
+	readonly activeId: string | undefined;
+	readonly handlers: IAppsTabStripHandlers;
+}
+
+/**
+ * The instance tabs.
+ *
+ * These were the most churn-prone markup in the pane - one button, icon, label and close
+ * affordance rebuilt by hand every time the model changed, with the active state toggled by
+ * `classList` from a second place. The tab row is also what the user asked to be aligned like
+ * the reference's. React owns the row now; the pane still owns every tab's body, because a
+ * terminal attaches a real instance and a browser lays a native view over its own element.
+ */
+const AppsTabStrip: FunctionComponent<IAppsTabStripProps> = ({ tabs, activeId, handlers }) =>
+	createElement(
+		Fragment,
+		null,
+		tabs.map(tab => {
+			const active = tab.id === activeId;
+			return createElement(
+				'button',
+				{
+					key: tab.id,
+					type: 'button',
+					role: 'tab',
+					className: active ? 'caret-apps-tab active' : 'caret-apps-tab',
+					'aria-label': tab.title,
+					'aria-selected': String(active),
+					onClick: () => handlers.onSelect(tab.id),
+				},
+				createElement('span', {
+					key: 'icon',
+					className: `caret-apps-tab-icon codicon codicon-${tabIconId(tab.kind)}`,
+					'aria-hidden': true,
+				}),
+				createElement('span', { key: 'label', className: 'caret-apps-tab-label' }, tab.title),
+				createElement('span', {
+					key: 'close',
+					className: 'caret-apps-tab-close codicon codicon-close',
+					role: 'button',
+					'aria-label': localize('caret.agentHome.utility.closeInstance', "Close Tab"),
+					onClick: (event: MouseEvent) => { event.stopPropagation(); handlers.onClose(tab.id); },
+				}),
+			);
+		}),
+	);
+
+/**
+ * Mount the tab buttons into `host`, which is the pane's own `.caret-apps-tabs` element.
+ *
+ * The element itself stays the pane's: it sits between the launcher entries and the `+` in one
+ * strip, so React renders the buttons into it rather than the container around them. The pane
+ * removes the element only after disposing this handle.
+ */
+export function mountAppsTabStrip(host: HTMLElement, handlers: IAppsTabStripHandlers): IAppsTabStripHandle {
+	const root: Root = createRoot(host);
+	root.render(createElement(AppsTabStrip, { tabs: [], activeId: undefined, handlers }));
+	return {
+		update: (tabs, activeId) => root.render(createElement(AppsTabStrip, { tabs, activeId, handlers })),
+		dispose: () => root.unmount(),
+	};
+}
+
+interface IAppsLauncherRailProps {
+	readonly entries: readonly IAppsLauncherEntry[];
+	readonly onPick: (id: string) => void;
+}
+
+/**
+ * The strip entries the reference always shows, in its order: Changes · Browser · Terminal ·
+ * File. They were the last hand-built markup in the strip; the pane keeps the container and
+ * the behaviour behind each id, React owns the buttons.
+ */
+const AppsLauncherRail: FunctionComponent<IAppsLauncherRailProps> = ({ entries, onPick }) =>
+	createElement(
+		Fragment,
+		null,
+		entries.map(entry => createElement(
+			'button',
+			{
+				key: entry.id,
+				type: 'button',
+				// The strip is narrow, so the entry is its icon with the name as the accessible
+				// name and tooltip; the labelled form of the same entry is the card in the empty
+				// body.
+				className: entry.active ? 'caret-apps-launcher active' : 'caret-apps-launcher',
+				'aria-label': entry.label,
+				title: entry.label,
+				'aria-pressed': String(entry.active === true),
+				onClick: () => onPick(entry.id),
+			},
+			createElement('span', {
+				key: 'icon',
+				className: `caret-apps-launcher-icon codicon codicon-${entry.iconId}`,
+				'aria-hidden': true,
+			}),
+		)),
+	);
+
+/** Mount the strip entries into the pane's `.caret-apps-launchers` element. */
+export function mountAppsLauncherRail(host: HTMLElement, entries: readonly IAppsLauncherEntry[], onPick: (id: string) => void): IAppsEmptyStateHandle {
+	const root: Root = createRoot(host);
+	root.render(createElement(AppsLauncherRail, { entries, onPick }));
+	return {
+		update: next => root.render(createElement(AppsLauncherRail, { entries: next as readonly IAppsLauncherEntry[], onPick })),
+		dispose: () => root.unmount(),
+	};
+}
diff --git a/src/vs/sessions/contrib/home/browser/media/agentHomeUtility.css b/src/vs/sessions/contrib/home/browser/media/agentHomeUtility.css
