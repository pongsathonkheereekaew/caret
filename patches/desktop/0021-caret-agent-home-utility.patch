index 00000000000..523b7f18652
--- /dev/null
+++ b/src/vs/sessions/contrib/home/browser/media/agentHomeUtility.css
@@ -0,0 +1,455 @@
+/* Caret: the Agent Home utility area - the reference's right-hand Apps panel.
+ *
+ * The reference panel is a strip of app entries above a body of four app tiles, and it
+ * is where that window's browser, terminal, changes and file surfaces live. The host is
+ * a normal editor group, so its own title strip is suppressed whenever the Caret panel
+ * is the editor that group is showing. The panel draws the only strip in the pane, which
+ * is what keeps its entries and its instance tabs on one row: showing both strips put the
+ * group's tabs (Browser) one row above the panel's tabs (a terminal).
+ */
+
+.agent-sessions-workbench .part.editor .editor-group-container:has(> .editor-container .caret-apps-panel) > .title,
+.agent-sessions-workbench .part.editor .editor-group-container:has(> .editor-container .caret-apps-panel) > .title > .title-actions,
+.agent-sessions-workbench .part.editor .editor-group-container:has(> .editor-container .caret-apps-panel) > .title > .tabs-and-actions-container,
+.agent-sessions-workbench .part.editor .editor-group-container:has(> .editor-container .caret-apps-panel) > .title .monaco-toolbar {
+	display: none !important;
+}
+
+.caret-apps-panel {
+	display: flex;
+	flex-direction: column;
+	height: 100%;
+	width: 100%;
+	overflow: hidden;
+}
+
+/* --- Strip: the four app entries of the reference, then one tab per open instance --- */
+
+.caret-apps-strip {
+	/* One control size and one gap for everything in the strip. The rail buttons were 24x26, the
+	 * instance tabs 24 tall and the two icon buttons 22x22, so a browser tab and a terminal tab
+	 * sat on slightly different baselines and the `+`/pin did not line up with either. */
+	/* The Caret token scale's own value with a literal fallback: the workbench does not inject
+	 * `--caret-*` yet, so the fallback is what renders today - and the repo test asserts the
+	 * fallback equals `CARET_TOKENS['caret-height-sm']`, so the Agents window cannot drift off
+	 * the scale the parity gate measures. */
+	--caret-apps-control-size: var(--caret-height-sm, 24px);
+	--caret-apps-gap: 2px;
+	display: flex;
+	align-items: center;
+	flex: 0 0 auto;
+	height: 35px;
+	padding: 0 var(--caret-space-6, 6px);
+	gap: var(--caret-apps-gap);
+	border-bottom: 1px solid var(--vscode-panel-border, var(--vscode-widget-border));
+	overflow: hidden;
+}
+
+.caret-apps-launchers {
+	display: flex;
+	align-items: center;
+	gap: var(--caret-apps-gap);
+	flex: 0 0 auto;
+}
+
+.caret-apps-launcher {
+	display: flex;
+	align-items: center;
+	justify-content: center;
+	height: var(--caret-apps-control-size);
+	width: var(--caret-apps-control-size);
+	margin: 0;
+	padding: 0;
+	border: none;
+	border-radius: var(--caret-radius-sm, 4px);
+	background: transparent;
+	color: var(--vscode-descriptionForeground, var(--vscode-foreground));
+	cursor: pointer;
+	font-size: 15px;
+}
+
+.caret-apps-launcher:hover {
+	background: var(--vscode-list-hoverBackground);
+}
+
+/* The pane this entry stands for is the one on screen, like the reference's own strip. */
+.caret-apps-launcher.active {
+	background: var(--vscode-editorGroupHeader-tabsBackground, var(--vscode-editorWidget-background));
+	color: var(--vscode-foreground);
+}
+
+.caret-apps-launcher-icon {
+	background: var(--vscode-list-hoverBackground);
+	color: var(--vscode-foreground);
+}
+
+.caret-apps-launcher:focus-visible,
+.caret-apps-tab:focus-visible,
+.caret-apps-new:focus-visible,
+.caret-agent-home-utility-card:focus-visible {
+	outline: 1px solid var(--vscode-focusBorder);
+	outline-offset: -1px;
+}
+
+.caret-apps-launcher-icon {
+	font-size: 15px;
+}
+
+.caret-apps-tabs {
+	display: flex;
+	align-items: center;
+	flex: 1 1 auto;
+	gap: var(--caret-apps-gap);
+	/* The rail and the tab row are separated by the strip's own gap, not a second magic offset. */
+	margin-left: var(--caret-apps-gap);
+	overflow: hidden;
+}
+
+.caret-apps-tab {
+	display: flex;
+	align-items: center;
+	flex: 0 0 auto;
+	gap: var(--caret-space-6, 6px);
+	height: var(--caret-apps-control-size);
+	max-width: 180px;
+	margin: 0;
+	padding: 0 var(--caret-space-4, 4px) 0 var(--caret-space-8, 8px);
+	border: none;
+	border-radius: var(--caret-radius-sm, 4px);
+	background: transparent;
+	color: var(--vscode-descriptionForeground, var(--vscode-foreground));
+	cursor: pointer;
+	font-family: inherit;
+	font-size: var(--vscode-fontSize-label1, 12px);
+}
+
+.caret-apps-tab:hover {
+	background: var(--vscode-list-hoverBackground);
+}
+
+.caret-apps-tab.active {
+	background: var(--vscode-editorGroupHeader-tabsBackground, var(--vscode-editorWidget-background));
+	color: var(--vscode-foreground);
+}
+
+.caret-apps-tab-icon {
+	font-size: var(--caret-font-base, 13px);
+	flex: 0 0 auto;
+}
+
+.caret-apps-tab-label {
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+
+.caret-apps-tab-close {
+	display: flex;
+	align-items: center;
+	justify-content: center;
+	flex: 0 0 auto;
+	width: 16px;
+	height: 16px;
+	border-radius: 3px;
+	font-size: var(--caret-font-sm, 12px);
+	visibility: hidden;
+}
+
+.caret-apps-tab:hover .caret-apps-tab-close,
+.caret-apps-tab.active .caret-apps-tab-close {
+	visibility: visible;
+}
+
+.caret-apps-tab-close:hover {
+	background: var(--vscode-toolbar-hoverBackground);
+}
+
+.caret-apps-summary-toggle.active {
+	background: var(--vscode-toolbar-activeBackground, var(--vscode-list-activeSelectionBackground));
+	color: var(--vscode-foreground);
+}
+
+/* --- Pinned summary: the reference's session summary above the app body --- */
+
+.caret-apps-summary {
+	display: none;
+	flex: 0 0 auto;
+	flex-direction: column;
+	gap: 2px;
+	padding: var(--caret-space-8, 8px) var(--caret-space-10, 10px);
+	border-bottom: 1px solid var(--vscode-panel-border, var(--vscode-widget-border));
+}
+
+.caret-apps-panel.summary-pinned .caret-apps-summary {
+	display: flex;
+}
+
+.caret-apps-summary-title {
+	color: var(--vscode-foreground);
+	font-size: var(--vscode-fontSize-label1, 12px);
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+
+.caret-apps-summary-meta {
+	color: var(--vscode-descriptionForeground, var(--vscode-foreground));
+	font-size: var(--vscode-fontSize-label2, 11px);
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+
+/* --- Body: one container per instance, and the reference's tile grid while empty --- */
+
+.caret-apps-body {
+	position: relative;
+	flex: 1 1 auto;
+	min-height: 0;
+}
+
+/* The instance containers reuse the upstream terminal layout classes, so the wrapper
+ * and xterm inside are sized by the terminal contribution's own CSS. */
+.caret-apps-instance {
+	display: none;
+}
+
+.caret-apps-instance.active {
+	display: block;
+}
+
+/* A browser tab is an address bar plus the area the main process draws its overlay over. */
+.caret-apps-instance.caret-apps-browser {
+	position: absolute;
+	inset: 0;
+	flex-direction: column;
+	background-color: var(--vscode-editor-background);
+}
+
+.caret-apps-instance.caret-apps-browser.active {
+	display: flex;
+}
+
+/* --- Hosted panes: the base's Changes and Files surfaces, drawn inside the panel --- *
+ *
+ * These two entries of the strip used to send the user to an editor tab in the same group, so
+ * the strip could not switch to them and the rail had nothing to mark. They are panes of this
+ * panel now, and the pane only has to give the base's own view the whole body: the view brings
+ * its layout (the changes view is a PaneView, the Files surface is an editor pane's content).
+ */
+
+.caret-apps-instance.caret-apps-pane {
+	position: absolute;
+	inset: 0;
+	flex-direction: column;
+	min-height: 0;
+	background-color: var(--vscode-editor-background);
+}
+
+.caret-apps-instance.caret-apps-pane.active {
+	display: flex;
+}
+
+/* The hosted view is the body: nothing else sizes it, so it takes the whole pane. */
+.caret-apps-pane > .monaco-pane-view {
+	flex: 1 1 auto;
+	min-height: 0;
+	width: 100%;
+}
+
+.caret-apps-pane .monaco-pane-view > .split-view-view {
+	overflow: hidden;
+}
+
+.caret-apps-browser-bar {
+	position: relative;
+	display: flex;
+	align-items: center;
+	flex: 0 0 auto;
+	gap: 2px;
+	height: var(--caret-height-lg, 32px);
+	padding: 0 var(--caret-space-6, 6px);
+	border-bottom: 1px solid var(--vscode-panel-border, var(--vscode-widget-border));
+}
+
+.caret-apps-browser-url {
+	flex: 1 1 auto;
+	min-width: 0;
+	height: 22px;
+	margin: 0 2px;
+	padding: 0 var(--caret-space-8, 8px);
+	border: 1px solid var(--vscode-input-border, transparent);
+	border-radius: var(--caret-radius-sm, 4px);
+	background: var(--vscode-input-background);
+	color: var(--vscode-input-foreground);
+	font-family: inherit;
+	font-size: var(--vscode-fontSize-label1, 12px);
+}
+
+.caret-apps-browser-url:focus {
+	outline: 1px solid var(--vscode-focusBorder);
+	outline-offset: -1px;
+}
+
+/* The engine's suggestions, anchored to the address bar and never wider than it. */
+.caret-apps-browser-suggest {
+	position: absolute;
+	top: 100%;
+	left: 0;
+	right: 0;
+	z-index: 20;
+	display: flex;
+	flex-direction: column;
+	margin: 0 var(--caret-space-6, 6px);
+	padding: var(--caret-space-4, 4px) 0;
+	border: 1px solid var(--vscode-widget-border, var(--vscode-panel-border));
+	border-radius: var(--caret-radius-md, 6px);
+	background: var(--vscode-editorWidget-background, var(--vscode-editor-background));
+	box-shadow: 0 4px 12px var(--vscode-widget-shadow, rgba(0, 0, 0, 0.36));
+	overflow: hidden;
+}
+
+.caret-apps-browser-suggest[hidden] {
+	display: none !important;
+}
+
+.caret-apps-browser-suggest-row {
+	display: block;
+	width: 100%;
+	padding: var(--caret-space-4, 4px) var(--caret-space-10, 10px);
+	border: none;
+	background: transparent;
+	color: var(--vscode-foreground);
+	font-family: inherit;
+	font-size: var(--vscode-fontSize-label1, 12px);
+	text-align: left;
+	white-space: nowrap;
+	overflow: hidden;
+	text-overflow: ellipsis;
+	cursor: pointer;
+}
+
+.caret-apps-browser-suggest-row:hover,
+.caret-apps-browser-suggest-row.active {
+	background: var(--vscode-list-activeSelectionBackground);
+	color: var(--vscode-list-activeSelectionForeground);
+}
+
+.caret-apps-icon-button {
+	display: flex;
+	align-items: center;
+	justify-content: center;
+	flex: 0 0 auto;
+	width: var(--caret-apps-control-size);
+	height: var(--caret-apps-control-size);
+	margin: 0;
+	padding: 0;
+	border: none;
+	border-radius: var(--caret-radius-sm, 4px);
+	background: transparent;
+	color: var(--vscode-icon-foreground);
+	cursor: pointer;
+	font-size: var(--caret-font-base, 13px);
+}
+
+.caret-apps-icon-button:hover:not(:disabled) {
+	background: var(--vscode-toolbar-hoverBackground);
+}
+
+.caret-apps-icon-button:disabled {
+	color: var(--vscode-disabledForeground, var(--vscode-icon-foreground));
+	opacity: 0.4;
+	cursor: default;
+}
+
+.caret-apps-browser-view {
+	position: relative;
+	flex: 1 1 auto;
+	min-height: 0;
+}
+
+.caret-apps-empty {
+	position: absolute;
+	inset: 0;
+	display: none;
+	align-items: center;
+	justify-content: center;
+	padding: var(--caret-space-16, 16px);
+	box-sizing: border-box;
+}
+
+.caret-apps-panel.empty .caret-apps-empty {
+	display: flex;
+}
+
+.caret-agent-home-utility-grid {
+	display: grid;
+	grid-template-columns: repeat(2, minmax(0, 1fr));
+	grid-auto-rows: 1fr;
+	gap: var(--caret-space-8, 8px);
+	width: 100%;
+	max-width: 320px;
+	aspect-ratio: 1 / 1;
+}
+
+.caret-agent-home-utility-card {
+	display: flex;
+	flex-direction: column;
+	align-items: center;
+	justify-content: center;
+	gap: var(--caret-space-6, 6px);
+	margin: 0;
+	padding: var(--caret-space-8, 8px);
+	border: 1px solid var(--vscode-widget-border, var(--vscode-panel-border));
+	border-radius: var(--caret-radius, 8px);
+	background: var(--vscode-editorWidget-background);
+	color: var(--vscode-foreground);
+	cursor: pointer;
+	font-family: inherit;
+	font-size: var(--vscode-fontSize-label1, 12px);
+}
+
+.caret-agent-home-utility-card:hover {
+	background: var(--vscode-list-hoverBackground);
+}
+
+.caret-agent-home-utility-card-icon {
+	font-size: 20px;
+	line-height: 1;
+	color: var(--vscode-icon-foreground);
+}
+
+.caret-agent-home-utility-card-label {
+	text-align: center;
+}
+
+/* Caret: the reference centres a narrower composer in the agent surface - 608 of a
+ * 1267-wide centre in docs/caret-ui-reference-baseline.json, about 48%. The base
+ * lets the composer fill the column, which is what made the empty home read as too
+ * wide and too flat. The row above the input is narrowed with it so the card stays
+ * one column. */
+.agent-sessions-workbench .new-chat-widget-content .new-session-workspace-picker-container,
+.agent-sessions-workbench .new-chat-widget-content .new-chat-input-container {
+	max-width: 608px;
+	margin-left: auto;
+	margin-right: auto;
+}
+/* The Agents window paints its context menu on a pure black surface, which is invisible against
+ * the near-black panel and leaves the entries hard to read. Give this window's menus the raised
+ * surface the reference uses, without touching the IDE's own menus. */
+.agent-sessions-workbench .context-view,
+.agent-sessions-workbench .context-view .monaco-menu-container,
+.agent-sessions-workbench .context-view .monaco-menu {
+	/* `!important` on purpose: the workbench's own menu rule has the same specificity and is
+	 * loaded later, so a plain declaration loses and the menu stays pure black. */
+	/* An explicit raised surface, not a theme variable: every menu-ish token in this window's
+	 * theme resolves to black (`--vscode-editorSuggestWidget-background` and friends), so a
+	 * var-based rule applied but still painted black. #2d2d30 is Caret's own panel-raised value
+	 * (`CARET_TOKENS['caret-panel-raised']`), i.e. one step above the #0a0a0a surface. */
+	background-color: #2d2d30 !important;
+}
+
+.agent-sessions-workbench .context-view .monaco-menu .action-label,
+.agent-sessions-workbench .context-view .monaco-menu .action-item .action-label {
+	color: var(--vscode-editorSuggestWidget-foreground, var(--vscode-foreground, #e7e7e7));
+}
