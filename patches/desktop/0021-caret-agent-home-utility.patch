+ *--------------------------------------------------------------------------------------------*/
+
+import { mainWindow } from '../../../../base/browser/window.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { localize, localize2 } from '../../../../nls.js';
+import { Action2, registerAction2 } from '../../../../platform/actions/common/actions.js';
+import { ContextKeyExpr, IContextKeyService } from '../../../../platform/contextkey/common/contextkey.js';
+import { SyncDescriptor } from '../../../../platform/instantiation/common/descriptors.js';
+import { IInstantiationService, ServicesAccessor } from '../../../../platform/instantiation/common/instantiation.js';
+import { Registry } from '../../../../platform/registry/common/platform.js';
+import { EditorPaneDescriptor, IEditorPaneRegistry } from '../../../../workbench/browser/editor.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../../../workbench/common/contributions.js';
+import { IsSessionsWindowContext } from '../../../../workbench/common/contextkeys.js';
+import { EditorExtensions, IEditorFactoryRegistry, IEditorSerializer } from '../../../../workbench/common/editor.js';
+import { EditorInput } from '../../../../workbench/common/editor/editorInput.js';
+import { IEditorGroupsService } from '../../../../workbench/services/editor/common/editorGroupsService.js';
+import { IEditorService } from '../../../../workbench/services/editor/common/editorService.js';
+import { IWorkbenchLayoutService, Parts } from '../../../../workbench/services/layout/browser/layoutService.js';
+import { SessionsCategories } from '../../../common/categories.js';
+import { AgentHomeUtilityEditor } from './agentHomeUtilityEditor.js';
+import { AgentHomeUtilityInput } from './agentHomeUtilityInput.js';
+
+/**
+ * Shares of the reference Agent Home layout, measured from the reference capture
+ * (docs/caret-ui-reference-baseline.json): sidebar 15.6%, centre 61.9%, right
+ * utility 22.5%. The sidebar is pinned to the documented 255 logical px instead of
+ * a share, because that is the value the parity contract records for it.
+ */
+const REFERENCE_SIDEBAR_WIDTH = 255;
+const REFERENCE_UTILITY_SHARE = 0.225;
+
+/**
+ * Hosts the Agent Home utility area and the reference's three-column proportions.
+ *
+ * The empty Agent Home used to show a bare editor group: a blank canvas with
+ * `Add Tab` and a close control, at roughly 40% of the window. The reference has a
+ * narrower right utility area holding four launch cards, so this contribution opens
+ * the Caret utility surface in that group and sizes the three columns to the
+ * reference profile. Everything is scoped to the Sessions window, so the IDE keeps
+ * its own layout and its own editor chrome.
+ */
+class AgentHomeUtilityContribution extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.caret.agentHomeUtility';
+
+	constructor(
+		@IContextKeyService contextKeyService: IContextKeyService,
+		@IEditorService private readonly editorService: IEditorService,
+		@IEditorGroupsService private readonly editorGroupsService: IEditorGroupsService,
+		@IWorkbenchLayoutService private readonly layoutService: IWorkbenchLayoutService,
+		@IInstantiationService private readonly instantiationService: IInstantiationService,
+	) {
+		super();
+
+		if (!IsSessionsWindowContext.getValue(contextKeyService)) {
+			return;
+		}
+
+		void this.openUtility();
+		this.applyReferenceProportions();
+		// The first layout of a cold window can still be running when this contribution
+		// settles, so a share applied once would be computed against a container width the
+		// window no longer has (that is how the utility column came back at 30% instead of
+		// the reference's 22.5%). Re-apply on container *size* changes only: dragging the
+		// sash leaves the container size alone, so the user's own width still wins.
+		this._register(this.layoutService.onDidLayoutMainContainer(dimension => {
+			if (dimension.width !== this._lastContainerWidth) {
+				this.applyReferenceProportions();
+			}
+		}));
+	}
+
+	private _lastContainerWidth = -1;
+
+	private async openUtility(): Promise<void> {
+		const group = this.editorGroupsService.mainPart.activeGroup;
+		if (group.isEmpty) {
+			await this.editorService.openEditor(this.instantiationService.createInstance(AgentHomeUtilityInput), { pinned: true }, group);
+		}
+	}
+
+	private applyReferenceProportions(): void {
+		const width = this.layoutService.getContainer(mainWindow).clientWidth;
+		if (width <= 0) {
+			return;
+		}
+		this._lastContainerWidth = width;
+		this.layoutService.setSize(Parts.SIDEBAR_PART, { width: REFERENCE_SIDEBAR_WIDTH, height: 0 });
+		this.layoutService.setSize(Parts.EDITOR_PART, { width: Math.round(width * REFERENCE_UTILITY_SHARE), height: 0 });
+	}
+}
+
+class AgentHomeUtilityEditorContribution extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.caret.agentHomeUtilityEditor';
+
+	constructor() {
+		super();
+
+		this._register(Registry.as<IEditorPaneRegistry>(EditorExtensions.EditorPane).registerEditorPane(
+			EditorPaneDescriptor.create(AgentHomeUtilityEditor, AgentHomeUtilityEditor.ID, localize('caret.agentHome.utility.editorLabel', "Apps")),
+			[new SyncDescriptor(AgentHomeUtilityInput)],
+		));
+	}
+}
+
+/**
+ * The utility surface carries no state, so it serialises to an empty payload. The
+ * registration exists because the editor group is restored on reload and an
+ * unregistered input type would drop the group instead of re-creating it.
+ */
+class AgentHomeUtilityInputSerializer implements IEditorSerializer {
+
+	canSerialize(editorInput: EditorInput): editorInput is AgentHomeUtilityInput {
+		return editorInput instanceof AgentHomeUtilityInput;
+	}
+
+	serialize(editorInput: EditorInput): string | undefined {
+		return this.canSerialize(editorInput) ? '' : undefined;
+	}
+
+	deserialize(instantiationService: IInstantiationService): EditorInput {
+		return instantiationService.createInstance(AgentHomeUtilityInput);
+	}
+}
+
+Registry.as<IEditorFactoryRegistry>(EditorExtensions.EditorFactory).registerEditorSerializer(AgentHomeUtilityInput.ID, AgentHomeUtilityInputSerializer);
+
+registerWorkbenchContribution2(AgentHomeUtilityEditorContribution.ID, AgentHomeUtilityEditorContribution, WorkbenchPhase.BlockStartup);
+registerWorkbenchContribution2(AgentHomeUtilityContribution.ID, AgentHomeUtilityContribution, WorkbenchPhase.AfterRestored);
+
+/**
+ * The reference window offers `Show Apps`, but the base only ships the hide half. In
+ * this single-pane group a browser, search or file tab replaces the panel rather than
+ * sitting beside it, so without a show command the panel would be a dead end.
+ */
+class ShowAppsAction extends Action2 {
+
+	static readonly ID = 'caret.agentHome.showApps';
+
+	constructor() {
+		super({
+			id: ShowAppsAction.ID,
+			title: localize2('caret.agentHome.showApps', "Show Apps"),
+			category: SessionsCategories.Sessions,
+			f1: true,
+			precondition: IsSessionsWindowContext,
+		});
+	}
+
+	override async run(accessor: ServicesAccessor): Promise<void> {
+		const editorService = accessor.get(IEditorService);
+		const editorGroupsService = accessor.get(IEditorGroupsService);
+		const instantiationService = accessor.get(IInstantiationService);
+		const group = editorGroupsService.mainPart.activeGroup;
+		await editorService.openEditor(instantiationService.createInstance(AgentHomeUtilityInput), { pinned: true }, group);
+	}
+}
+
+registerAction2(ShowAppsAction);
