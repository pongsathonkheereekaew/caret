+/** Anything with a scheme is already a URL (`https:`, `file:`, `mailto:`). */
+const HAS_SCHEME = /^[a-zA-Z][a-zA-Z0-9+.-]*:/;
+/** A bare host: `example.com`, `localhost`, `127.0.0.1`, each with an optional port and path. */
+const HOST_LIKE = /^(?:localhost|(?:[a-z0-9-]+\.)+[a-z]{2,}|(?:\d{1,3}\.){3}\d{1,3})(?::\d+)?(?:[/?#].*)?$/i;
+/** Where a search term goes. Google is the reference browser's engine. */
+const SEARCH_ENDPOINT = 'https://www.google.com/search?q=';
+
+/**
+ * What the browser's address bar does with what was typed.
+ *
+ * A scheme, or a bare host (`example.com`, `localhost:3000`, an IP), is a URL. Anything
+ * else - several words, a single word, a phrase with spaces - is a search, the way a
+ * browser's own address bar treats it; the panel used to prefix `https://` to whatever
+ * was typed, so a search term became a broken host.
+ */
+function normaliseUrl(value: string): string {
+	const trimmed = value.trim();
+	if (HAS_SCHEME.test(trimmed)) return trimmed;
+	if (!/\s/.test(trimmed) && HOST_LIKE.test(trimmed)) return `https://${trimmed}`;
+	return `${SEARCH_ENDPOINT}${encodeURIComponent(trimmed)}`;
+}
+
+/** Whether what is in the address bar is a search term, and so can be completed. */
+function isSearchTerm(value: string): boolean {
+	const trimmed = value.trim();
+	return trimmed.length > 1 && !HAS_SCHEME.test(trimmed) && (/\s/.test(trimmed) || !HOST_LIKE.test(trimmed));
+}
+
+/**
+ * The search URL a chosen suggestion opens. A suggestion is a term the engine offered
+ * for a search, so it is always searched, never treated as a host - unlike the typed
+ * text, which the rule above still opens as a URL when it looks like one.
+ */
+function searchUrlFor(term: string): string {
+	return `${SEARCH_ENDPOINT}${encodeURIComponent(term.trim())}`;
+}
