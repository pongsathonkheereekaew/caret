@@ -0,0 +1,385 @@
+/* Caret: the Agent Home utility area - the reference's right-hand Apps panel.
+ *
+ * The reference panel is a strip of app entries above a body of four app tiles, and it
+ * is where that window's browser, terminal, changes and file surfaces live. The host is
+ * a normal editor group, so its own title strip is suppressed whenever the Caret panel
+ * is the editor that group is showing. The panel draws the only strip in the pane, which
+ * is what keeps its entries and its instance tabs on one row: showing both strips put the
+ * group's tabs (Browser) one row above the panel's tabs (a terminal).
+ */
+
+.agent-sessions-workbench .part.editor .editor-group-container:has(> .editor-container .caret-apps-panel) > .title,
+.agent-sessions-workbench .part.editor .editor-group-container:has(> .editor-container .caret-apps-panel) > .title > .title-actions,
+.agent-sessions-workbench .part.editor .editor-group-container:has(> .editor-container .caret-apps-panel) > .title > .tabs-and-actions-container,
+.agent-sessions-workbench .part.editor .editor-group-container:has(> .editor-container .caret-apps-panel) > .title .monaco-toolbar {
+	display: none !important;
+}
+
+.caret-apps-panel {
+	display: flex;
+	flex-direction: column;
+	height: 100%;
+	width: 100%;
+	overflow: hidden;
+}
+
+/* --- Strip: the four app entries of the reference, then one tab per open instance --- */
+
+.caret-apps-strip {
+	display: flex;
+	align-items: center;
+	flex: 0 0 auto;
+	height: 35px;
+	padding: 0 6px;
+	gap: 2px;
+	border-bottom: 1px solid var(--vscode-panel-border, var(--vscode-widget-border));
+	overflow: hidden;
+}
+
+.caret-apps-launchers {
+	display: flex;
+	align-items: center;
+	gap: 2px;
+	flex: 0 0 auto;
+}
+
+.caret-apps-launcher {
+	display: flex;
+	align-items: center;
+	justify-content: center;
+	height: 24px;
+	width: 26px;
+	margin: 0;
+	padding: 0;
+	border: none;
+	border-radius: 4px;
+	background: transparent;
+	color: var(--vscode-descriptionForeground, var(--vscode-foreground));
+	cursor: pointer;
+	font-size: 15px;
+}
+
+.caret-apps-launcher:hover {
+	background: var(--vscode-list-hoverBackground);
+	color: var(--vscode-foreground);
+}
+
+.caret-apps-launcher:focus-visible,
+.caret-apps-tab:focus-visible,
+.caret-apps-new:focus-visible,
+.caret-agent-home-utility-card:focus-visible {
+	outline: 1px solid var(--vscode-focusBorder);
+	outline-offset: -1px;
+}
+
+.caret-apps-launcher-icon {
+	font-size: 15px;
+}
+
+.caret-apps-tabs {
+	display: flex;
+	align-items: center;
+	flex: 1 1 auto;
+	gap: 2px;
+	margin-left: 6px;
+	overflow: hidden;
+}
+
+.caret-apps-tab {
+	display: flex;
+	align-items: center;
+	flex: 0 0 auto;
+	gap: 6px;
+	height: 24px;
+	max-width: 180px;
+	margin: 0;
+	padding: 0 4px 0 8px;
+	border: none;
+	border-radius: 4px;
+	background: transparent;
+	color: var(--vscode-descriptionForeground, var(--vscode-foreground));
+	cursor: pointer;
+	font-family: inherit;
+	font-size: var(--vscode-fontSize-label1, 12px);
+}
+
+.caret-apps-tab:hover {
+	background: var(--vscode-list-hoverBackground);
+}
+
+.caret-apps-tab.active {
+	background: var(--vscode-editorGroupHeader-tabsBackground, var(--vscode-editorWidget-background));
+	color: var(--vscode-foreground);
+}
+
+.caret-apps-tab-icon {
+	font-size: 13px;
+	flex: 0 0 auto;
+}
+
+.caret-apps-tab-label {
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+
+.caret-apps-tab-close {
+	display: flex;
+	align-items: center;
+	justify-content: center;
+	flex: 0 0 auto;
+	width: 16px;
+	height: 16px;
+	border-radius: 3px;
+	font-size: 12px;
+	visibility: hidden;
+}
+
+.caret-apps-tab:hover .caret-apps-tab-close,
+.caret-apps-tab.active .caret-apps-tab-close {
+	visibility: visible;
+}
+
+.caret-apps-tab-close:hover {
+	background: var(--vscode-toolbar-hoverBackground);
+}
+
+.caret-apps-summary-toggle.active {
+	background: var(--vscode-toolbar-activeBackground, var(--vscode-list-activeSelectionBackground));
+	color: var(--vscode-foreground);
+}
+
+/* --- Pinned summary: the reference's session summary above the app body --- */
+
+.caret-apps-summary {
+	display: none;
+	flex: 0 0 auto;
+	flex-direction: column;
+	gap: 2px;
+	padding: 8px 10px;
+	border-bottom: 1px solid var(--vscode-panel-border, var(--vscode-widget-border));
+}
+
+.caret-apps-panel.summary-pinned .caret-apps-summary {
+	display: flex;
+}
+
+.caret-apps-summary-title {
+	color: var(--vscode-foreground);
+	font-size: var(--vscode-fontSize-label1, 12px);
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+
+.caret-apps-summary-meta {
+	color: var(--vscode-descriptionForeground, var(--vscode-foreground));
+	font-size: var(--vscode-fontSize-label2, 11px);
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+
+/* --- Body: one container per instance, and the reference's tile grid while empty --- */
+
+.caret-apps-body {
+	position: relative;
+	flex: 1 1 auto;
+	min-height: 0;
+}
+
+/* The instance containers reuse the upstream terminal layout classes, so the wrapper
+ * and xterm inside are sized by the terminal contribution's own CSS. */
+.caret-apps-instance {
+	display: none;
+}
+
+.caret-apps-instance.active {
+	display: block;
+}
+
+/* A browser tab is an address bar plus the area the main process draws its overlay over. */
+.caret-apps-instance.caret-apps-browser {
+	position: absolute;
+	inset: 0;
+	flex-direction: column;
+	background-color: var(--vscode-editor-background);
+}
+
+.caret-apps-instance.caret-apps-browser.active {
+	display: flex;
+}
+
+.caret-apps-browser-bar {
+	position: relative;
+	display: flex;
+	align-items: center;
+	flex: 0 0 auto;
+	gap: 2px;
+	height: 32px;
+	padding: 0 6px;
+	border-bottom: 1px solid var(--vscode-panel-border, var(--vscode-widget-border));
+}
+
+.caret-apps-browser-url {
+	flex: 1 1 auto;
+	min-width: 0;
+	height: 22px;
+	margin: 0 2px;
+	padding: 0 8px;
+	border: 1px solid var(--vscode-input-border, transparent);
+	border-radius: 4px;
+	background: var(--vscode-input-background);
+	color: var(--vscode-input-foreground);
+	font-family: inherit;
+	font-size: var(--vscode-fontSize-label1, 12px);
+}
+
+.caret-apps-browser-url:focus {
+	outline: 1px solid var(--vscode-focusBorder);
+	outline-offset: -1px;
+}
+
+/* The engine's suggestions, anchored to the address bar and never wider than it. */
+.caret-apps-browser-suggest {
+	position: absolute;
+	top: 100%;
+	left: 0;
+	right: 0;
+	z-index: 20;
+	display: flex;
+	flex-direction: column;
+	margin: 0 6px;
+	padding: 4px 0;
+	border: 1px solid var(--vscode-widget-border, var(--vscode-panel-border));
+	border-radius: 6px;
+	background: var(--vscode-editorWidget-background, var(--vscode-editor-background));
+	box-shadow: 0 4px 12px var(--vscode-widget-shadow, rgba(0, 0, 0, 0.36));
+	overflow: hidden;
+}
+
+.caret-apps-browser-suggest[hidden] {
+	display: none !important;
+}
+
+.caret-apps-browser-suggest-row {
+	display: block;
+	width: 100%;
+	padding: 4px 10px;
+	border: none;
+	background: transparent;
+	color: var(--vscode-foreground);
+	font-family: inherit;
+	font-size: var(--vscode-fontSize-label1, 12px);
+	text-align: left;
+	white-space: nowrap;
+	overflow: hidden;
+	text-overflow: ellipsis;
+	cursor: pointer;
+}
+
+.caret-apps-browser-suggest-row:hover,
+.caret-apps-browser-suggest-row.active {
+	background: var(--vscode-list-activeSelectionBackground);
+	color: var(--vscode-list-activeSelectionForeground);
+}
+
+.caret-apps-icon-button {
+	display: flex;
+	align-items: center;
+	justify-content: center;
+	flex: 0 0 auto;
+	width: 22px;
+	height: 22px;
+	margin: 0;
+	padding: 0;
+	border: none;
+	border-radius: 4px;
+	background: transparent;
+	color: var(--vscode-icon-foreground);
+	cursor: pointer;
+	font-size: 13px;
+}
+
+.caret-apps-icon-button:hover:not(:disabled) {
+	background: var(--vscode-toolbar-hoverBackground);
+}
+
+.caret-apps-icon-button:disabled {
+	color: var(--vscode-disabledForeground, var(--vscode-icon-foreground));
+	opacity: 0.4;
+	cursor: default;
+}
+
+.caret-apps-browser-view {
+	position: relative;
+	flex: 1 1 auto;
+	min-height: 0;
+}
+
+.caret-apps-empty {
+	position: absolute;
+	inset: 0;
+	display: none;
+	align-items: center;
+	justify-content: center;
+	padding: 16px;
+	box-sizing: border-box;
+}
+
+.caret-apps-panel.empty .caret-apps-empty {
+	display: flex;
+}
+
+.caret-agent-home-utility-grid {
+	display: grid;
+	grid-template-columns: repeat(2, minmax(0, 1fr));
+	grid-auto-rows: 1fr;
+	gap: 8px;
+	width: 100%;
+	max-width: 320px;
+	aspect-ratio: 1 / 1;
+}
+
+.caret-agent-home-utility-card {
+	display: flex;
+	flex-direction: column;
+	align-items: center;
+	justify-content: center;
+	gap: 6px;
+	margin: 0;
+	padding: 8px;
+	border: 1px solid var(--vscode-widget-border, var(--vscode-panel-border));
+	border-radius: 8px;
+	background: var(--vscode-editorWidget-background);
+	color: var(--vscode-foreground);
+	cursor: pointer;
+	font-family: inherit;
+	font-size: var(--vscode-fontSize-label1, 12px);
+}
+
+.caret-agent-home-utility-card:hover {
+	background: var(--vscode-list-hoverBackground);
+}
+
+.caret-agent-home-utility-card-icon {
+	font-size: 20px;
+	line-height: 1;
+	color: var(--vscode-icon-foreground);
+}
+
+.caret-agent-home-utility-card-label {
+	text-align: center;
+}
+
+/* Caret: the reference centres a narrower composer in the agent surface - 608 of a
+ * 1267-wide centre in docs/caret-ui-reference-baseline.json, about 48%. The base
+ * lets the composer fill the column, which is what made the empty home read as too
+ * wide and too flat. The row above the input is narrowed with it so the card stays
+ * one column. */
+.agent-sessions-workbench .new-chat-widget-content .new-session-workspace-picker-container,
+.agent-sessions-workbench .new-chat-widget-content .new-chat-input-container {
+	max-width: 608px;
+	margin-left: auto;
+	margin-right: auto;
+}
