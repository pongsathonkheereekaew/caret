@@ -0,0 +1,806 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Caret. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import './media/agentHomeUtility.css';
+import { getZoomFactor } from '../../../../base/browser/browser.js';
+import { $, addDisposableListener, append, clearNode, Dimension, EventType } from '../../../../base/browser/dom.js';
+import { PaneView } from '../../../../base/browser/ui/splitview/paneview.js';
+import { Orientation } from '../../../../base/browser/ui/splitview/splitview.js';
+import { mainWindow } from '../../../../base/browser/window.js';
+import { Action } from '../../../../base/common/actions.js';
+import { Codicon } from '../../../../base/common/codicons.js';
+import { DisposableStore } from '../../../../base/common/lifecycle.js';
+import { autorun } from '../../../../base/common/observable.js';
+import { ThemeIcon } from '../../../../base/common/themables.js';
+import { localize } from '../../../../nls.js';
+import { ICommandService } from '../../../../platform/commands/common/commands.js';
+import { IContextMenuService } from '../../../../platform/contextview/browser/contextView.js';
+import { IInstantiationService } from '../../../../platform/instantiation/common/instantiation.js';
+import { IStorageService } from '../../../../platform/storage/common/storage.js';
+import { ITelemetryService } from '../../../../platform/telemetry/common/telemetry.js';
+import { IThemeService } from '../../../../platform/theme/common/themeService.js';
+import { EditorPane } from '../../../../workbench/browser/parts/editor/editorPane.js';
+import { IEditorGroup } from '../../../../workbench/services/editor/common/editorGroupsService.js';
+import { ISessionsService } from '../../../services/sessions/browser/sessionsService.js';
+import { ChangesViewPane } from '../../changes/browser/changesView.js';
+import { CHANGES_VIEW_ID } from '../../changes/common/changes.js';
+import { EmptyFileEditor } from '../../editor/browser/emptyFileEditor.js';
+import { AgentHomeUtilityInput } from './agentHomeUtilityInput.js';
+import { AppsPanelTabKind, IAppsPanelModel, IAppsPanelTab } from './appsPanelModel.js';
+import { mountAppsEmptyState, mountAppsTabStrip, type IAppsEmptyStateHandle, type IAppsLauncherCard, type IAppsTabStripHandle } from './appsPanelReact.js';
+import { mountAppsLauncherRail, mountAppsStripActions, mountAppsSummary, type IAppsLauncherEntry, type IAppsStripActionsHandle, type IAppsSummaryHandle } from './appsPanelReact.js';
+
+/**
+ * The reference app strip: `Review · Browser · Terminal · File`, in that order.
+ *
+ * Every entry is a pane of this panel, which is what makes the strip a pane switcher: the four
+ * ids name the four surfaces the reference's panel holds, and none of them opens its surface
+ * somewhere else in the window. Browser and Terminal are instances (one tab each, `+` adds
+ * another); Changes and File are the window's single-instance panes, whose content the panel
+ * hosts from the base's own surfaces.
+ */
+interface IAppsLauncher {
+	readonly id: string;
+	readonly label: string;
+	readonly icon: ThemeIcon;
+	readonly hosted: AppsPanelTabKind;
+}
+
+const LAUNCHERS: readonly IAppsLauncher[] = [
+	// The reference's own strip order and wording, measured from its window: the first entry is
+	// `Changes` (the id stays `review` because it is what `caret.apps.open.*` already ships).
+	{ id: 'review', label: localize('caret.agentHome.utility.review', "Changes"), icon: Codicon.gitCompare, hosted: 'changes' },
+	{ id: 'browser', label: localize('caret.agentHome.utility.browser', "Browser"), icon: Codicon.globe, hosted: 'browser' },
+	{ id: 'terminal', label: localize('caret.agentHome.utility.terminal', "Terminal"), icon: Codicon.terminal, hosted: 'terminal' },
+	{ id: 'file', label: localize('caret.agentHome.utility.file', "File"), icon: Codicon.fileCode, hosted: 'file' },
+];
+
+/** The launcher list as the plain data the React card surface takes. */
+function launcherCards(): IAppsLauncherCard[] {
+	return LAUNCHERS.map(launcher => ({ id: launcher.id, label: launcher.label, iconId: launcher.icon.id }));
+}
+
+/** The same list as the strip entries React renders, with what each id switches to. */
+function launcherEntries(): IAppsLauncherEntry[] {
+	return LAUNCHERS.map(launcher => ({
+		id: launcher.id,
+		label: launcher.label,
+		iconId: launcher.icon.id,
+		kind: launcher.hosted,
+	}));
+}
+
+/** The DOM a tab owns while the panel is on screen. */
+interface IAppsTabView {
+	readonly container: HTMLElement;
+	/** The element the browser overlay is laid out to (below the address bar). */
+	readonly view: HTMLElement;
+	readonly urlInput: HTMLInputElement | undefined;
+	readonly disposables: DisposableStore;
+	/** A hosted view pane (Changes) sizes itself; the panel calls this with its own bounds. */
+	readonly layoutPanes?: (width: number, height: number) => void;
+	/** Focus the hosted pane's own control, if it has one. */
+	readonly focusPanes?: () => void;
+}
+
+/**
+ * The Agent Home utility area: the reference's right-hand Apps panel.
+ *
+ * The panel draws the pane's only strip, so its entries and its instance tabs always sit
+ * on one row. Instances themselves are owned by {@link IAppsPanelModel} rather than by
+ * this pane: the Agents window layout closes and re-creates non-docked editors when it
+ * collapses the editor area, so a pane that owned its terminals and browser views would
+ * lose every tab on each collapse. This pane attaches their DOM while it is on screen and
+ * detaches it when it goes away, and the instances keep running in between.
+ */
+export class AgentHomeUtilityEditor extends EditorPane {
+
+	static readonly ID = AgentHomeUtilityInput.EDITOR_ID;
+
+	private readonly views = new Map<string, IAppsTabView>();
+	private tabsElement: HTMLElement | undefined;
+	private bodyElement: HTMLElement | undefined;
+	private summaryElement: HTMLElement | undefined;
+	private stripActions: IAppsStripActionsHandle | undefined;
+	private activeTabId: string | undefined;
+	private renderedTabCount = 0;
+	/**
+	 * The React root for the empty-state cards, or `undefined` while instance tabs exist.
+	 * The reference's agent UI is React (see `appsPanelReact.ts`), and this pane is where
+	 * Caret starts moving to it: the model stays in this class, the cards are React's.
+	 */
+	private emptyState: IAppsEmptyStateHandle | undefined;
+	/** React owns the instance tab buttons; the pane keeps each tab's body. */
+	private tabStrip: IAppsTabStripHandle | undefined;
+	/** React owns the summary markup; the pane keeps the observables that feed it. */
+	private summaryView: IAppsSummaryHandle | undefined;
+	/** The `.caret-apps-panel` root, which carries the pinned-summary state class. */
+	private panelElement: HTMLElement | undefined;
+	/** React owns the strip entries; the pane keeps what each one does. */
+	private launcherRail: IAppsEmptyStateHandle | undefined;
+	/**
+	 * Whether the pane itself is on screen. A hosted browser page is a native view drawn
+	 * ABOVE this window's DOM, so it must never be shown for a pane the workbench has
+	 * hidden behind another editor; the pane's own `layout()` is what shows it again.
+	 */
+	private isEditorVisible = true;
+
+	constructor(
+		group: IEditorGroup,
+		@ITelemetryService telemetryService: ITelemetryService,
+		@IThemeService themeService: IThemeService,
+		@IStorageService storageService: IStorageService,
+		@IInstantiationService private readonly instantiationService: IInstantiationService,
+		@ICommandService private readonly commandService: ICommandService,
+		@IContextMenuService private readonly contextMenuService: IContextMenuService,
+		@IAppsPanelModel private readonly panelModel: IAppsPanelModel,
+		@ISessionsService private readonly sessionsService: ISessionsService,
+	) {
+		super(AgentHomeUtilityEditor.ID, group, telemetryService, themeService, storageService);
+	}
+
+	protected override createEditor(parent: HTMLElement): void {
+		const root = append(parent, $('.caret-apps-panel'));
+		this.panelElement = root;
+
+		const strip = append(root, $('.caret-apps-strip'));
+		const launchers = append(strip, $('.caret-apps-launchers'));
+		// The strip entries are React now, in the reference's own order (Changes · Browser ·
+		// Terminal · File); the pane keeps what each id does (`runLauncher`).
+		this.launcherRail = mountAppsLauncherRail(launchers, launcherEntries(), id => {
+			const launcher = LAUNCHERS.find(candidate => candidate.id === id);
+			if (launcher) {
+				// The rail selects a pane: it shows the one that is already there.
+				this.runLauncher(launcher, 'reuse');
+			}
+		});
+
+		this.tabsElement = append(strip, $('.caret-apps-tabs'));
+		// React owns the tab buttons; the pane owns every tab's body (a terminal attaches an
+		// instance, a browser lays a native view over its own element).
+		this.tabStrip = mountAppsTabStrip(this.tabsElement, {
+			onSelect: id => this.activateTab(id),
+			onClose: id => this.panelModel.closeTab(id),
+		});
+		// The strip's two icon buttons are React's too, so the whole strip is one renderer; the
+		// host is `display: contents` so they stay two flex items of the strip itself.
+		const actions = append(strip, $('.caret-apps-actions'));
+		this.stripActions = mountAppsStripActions(actions, {
+			onOpenMenu: anchor => this.openNewTabMenu(anchor),
+			onToggleSummary: () => this.toggleSummary(),
+		});
+
+		this.summaryElement = append(root, $('.caret-apps-summary'));
+		this.bodyElement = append(root, $('.caret-apps-body'));
+
+		this._register(this.panelModel.onDidChange(() => this.renderTabs()));
+		this._register({ dispose: () => this.detachInstances() });
+
+		this.updateEmptyState();
+		this.renderSummary();
+		this.renderTabs();
+	}
+
+	// --- Strip entries -----------------------------------------------------
+
+	/**
+	 * `reuse` is what separates the strip's entries from its `+` menu, and it is the reference's
+	 * own split: the strip is a pane switcher, so picking a pane that is already open shows it
+	 * (and marks it), while `+` is what opens an additional instance. Both go through here so the
+	 * two halves cannot drift apart on what "Browser" means.
+	 */
+	private runLauncher(launcher: IAppsLauncher, mode: 'reuse' | 'new'): void {
+		if (launcher.hosted === 'terminal') {
+			const existing = mode === 'reuse' ? this.panelModel.tabs.find(tab => tab.kind === 'terminal') : undefined;
+			if (existing) {
+				this.activateTab(existing.id);
+				return;
+			}
+			void this.panelModel.createTerminal();
+			return;
+		}
+		if (launcher.hosted === 'browser') {
+			const existing = mode === 'reuse' ? this.panelModel.tabs.find(tab => tab.kind === 'browser') : undefined;
+			if (existing) {
+				this.activateTab(existing.id);
+				return;
+			}
+			void this.panelModel.createBrowser();
+			return;
+		}
+		// Changes and Files have nothing to multiply: the window owns one of each, so both modes
+		// mean the same thing here - show the pane, opening it only while it is not there yet.
+		const tab = launcher.hosted === 'changes' ? this.panelModel.createChanges() : this.panelModel.createFiles();
+		this.activateTab(tab.id);
+	}
+
+	/** `+` lists the apps, anchored to the button rather than centred in the window. */
+	private openNewTabMenu(button: HTMLElement): void {
+		const anchor = button.getBoundingClientRect();
+		// A hosted page is a native view drawn above this window's DOM, so a menu anchored to the
+		// strip opens *behind* the page it belongs to: with one browser tab already open the user
+		// sees `+`, clicks a row, and the click lands on the page instead - the menu looks broken
+		// from the second tab onward. The page gives the popup room while the menu is up.
+		this.hideBrowserForPopup();
+		this.contextMenuService.showContextMenu({
+			getAnchor: () => ({ x: anchor.left, y: anchor.bottom, width: anchor.width, height: anchor.height }),
+			getActions: () => LAUNCHERS.map(launcher => new Action(
+				`caret.apps.open.${launcher.id}`,
+				launcher.label,
+				// `Action`'s third parameter is CSS class names, not an icon object: passing the
+				// ThemeIcon put a non-class string on the element (`tsc` rejected it), so the
+				// menu entries never drew their codicon.
+				ThemeIcon.isThemeIcon(launcher.icon) ? `codicon codicon-${launcher.icon.id}` : undefined,
+				true,
+				// `+` is the instance opener, not a pane switch.
+				() => this.runLauncher(launcher, 'new'),
+			)),
+			getActionsContext: () => undefined,
+			onHide: () => this.restoreAfterPopup(),
+		});
+	}
+
+	/**
+	 * Take the hosted page out of the way of a DOM popup this pane opened.
+	 *
+	 * Only the active browser tab has a view on screen, and `applyActiveTab` puts it back with
+	 * the bounds the pane last measured, so hiding and restoring is the whole of it.
+	 */
+	private hideBrowserForPopup(): void {
+		const tab = this.panelModel.tabs.find(candidate => candidate.id === this.activeTabId);
+		void tab?.browser?.setVisible(false);
+	}
+
+	private restoreAfterPopup(): void {
+		this.applyActiveTab();
+	}
+
+	// --- Instance tabs -----------------------------------------------------
+
+	/** Mirrors the panel model into this pane's DOM, attaching instances that have none. */
+	private renderTabs(): void {
+		const tabsElement = this.tabsElement;
+		const bodyElement = this.bodyElement;
+		if (!tabsElement || !bodyElement) {
+			return;
+		}
+
+		const live = new Set<string>();
+		for (const tab of this.panelModel.tabs) {
+			live.add(tab.id);
+			// A label change is a React re-render below, not a DOM edit here.
+			if (this.views.has(tab.id)) {
+				continue;
+			}
+			this.views.set(tab.id, this.createTabView(tab));
+		}
+
+		for (const [id, view] of [...this.views]) {
+			if (live.has(id)) {
+				continue;
+			}
+			view.disposables.dispose();
+			view.container.remove();
+			this.views.delete(id);
+		}
+
+		// A new instance becomes the tab the user is looking at; an existing selection is kept
+		// across re-renders, and a selection whose tab is gone falls back to the last tab.
+		if (this.panelModel.tabs.length > this.renderedTabCount) {
+			this.activeTabId = this.panelModel.tabs[this.panelModel.tabs.length - 1]?.id;
+		} else if (!this.activeTabId || !live.has(this.activeTabId)) {
+			const last = this.panelModel.tabs[this.panelModel.tabs.length - 1];
+			this.activeTabId = last?.id;
+		}
+		this.renderedTabCount = this.panelModel.tabs.length;
+		this.applySummaryPinned();
+		this.tabStrip?.update(
+			this.panelModel.tabs.map(tab => ({ id: tab.id, title: tab.title, kind: tab.kind })),
+			this.activeTabId,
+		);
+		this.applyActiveTab();
+	}
+
+	private createTabView(tab: IAppsPanelTab): IAppsTabView {
+		const tabsElement = this.tabsElement!;
+		const bodyElement = this.bodyElement!;
+		const disposables = new DisposableStore();
+
+		// Changes and Files are panes of this panel now, so they build their bodies here rather
