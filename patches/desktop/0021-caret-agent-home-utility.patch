+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Caret. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import './media/agentHomeUtility.css';
+import { getZoomFactor } from '../../../../base/browser/browser.js';
+import { $, addDisposableListener, append, clearNode, Dimension, EventType } from '../../../../base/browser/dom.js';
+import { mainWindow } from '../../../../base/browser/window.js';
+import { Action } from '../../../../base/common/actions.js';
+import { Codicon } from '../../../../base/common/codicons.js';
+import { DisposableStore } from '../../../../base/common/lifecycle.js';
+import { autorun } from '../../../../base/common/observable.js';
+import { ThemeIcon } from '../../../../base/common/themables.js';
+import { localize } from '../../../../nls.js';
+import { ICommandService } from '../../../../platform/commands/common/commands.js';
+import { IContextMenuService } from '../../../../platform/contextview/browser/contextView.js';
+import { IStorageService } from '../../../../platform/storage/common/storage.js';
+import { ITelemetryService } from '../../../../platform/telemetry/common/telemetry.js';
+import { IThemeService } from '../../../../platform/theme/common/themeService.js';
+import { EditorPane } from '../../../../workbench/browser/parts/editor/editorPane.js';
+import { IEditorGroup } from '../../../../workbench/services/editor/common/editorGroupsService.js';
+import { ISessionsService } from '../../../services/sessions/browser/sessionsService.js';
+import { NEW_CHANGES_TAB_COMMAND_ID } from '../../editor/browser/addTabActions.js';
+import { AgentHomeUtilityInput } from './agentHomeUtilityInput.js';
+import { IAppsPanelModel, IAppsPanelTab } from './appsPanelModel.js';
+
+const QUICK_OPEN_COMMAND_ID = 'workbench.action.quickOpen';
+
+/**
+ * The reference app strip: `Review · Browser · Terminal · File`, in that order.
+ *
+ * The strip entry and `+` share these entries, so an entry never opens its surface
+ * somewhere else: Browser and Terminal are hosted by the panel (one tab per instance),
+ * Review and File run the real commands this window already has.
+ */
+interface IAppsLauncher {
+	readonly id: string;
+	readonly label: string;
+	readonly icon: ThemeIcon;
+	readonly commandId?: string;
+	readonly hosted?: 'terminal' | 'browser';
+}
+
+const LAUNCHERS: readonly IAppsLauncher[] = [
+	{ id: 'review', label: localize('caret.agentHome.utility.review', "Review"), icon: Codicon.gitCompare, commandId: NEW_CHANGES_TAB_COMMAND_ID },
+	{ id: 'browser', label: localize('caret.agentHome.utility.browser', "Browser"), icon: Codicon.globe, hosted: 'browser' },
+	{ id: 'terminal', label: localize('caret.agentHome.utility.terminal', "Terminal"), icon: Codicon.terminal, hosted: 'terminal' },
+	{ id: 'file', label: localize('caret.agentHome.utility.file', "File"), icon: Codicon.fileCode, commandId: QUICK_OPEN_COMMAND_ID },
+];
+
+/** The DOM a tab owns while the panel is on screen. */
+interface IAppsTabView {
+	readonly button: HTMLButtonElement;
+	readonly labelElement: HTMLElement;
+	readonly container: HTMLElement;
+	/** The element the browser overlay is laid out to (below the address bar). */
+	readonly view: HTMLElement;
+	readonly urlInput: HTMLInputElement | undefined;
+	readonly disposables: DisposableStore;
+}
+
+/**
+ * The Agent Home utility area: the reference's right-hand Apps panel.
+ *
+ * The panel draws the pane's only strip, so its entries and its instance tabs always sit
+ * on one row. Instances themselves are owned by {@link IAppsPanelModel} rather than by
+ * this pane: the Agents window layout closes and re-creates non-docked editors when it
+ * collapses the editor area, so a pane that owned its terminals and browser views would
+ * lose every tab on each collapse. This pane attaches their DOM while it is on screen and
+ * detaches it when it goes away, and the instances keep running in between.
+ */
+export class AgentHomeUtilityEditor extends EditorPane {
+
+	static readonly ID = AgentHomeUtilityInput.EDITOR_ID;
+
+	private readonly views = new Map<string, IAppsTabView>();
+	private newTabButton: HTMLButtonElement | undefined;
+	private tabsElement: HTMLElement | undefined;
+	private bodyElement: HTMLElement | undefined;
+	private summaryElement: HTMLElement | undefined;
+	private summaryToggle: HTMLButtonElement | undefined;
+	private activeTabId: string | undefined;
+	private renderedTabCount = 0;
+
+	constructor(
+		group: IEditorGroup,
+		@ITelemetryService telemetryService: ITelemetryService,
+		@IThemeService themeService: IThemeService,
+		@IStorageService storageService: IStorageService,
+		@ICommandService private readonly commandService: ICommandService,
+		@IContextMenuService private readonly contextMenuService: IContextMenuService,
+		@IAppsPanelModel private readonly panelModel: IAppsPanelModel,
+		@ISessionsService private readonly sessionsService: ISessionsService,
+	) {
+		super(AgentHomeUtilityEditor.ID, group, telemetryService, themeService, storageService);
+	}
+
+	protected override createEditor(parent: HTMLElement): void {
+		const root = append(parent, $('.caret-apps-panel'));
+
+		const strip = append(root, $('.caret-apps-strip'));
+		const launchers = append(strip, $('.caret-apps-launchers'));
+		for (const launcher of LAUNCHERS) {
+			this.createLauncherButton(launchers, launcher, 'strip');
+		}
+
+		this.tabsElement = append(strip, $('.caret-apps-tabs'));
+		const newTab = append(strip, $<HTMLButtonElement>('button.caret-apps-new'));
+		newTab.type = 'button';
+		newTab.classList.add('codicon', `codicon-${Codicon.add.id}`, 'caret-apps-icon-button');
+		newTab.setAttribute('aria-label', localize('caret.agentHome.utility.newInstance', "Open in Apps panel"));
+		newTab.setAttribute('title', localize('caret.agentHome.utility.newInstance', "Open in Apps panel"));
+		newTab.setAttribute('aria-haspopup', 'menu');
+		this.newTabButton = newTab;
+		this._register(addDisposableListener(newTab, EventType.CLICK, () => this.openNewTabMenu()));
+
+		const summaryToggle = append(strip, $<HTMLButtonElement>('button.caret-apps-summary-toggle'));
+		summaryToggle.type = 'button';
+		summaryToggle.classList.add('codicon', `codicon-${Codicon.pin.id}`, 'caret-apps-icon-button');
+		summaryToggle.setAttribute('aria-label', localize('caret.agentHome.utility.toggleSummary', "Toggle Pinned Summary"));
+		summaryToggle.setAttribute('aria-pressed', 'false');
+		summaryToggle.setAttribute('title', localize('caret.agentHome.utility.toggleSummary', "Toggle Pinned Summary"));
+		this.summaryToggle = summaryToggle;
+		this._register(addDisposableListener(summaryToggle, EventType.CLICK, () => this.toggleSummary()));
+
+		this.summaryElement = append(root, $('.caret-apps-summary'));
+		this.bodyElement = append(root, $('.caret-apps-body'));
+
+		this._register(this.panelModel.onDidChange(() => this.renderTabs()));
+		this._register({ dispose: () => this.detachInstances() });
+
+		this.updateEmptyState();
+		this.renderSummary();
+		this.renderTabs();
+	}
+
+	// --- Strip entries -----------------------------------------------------
+
+	private createLauncherButton(parent: HTMLElement, launcher: IAppsLauncher, mode: 'strip' | 'card'): HTMLButtonElement {
+		const button = append(parent, $<HTMLButtonElement>(mode === 'card' ? 'button.caret-agent-home-utility-card' : 'button.caret-apps-launcher'));
+		button.type = 'button';
+
+		const icon = append(button, $(mode === 'card' ? 'span.caret-agent-home-utility-card-icon' : 'span.caret-apps-launcher-icon'));
+		icon.classList.add('codicon', `codicon-${launcher.icon.id}`);
+		icon.setAttribute('aria-hidden', 'true');
+
+		// The column is narrow, so the strip entry is the icon with its name as the
+		// accessible name and tooltip; the labelled form of the same entry is the card in
+		// the empty body.
+		button.setAttribute('aria-label', launcher.label);
+		if (mode === 'card') {
+			const label = append(button, $('span.caret-agent-home-utility-card-label'));
+			label.textContent = launcher.label;
+		} else {
+			button.setAttribute('title', launcher.label);
+		}
+		this._register(addDisposableListener(button, EventType.CLICK, () => this.runLauncher(launcher)));
+		return button;
+	}
+
+	private runLauncher(launcher: IAppsLauncher): void {
+		if (launcher.hosted === 'terminal') {
+			void this.panelModel.createTerminal();
+			return;
+		}
+		if (launcher.hosted === 'browser') {
+			void this.panelModel.createBrowser();
+			return;
+		}
+		if (!launcher.commandId) {
+			return;
+		}
+		// A command whose surface is unavailable in the current state (Changes before a
+		// session exists, for example) resolves without opening anything instead of throwing.
+		void Promise.resolve(this.commandService.executeCommand(launcher.commandId)).catch(() => undefined);
+	}
+
+	/** `+` lists the apps, anchored to the button rather than centred in the window. */
+	private openNewTabMenu(): void {
+		const anchor = this.newTabButton?.getBoundingClientRect();
+		if (!anchor) {
+			return;
+		}
+		this.contextMenuService.showContextMenu({
+			getAnchor: () => ({ x: anchor.left, y: anchor.bottom, width: anchor.width, height: anchor.height }),
+			getActions: () => LAUNCHERS.map(launcher => new Action(
+				`caret.apps.open.${launcher.id}`,
+				launcher.label,
+				launcher.icon,
+				true,
+				() => this.runLauncher(launcher),
+			)),
+			getActionsContext: () => undefined,
+		});
+	}
+
+	// --- Instance tabs -----------------------------------------------------
+
+	/** Mirrors the panel model into this pane's DOM, attaching instances that have none. */
+	private renderTabs(): void {
+		const tabsElement = this.tabsElement;
+		const bodyElement = this.bodyElement;
+		if (!tabsElement || !bodyElement) {
+			return;
+		}
+
+		const live = new Set<string>();
+		for (const tab of this.panelModel.tabs) {
+			live.add(tab.id);
+			const existing = this.views.get(tab.id);
+			if (existing) {
+				this.setTabLabel(existing, tab.title);
+				continue;
+			}
+			this.views.set(tab.id, this.createTabView(tab));
+		}
+
+		for (const [id, view] of [...this.views]) {
+			if (live.has(id)) {
+				continue;
+			}
+			view.disposables.dispose();
+			view.button.remove();
+			view.container.remove();
+			this.views.delete(id);
+		}
+
+		// A new instance becomes the tab the user is looking at; an existing selection is kept
+		// across re-renders, and a selection whose tab is gone falls back to the last tab.
+		if (this.panelModel.tabs.length > this.renderedTabCount) {
+			this.activeTabId = this.panelModel.tabs[this.panelModel.tabs.length - 1]?.id;
+		} else if (!this.activeTabId || !live.has(this.activeTabId)) {
+			const last = this.panelModel.tabs[this.panelModel.tabs.length - 1];
+			this.activeTabId = last?.id;
+		}
+		this.renderedTabCount = this.panelModel.tabs.length;
+		this.applyActiveTab();
+	}
+
+	private createTabView(tab: IAppsPanelTab): IAppsTabView {
+		const tabsElement = this.tabsElement!;
+		const bodyElement = this.bodyElement!;
+		const disposables = new DisposableStore();
+
+		const container = append(bodyElement, $(tab.kind === 'browser' ? '.caret-apps-instance.caret-apps-browser' : '.caret-apps-instance.terminal-overflow-guard.terminal-editor'));
+		const button = append(tabsElement, $<HTMLButtonElement>('button.caret-apps-tab'));
+		button.type = 'button';
+		button.setAttribute('role', 'tab');
+		button.setAttribute('aria-label', tab.title);
+
+		const icon = append(button, $('span.caret-apps-tab-icon'));
+		icon.classList.add('codicon', `codicon-${tab.kind === 'browser' ? Codicon.globe.id : Codicon.terminal.id}`);
+		icon.setAttribute('aria-hidden', 'true');
+
+		const labelElement = append(button, $('span.caret-apps-tab-label'));
+		labelElement.textContent = tab.title;
+
+		const close = append(button, $('span.caret-apps-tab-close'));
+		close.classList.add('codicon', `codicon-${Codicon.close.id}`);
+		close.setAttribute('role', 'button');
+		close.setAttribute('aria-label', localize('caret.agentHome.utility.closeInstance', "Close Tab"));
+
+		disposables.add(addDisposableListener(button, EventType.CLICK, event => {
+			if (event.target !== close) {
+				this.activateTab(tab.id);
+			}
+		}));
+		disposables.add(addDisposableListener(close, EventType.CLICK, event => {
+			event.stopPropagation();
+			this.panelModel.closeTab(tab.id);
+		}));
+
+		if (tab.kind === 'terminal') {
+			tab.instance?.attachToElement(container);
+			return { button, labelElement, container, view: container, urlInput: undefined, disposables };
+		}
+
+		// A browser tab carries its own address bar: the hosted view has no chrome of its
+		// own, so the address is entered here instead of in a dialog.
+		const bar = append(container, $('.caret-apps-browser-bar'));
+		const back = this.createBrowserAction(bar, Codicon.arrowLeft, localize('caret.agentHome.utility.browserBack', "Back"), () => void tab.browser?.goBack());
+		const forward = this.createBrowserAction(bar, Codicon.arrowRight, localize('caret.agentHome.utility.browserForward', "Forward"), () => void tab.browser?.goForward());
+		this.createBrowserAction(bar, Codicon.refresh, localize('caret.agentHome.utility.browserReload', "Reload"), () => {
+			const url = tab.browser?.url;
+			if (url) {
+				void tab.browser?.loadURL(url);
+			}
+		});
+		const urlInput = append(bar, $<HTMLInputElement>('input.caret-apps-browser-url'));
+		urlInput.setAttribute('aria-label', localize('caret.agentHome.utility.browserUrl', "Address"));
+		urlInput.setAttribute('placeholder', localize('caret.agentHome.utility.browserUrlPlaceholder', "Search or enter URL"));
+		urlInput.type = 'text';
+		urlInput.spellcheck = false;
+
+		// Suggestions: the bar searches, so it offers what the engine would suggest for
+		// the term. This window is subject to CORS, so the extension host makes the
+		// request (`caret.browser.suggest`); a failure is an empty list, never an error.
+		const suggestionBox = append(bar, $('.caret-apps-browser-suggest'));
+		suggestionBox.hidden = true;
+		let suggestions: string[] = [];
+		let activeSuggestion = -1;
+		let suggestTimer: number | undefined;
+		let suggestRequest = 0;
+		const closeSuggestions = (): void => {
+			suggestions = [];
+			activeSuggestion = -1;
+			suggestionBox.hidden = true;
+			clearNode(suggestionBox);
+		};
+		const renderSuggestions = (): void => {
+			clearNode(suggestionBox);
+			suggestionBox.hidden = suggestions.length === 0;
+			suggestions.forEach((term, index) => {
+				const row = append(suggestionBox, $<HTMLButtonElement>('button.caret-apps-browser-suggest-row'));
+				row.type = 'button';
+				row.textContent = term;
+				row.classList.toggle('active', index === activeSuggestion);
+				disposables.add(addDisposableListener(row, EventType.MOUSE_DOWN, event => {
+					// Mouse down, not click: taking the value first keeps the input's blur
+					// from closing the list before the choice lands.
+					event.preventDefault();
+					urlInput.value = term;
+					closeSuggestions();
+					void tab.browser?.loadURL(searchUrlFor(term));
+				}));
+			});
+		};
+		const requestSuggestions = (term: string): void => {
+			const request = ++suggestRequest;
+			void Promise.resolve(this.commandService.executeCommand<string[]>('caret.browser.suggest', term))
+				.then(terms => {
+					// A late answer for an older term must not replace the current list.
+					if (request !== suggestRequest || urlInput.value.trim() !== term) {
+						return;
+					}
+					suggestions = Array.isArray(terms) ? terms.filter(item => typeof item === 'string') : [];
+					activeSuggestion = -1;
+					renderSuggestions();
+				})
+				.catch(() => undefined);
+		};
+		disposables.add({
+			dispose: () => {
+				if (suggestTimer !== undefined) {
+					clearTimeout(suggestTimer);
+				}
+			},
+		});
+		disposables.add(addDisposableListener(urlInput, EventType.INPUT, () => {
+			if (suggestTimer !== undefined) {
+				clearTimeout(suggestTimer);
+			}
+			const term = urlInput.value.trim();
+			if (!isSearchTerm(term)) {
+				suggestRequest++;
+				closeSuggestions();
+				return;
+			}
+			suggestTimer = mainWindow.setTimeout(() => requestSuggestions(term), 180);
+		}));
+		disposables.add(addDisposableListener(urlInput, EventType.BLUR, () => closeSuggestions()));
+
+		disposables.add(addDisposableListener(urlInput, EventType.KEY_DOWN, event => {
+			if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+				if (suggestions.length === 0) {
+					return;
+				}
+				event.preventDefault();
+				const step = event.key === 'ArrowDown' ? 1 : -1;
+				activeSuggestion = (activeSuggestion + step + suggestions.length) % suggestions.length;
+				renderSuggestions();
+				return;
+			}
+			if (event.key === 'Escape') {
+				closeSuggestions();
+				return;
+			}
+			if (event.key !== 'Enter') {
+				return;
+			}
+			event.preventDefault();
+			if (activeSuggestion >= 0 && suggestions[activeSuggestion]) {
+				const chosen = suggestions[activeSuggestion];
+				urlInput.value = chosen;
+				closeSuggestions();
+				void tab.browser?.loadURL(searchUrlFor(chosen));
+				return;
+			}
+			closeSuggestions();
+			const value = urlInput.value.trim();
+			if (value) {
+				void tab.browser?.loadURL(normaliseUrl(value));
+			}
+		}));
+		if (tab.browser) {
+			const browser = tab.browser;
+			const sync = () => {
+				if (mainWindow.document.activeElement !== urlInput) {
+					urlInput.value = browser.url;
+				}
+				back.disabled = !browser.canGoBack;
+				forward.disabled = !browser.canGoForward;
+			};
+			disposables.add(browser.onDidNavigate(sync));
+			disposables.add(browser.onDidChangeTitle(sync));
+			sync();
+		}
+
+		const view = append(container, $('.caret-apps-browser-view'));
+		return { button, labelElement, container, view, urlInput, disposables };
+	}
+
+	private createBrowserAction(parent: HTMLElement, icon: ThemeIcon, label: string, run: () => void): HTMLButtonElement {
+		const button = append(parent, $<HTMLButtonElement>('button.caret-apps-icon-button'));
+		button.type = 'button';
+		button.classList.add('codicon', `codicon-${icon.id}`);
+		button.setAttribute('aria-label', label);
+		button.setAttribute('title', label);
+		this._register(addDisposableListener(button, EventType.CLICK, run));
+		return button;
+	}
+
+	private setTabLabel(view: IAppsTabView, label: string): void {
+		view.labelElement.textContent = label;
+		view.button.setAttribute('aria-label', label);
+	}
+
+	private activateTab(id: string): void {
+		this.activeTabId = id;
+		this.applyActiveTab();
+		const view = this.views.get(id);
+		const tab = this.panelModel.tabs.find(candidate => candidate.id === id);
+		if (tab?.instance) {
+			tab.instance.focus();
+		} else if (tab?.browser) {
+			void tab.browser.focus();
+		} else {
+			view?.urlInput?.focus();
+		}
+	}
+
+	private applyActiveTab(): void {
+		for (const [id, view] of this.views) {
+			const active = id === this.activeTabId;
+			view.button.classList.toggle('active', active);
+			view.button.setAttribute('aria-selected', String(active));
+			view.container.classList.toggle('active', active);
+			const tab = this.panelModel.tabs.find(candidate => candidate.id === id);
+			tab?.instance?.setVisible(active);
+			if (tab?.browser) {
+				void tab.browser.setVisible(active);
+			}
+		}
+		this.updateEmptyState();
+		this.layoutActiveInstance();
+	}
+
+	/** The pane is going away: keep the instances, drop their DOM. */
+	private detachInstances(): void {
+		for (const view of this.views.values()) {
+			view.disposables.dispose();
+		}
+		for (const tab of this.panelModel.tabs) {
+			tab.instance?.detachFromElement();
+			if (tab.browser) {
+				void tab.browser.setVisible(false);
+			}
+		}
+		this.views.clear();
+	}
+
+	/** The launcher cards stand in for the pane while no instance tab is open. */
+	private updateEmptyState(): void {
+		const body = this.bodyElement;
+		const root = body?.parentElement;
+		if (!body || !root) {
+			return;
+		}
+		const empty = root.querySelector<HTMLElement>('.caret-apps-empty');
+		if (this.panelModel.tabs.length === 0) {
+			if (!empty) {
+				const cards = append(append(body, $('.caret-apps-empty')), $('.caret-agent-home-utility-grid'));
+				for (const launcher of LAUNCHERS) {
+					this.createLauncherButton(cards, launcher, 'card');
+				}
+			}
+		} else {
+			empty?.remove();
+		}
+		root.classList.toggle('empty', this.panelModel.tabs.length === 0);
+	}
+
+	// --- Pinned summary ----------------------------------------------------
+
+	private toggleSummary(): void {
+		const panel = this.summaryElement?.parentElement;
+		const pinned = !panel?.classList.contains('summary-pinned');
+		panel?.classList.toggle('summary-pinned', pinned);
+		this.summaryToggle?.classList.toggle('active', pinned);
+		this.summaryToggle?.setAttribute('aria-pressed', String(pinned));
+	}
+
+	private renderSummary(): void {
+		const summary = this.summaryElement;
+		if (!summary) {
+			return;
+		}
+		const title = append(summary, $('.caret-apps-summary-title'));
+		const meta = append(summary, $('.caret-apps-summary-meta'));
+		this._register(autorun(reader => {
+			const session = this.sessionsService.activeSession.read(reader);
+			if (!session) {
+				title.textContent = localize('caret.agentHome.summary.empty', "No active session");
+				meta.textContent = '';
+				return;
+			}
+			const sessionTitle = session.title.read(reader);
+			const status = session.status.read(reader);
+			const branch = session.workspace.read(reader)?.folders[0]?.gitRepository?.branchName;
+			title.textContent = sessionTitle;
+			meta.textContent = branch ? `${status} · ${branch}` : String(status);
+		}));
+	}
+
+	// --- Layout ------------------------------------------------------------
+
+	private layoutActiveInstance(): void {
+		const tab = this.panelModel.tabs.find(candidate => candidate.id === this.activeTabId);
+		const view = tab ? this.views.get(tab.id) : undefined;
+		if (!tab || !view || !view.container.classList.contains('active')) {
+			return;
+		}
+		if (tab.browser) {
+			this.layoutBrowserTab(tab, view);
+			return;
+		}
+		const { clientWidth, clientHeight } = view.container;
+		if (clientWidth > 0 && clientHeight > 0) {
+			tab.instance?.layout({ width: clientWidth, height: clientHeight });
+		}
+	}
+
+	/**
+	 * Pushes the browser view's bounds to the overlay the main process draws above this
+	 * pane. A stale rect is what let the page spill outside the panel, so the bounds come
+	 * from the tab's own view element on every layout.
+	 */
+	private layoutBrowserTab(tab: IAppsPanelTab, view: IAppsTabView): void {
+		const model = tab.browser;
+		if (!model) {
+			return;
+		}
+		const rect = view.view.getBoundingClientRect();
+		if (rect.width < 1 || rect.height < 1) {
+			void model.setVisible(false);
+			return;
+		}
+		const bounds = {
+			windowId: this.group.windowId,
+			x: Math.round(rect.left),
+			y: Math.round(rect.top),
+			width: Math.round(rect.width),
+			height: Math.round(rect.height),
+			zoomFactor: getZoomFactor(mainWindow),
+			cornerRadius: 0,
+		};
+		void model.layout(bounds).then(() => {
+			// A view that is hidden keeps its bounds; the pane records what it pushed so a
+			// receipt capture can read it back.
+			view.view.dataset.appsBrowserBounds = JSON.stringify(bounds);
+			view.view.dataset.appsBrowserVisible = String(model.visible);
+		});
+	}
+
+	/** Switching away from the App pane must take the overlays with it. */
+	protected override setEditorVisible(visible: boolean): void {
+		super.setEditorVisible(visible);
+		for (const [id, view] of this.views) {
+			const tab = this.panelModel.tabs.find(candidate => candidate.id === id);
+			if (!tab?.browser) {
+				continue;
+			}
+			const showing = visible && id === this.activeTabId;
+			void tab.browser.setVisible(showing);
+			if (showing) {
+				this.layoutBrowserTab(tab, view);
+			}
+		}
+	}
+
+	override layout(_dimension: Dimension): void {
+		this.layoutActiveInstance();
+	}
+
+	override focus(): void {
+		const tab = this.panelModel.tabs.find(candidate => candidate.id === this.activeTabId);
+		if (tab?.instance) {
+			tab.instance.focus();
+			return;
+		}
+		if (tab?.browser) {
+			void tab.browser.focus();
+			return;
+		}
+		this.bodyElement?.querySelector<HTMLElement>('.caret-agent-home-utility-card, .caret-apps-browser-url')?.focus();
+	}
+}
+
+/** Anything with a scheme is already a URL (`https:`, `file:`, `mailto:`). */
+const HAS_SCHEME = /^[a-zA-Z][a-zA-Z0-9+.-]*:/;
+/** A bare host: `example.com`, `localhost`, `127.0.0.1`, each with an optional port and path. */
+const HOST_LIKE = /^(?:localhost|(?:[a-z0-9-]+\.)+[a-z]{2,}|(?:\d{1,3}\.){3}\d{1,3})(?::\d+)?(?:[/?#].*)?$/i;
+/** Where a search term goes. Google is the reference browser's engine. */
+const SEARCH_ENDPOINT = 'https://www.google.com/search?q=';
+
+/**
+ * What the browser's address bar does with what was typed.
+ *
+ * A scheme, or a bare host (`example.com`, `localhost:3000`, an IP), is a URL. Anything
+ * else - several words, a single word, a phrase with spaces - is a search, the way a
+ * browser's own address bar treats it; the panel used to prefix `https://` to whatever
+ * was typed, so a search term became a broken host.
+ */
+function normaliseUrl(value: string): string {
+	const trimmed = value.trim();
+	if (HAS_SCHEME.test(trimmed)) return trimmed;
+	if (!/\s/.test(trimmed) && HOST_LIKE.test(trimmed)) return `https://${trimmed}`;
+	return `${SEARCH_ENDPOINT}${encodeURIComponent(trimmed)}`;
+}
+
+/** Whether what is in the address bar is a search term, and so can be completed. */
+function isSearchTerm(value: string): boolean {
+	const trimmed = value.trim();
+	return trimmed.length > 1 && !HAS_SCHEME.test(trimmed) && (/\s/.test(trimmed) || !HOST_LIKE.test(trimmed));
+}
+
+/**
+ * The search URL a chosen suggestion opens. A suggestion is a term the engine offered
+ * for a search, so it is always searched, never treated as a host - unlike the typed
+ * text, which the rule above still opens as a URL when it looks like one.
+ */
+function searchUrlFor(term: string): string {
+	return `${SEARCH_ENDPOINT}${encodeURIComponent(term.trim())}`;
+}
