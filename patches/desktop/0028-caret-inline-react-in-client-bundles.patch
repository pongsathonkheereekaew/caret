+/**
+ * Inline React into the client bundles.
+ *
+ * Why: the workbench renderer is a browser ESM context - it cannot resolve a bare specifier at
+ * runtime, and this build leaves every node_modules import external (`packages: 'external'`).
+ * Caret's agent surface imports React directly, so leaving it external makes the whole window
+ * fail to load (`Failed to resolve module specifier "react"`). This is the same treatment
+ * minimist already gets for the bootstrap bundles, and the same shape the reference ships: its
+ * React lives inside the workbench output next to the bundles, not behind a runtime lookup.
+ */
+function inlineReactPlugin(): esbuild.Plugin {
+	const targets: Record<string, string> = {
+		'react': 'node_modules/react/index.js',
+		'react-dom': 'node_modules/react-dom/index.js',
+		'react-dom/client': 'node_modules/react-dom/client.js',
+		// The automatic JSX runtime (tsconfig `jsx: react-jsx`) is a fourth entry point into the
+		// same package, and a browser ESM context cannot resolve it any more than it can `react`.
+		'react/jsx-runtime': 'node_modules/react/jsx-runtime.js',
+		'scheduler': 'node_modules/scheduler/index.js',
+	};
+	return {
+		name: 'inline-react',
+		setup(build) {
+			build.onResolve({ filter: /^(react|react-dom|react-dom\/client|react\/jsx-runtime|scheduler)$/ }, args => {
+				const target = targets[args.path];
+				return target ? { path: path.join(REPO_ROOT, target), external: false } : undefined;
+			});
+		},
+	};
+}
