index 00000000000..e4ff92de8f6
--- /dev/null
+++ b/src/vs/platform/window/electron-main/cediaAgentChrome.ts
@@ -0,0 +1,28 @@
+/*---------------------------------------------------------------------------------------------
+ *  Cedia Agent Window's native macOS chrome geometry.
+ *--------------------------------------------------------------------------------------------*/
+
+import type { BrowserWindow } from 'electron';
+
+/** Keep this paired with Synara's desktopChrome.ts header geometry. */
+export const CEDIA_AGENT_HEADER_HEIGHT_PX = 46;
+export const CEDIA_AGENT_TRAFFIC_LIGHT_INSET_X_PX = 16;
+export const CEDIA_AGENT_TRAFFIC_LIGHT_DOT_RADIUS_PX = 7;
+
+export function resolveCediaAgentTrafficLightPosition(zoomFactor: number): { x: number; y: number } {
+	const safeZoom = typeof zoomFactor === 'number' && Number.isFinite(zoomFactor) && zoomFactor > 0 ? zoomFactor : 1;
+	return {
+		x: CEDIA_AGENT_TRAFFIC_LIGHT_INSET_X_PX,
+		y: Math.round((CEDIA_AGENT_HEADER_HEIGHT_PX * safeZoom) / 2 - CEDIA_AGENT_TRAFFIC_LIGHT_DOT_RADIUS_PX),
+	};
+}
+
+/** Electron exposes this only on macOS builds; keep the call optional for other shells. */
+export function applyCediaAgentTrafficLightPosition(window: BrowserWindow, zoomFactor: number): void {
+	const setWindowButtonPosition = (window as BrowserWindow & {
+		setWindowButtonPosition?: (position: { x: number; y: number }) => void;
+	}).setWindowButtonPosition;
+	if (typeof setWindowButtonPosition === 'function') {
+		setWindowButtonPosition.call(window, resolveCediaAgentTrafficLightPosition(zoomFactor));
+	}
+}
