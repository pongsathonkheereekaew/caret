@@ -0,0 +1,245 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Caret. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { $, addDisposableListener, append, EventType } from '../../../../base/browser/dom.js';
+import { Action, IAction } from '../../../../base/common/actions.js';
+import { Codicon } from '../../../../base/common/codicons.js';
+import { toDisposable, Disposable } from '../../../../base/common/lifecycle.js';
+import { localize } from '../../../../nls.js';
+import { ICommandService } from '../../../../platform/commands/common/commands.js';
+import { IContextMenuService } from '../../../../platform/contextview/browser/contextView.js';
+import { INotificationService } from '../../../../platform/notification/common/notification.js';
+import { IWorkspaceContextService } from '../../../../platform/workspace/common/workspace.js';
+import { OPEN_CUSTOMIZATIONS_COMMAND_ID } from '../../../common/customizations.js';
+import { ICustomViewService } from '../../../services/customView/browser/customViewService.js';
+import { NEW_SESSION_ACTION_ID } from '../../chat/common/constants.js';
+import { AUTOMATIONS_CUSTOM_VIEW_ID } from '../../sessions/browser/automationsConstants.js';
+import { IAgentHomeNavHandle, IAgentHomeNavModel, IAgentHomeNavSection, mountAgentHomeNav } from './agentHomeNavReact.js';
+
+/** Workbench commands the Agent Home navigation uses. All of them already exist. */
+const FIND_SESSIONS_COMMAND_ID = 'sessionsViewPane.find';
+
+/**
+ * Adding a project is Caret's own operation, not the workbench's open-folder command:
+ * the workbench command hands the folder to a window of its own (which is how the
+ * sidebar's "New Project" ended up opening the IDE), while the Caret command registers
+ * the project with the host and gives it a task here, which is what puts it in this
+ * sidebar.
+ */
+const ADD_PROJECT_COMMAND_ID = 'caret.project.add';
+
+/** The filter toggle is a disclosure rather than a command, so it has its own id. */
+const FILTER_TOGGLE_ID = 'filter';
+
+/**
+ * The Caret extension's project commands. A sidebar row is a workspace folder, while
+ * pin/rename/archive live on the host's project record, so every action carries the folder
+ * path and the extension resolves the project that owns it (`resolveHostProject` in
+ * apps/macos/src/extension.ts).
+ */
+const CARET_PROJECT_COMMANDS = {
+	pin: 'caret.project.setPinned',
+	edit: 'caret.project.rename',
+	reveal: 'caret.project.reveal',
+	worktree: 'caret.project.createWorktree',
+	archiveChats: 'caret.project.archiveChats',
+	remove: 'caret.project.remove',
+} as const;
+
+/**
+ * The Agent Home navigation of the reference sidebar.
+ *
+ * Four full-width rows, a Projects section and a Repositories section - the
+ * sidebar the reference capture shows and nothing more. Every row runs a command
+ * Caret already registers; nothing here is a placeholder. Repository and project
+ * rows come from the open workspace folders, never from names copied out of a
+ * screenshot.
+ *
+ * The reference sidebar has no Getting Started card and no profile/settings row
+ * below the sections, so neither is rendered here.
+ *
+ * This class is the model: which rows exist, what each one runs, whether the repository
+ * filter is open, and which repositories the filter currently hides. `agentHomeNavReact.ts`
+ * renders that model and nothing else.
+ */
+export class AgentHomeNav extends Disposable {
+
+	readonly domNode: HTMLElement;
+
+	private readonly view: IAgentHomeNavHandle;
+	/** Every rendered control that runs something, by the id the React surface reports. */
+	private readonly runs = new Map<string, () => void>();
+	private filter = { open: false, query: '' };
+
+	constructor(
+		parent: HTMLElement,
+		@ICommandService private readonly commandService: ICommandService,
+		@IContextMenuService private readonly contextMenuService: IContextMenuService,
+		@INotificationService private readonly notificationService: INotificationService,
+		@ICustomViewService private readonly customViewService: ICustomViewService,
+		@IWorkspaceContextService private readonly workspaceService: IWorkspaceContextService,
+	) {
+		super();
+
+		this.domNode = append(parent, $('.caret-agent-home-nav'));
+		this.view = mountAgentHomeNav(this.domNode, this.buildModel(), {
+			onRow: id => this.runs.get(id)?.(),
+			onAction: id => id === FILTER_TOGGLE_ID ? this.toggleFilter() : this.runs.get(id)?.(),
+			// The filter narrows rows rather than dropping them, so re-rendering from the query is
+			// the whole of its behaviour.
+			onFilterInput: (_sectionId, query) => {
+				this.filter = { ...this.filter, query };
+				this.render();
+			},
+		});
+		this._register(toDisposable(() => this.view.dispose()));
+	}
+
+	private toggleFilter(): void {
+		this.filter = this.filter.open ? { open: false, query: '' } : { open: true, query: this.filter.query };
+		this.render();
+	}
+
+	private render(): void {
+		this.view.update(this.buildModel());
+	}
+
+	private buildModel(): IAgentHomeNavModel {
+		this.runs.clear();
+		const command = (id: string, run: () => void): string => {
+			this.runs.set(id, run);
+			return id;
+		};
+
+		const rows = [
+			{ id: command('newChat', () => void this.commandService.executeCommand(NEW_SESSION_ACTION_ID)), label: localize('caret.nav.newChat', "New Chat"), iconId: Codicon.commentDiscussion.id, selected: true },
+			{ id: command('search', () => void this.commandService.executeCommand(FIND_SESSIONS_COMMAND_ID)), label: localize('caret.nav.search', "Search"), iconId: Codicon.search.id, selected: false },
+			{ id: command('automations', () => this.customViewService.showCustomView(AUTOMATIONS_CUSTOM_VIEW_ID)), label: localize('caret.nav.automations', "Automations"), iconId: Codicon.clock.id, selected: false },
+			{ id: command('customize', () => void this.commandService.executeCommand(OPEN_CUSTOMIZATIONS_COMMAND_ID)), label: localize('caret.nav.customize', "Customize"), iconId: Codicon.tools.id, selected: false },
+		];
+
+		// Projects: the reference's Projects section is its header with the `+ New Project`
+		// action and nothing else - the projects themselves are the workspace groups the
+		// session list stacks below this navigation, which is why listing them here again
+		// (and listing the window's workspace folders under a project heading) was not the
+		// reference. Adding one is still the header action.
+		const projects: IAgentHomeNavSection = {
+			id: 'projects',
+			title: localize('caret.nav.projects', "Projects"),
+			actions: [{
+				id: command('newProject', () => void this.commandService.executeCommand(ADD_PROJECT_COMMAND_ID)),
+				label: localize('caret.nav.newProject', "New Project"),
+				iconId: Codicon.add.id,
+			}],
+			entries: [],
+		};
+
+		// Repositories: the open workspace folders are the repositories this window can
+		// actually see, so each row is real data, and the filter narrows exactly those
+		// rows rather than a decorative control.
+		const folders = this.workspaceService.getWorkspace().folders;
+		const needle = this.filter.query.trim().toLowerCase();
+		const entries = folders.map(folder => ({
+			label: folder.name,
+			iconId: Codicon.repo.id,
+			hidden: needle.length > 0 && !folder.name.toLowerCase().includes(needle),
+		}));
+		const repositories: IAgentHomeNavSection = {
+			id: 'repositories',
+			title: localize('caret.nav.repositories', "Repositories"),
+			actions: [
+				{
+					id: FILTER_TOGGLE_ID,
+					label: localize('caret.nav.filterRepositories', "Filter Repositories"),
+					iconId: Codicon.filter.id,
+					expanded: this.filter.open,
+				},
+				{
+					id: command('addRepository', () => void this.commandService.executeCommand(ADD_PROJECT_COMMAND_ID)),
+					label: localize('caret.nav.addRepository', "Add Repository"),
+					iconId: Codicon.add.id,
+				},
+			],
+			filter: {
+				label: localize('caret.nav.filterRepositories', "Filter Repositories"),
+				placeholder: localize('caret.nav.filterPlaceholder', "Filter repositories"),
+				open: this.filter.open,
+				query: this.filter.query,
+			},
+			entries,
+			empty: folders.length === 0 ? localize('caret.nav.noRepository', "No repository open") : undefined,
+			filterEmpty: folders.length > 0 ? {
+				label: localize('caret.nav.noRepositoryMatch', "No matching repository"),
+				hidden: !(needle.length > 0 && entries.every(entry => entry.hidden)),
+			} : undefined,
+		};
+
+		return { rows, sections: [projects, repositories] };
+	}
+
+	/**
+	 * The reference's project menu on the sessions list's project groups, in its order:
+	 * Pin, Edit, Reveal, Create permanent worktree, Archive chats, Remove project.
+	 *
+	 * These rows are the projects the reference stacks below the navigation, so this is
+	 * where the menu belongs; the navigation's Projects section is a header and its
+	 * action.
+	 *
+	 * Every entry is a real operation. Pin / Edit / Archive chats / Remove project reach the
+	 * host's project record through the Caret extension (the only side that owns that
+	 * connection); Reveal runs the workbench's own reveal command; Create worktree starts a
+	 * worktree task, which is the real worktree Caret creates today.
+	 *
+	 * The rows are drawn by the sessions view, one per workspace, and the base section id is
+	 * the only project identity they carry here. The listener is delegated from the sidebar
+	 * container so it works for rows that are recycled as the list scrolls, and the row's
+	 * label travels as the hint: the extension matches a project by path first and by a
+	 * unique name second, and refuses to guess when two projects share a name.
+	 */
+	attachSessionsListMenu(sidebar: HTMLElement): void {
+		this._register(addDisposableListener(sidebar, EventType.CONTEXT_MENU, (event: MouseEvent) => {
+			const target = event.target as HTMLElement | null;
+			const section = target?.closest?.('.session-section');
+			if (!section) {
+				return;
+			}
+			const label = section.querySelector('.session-section-label')?.textContent?.trim();
+			if (!label) {
+				return;
+			}
+			// Automation and status sections are not projects.
+			if (!section.querySelector('.session-section-icon.codicon-folder')) {
+				return;
+			}
+			event.preventDefault();
+			event.stopPropagation();
+			const anchor = { x: event.clientX, y: event.clientY };
+			this.contextMenuService.showContextMenu({
+				getAnchor: () => anchor,
+				getActions: () => this.projectMenuActions(label),
+				getActionsContext: () => label,
+			});
+		}, true));
+	}
+
+	private projectMenuActions(hint: string): IAction[] {
+		// The Caret extension owns these commands, so a window without that extension would
+		// otherwise show a menu whose entries quietly do nothing.
+		const action = (commandId: string, label: string): IAction => new Action(commandId, label, undefined, true, () => {
+			void Promise.resolve(this.commandService.executeCommand(commandId, hint)).catch((error: unknown) => {
+				this.notificationService.warn(localize('caret.project.actionFailed', "Caret could not run '{0}': {1}", label, error instanceof Error ? error.message : String(error)));
+			});
+		});
+		return [
+			action(CARET_PROJECT_COMMANDS.pin, localize('caret.project.pin', "Pin Project")),
+			action(CARET_PROJECT_COMMANDS.edit, localize('caret.project.edit', "Edit Project...")),
+			action(CARET_PROJECT_COMMANDS.reveal, localize('caret.project.reveal', "Reveal in Finder")),
+			action(CARET_PROJECT_COMMANDS.worktree, localize('caret.project.worktree', "Create Permanent Worktree")),
+			action(CARET_PROJECT_COMMANDS.archiveChats, localize('caret.project.archiveChats', "Archive Chats")),
+			action(CARET_PROJECT_COMMANDS.remove, localize('caret.project.remove', "Remove Project")),
+		];
+	}
+
+}
