+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Caret. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import './media/agentHomeNav.css';
+import { mainWindow } from '../../../../base/browser/window.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { IContextKeyService } from '../../../../platform/contextkey/common/contextkey.js';
+import { IInstantiationService } from '../../../../platform/instantiation/common/instantiation.js';
+import { registerWorkbenchContribution2, WorkbenchPhase, IWorkbenchContribution } from '../../../../workbench/common/contributions.js';
+import { IsSessionsWindowContext } from '../../../../workbench/common/contextkeys.js';
+import { IWorkbenchLayoutService, Parts } from '../../../../workbench/services/layout/browser/layoutService.js';
+import { AgentHomeNav } from './agentHomeNav.js';
+
+/**
+ * Shares of the reference Agent Home layout, measured from the reference capture
+ * (docs/caret-ui-reference-baseline.json): sidebar 15.625%, centre 61.865%, right
+ * utility 22.51%. Both outer columns are shares rather than fixed pixels so the
+ * window keeps the reference proportions at any width - the reference capture is a
+ * 2x capture of a 1024-wide window, where 15.625% lands on the measured 320 captured
+ * pixels for the sidebar divider and 22.51% puts the utility divider at the measured
+ * 1587. This runs after the utility contribution, so it also replaces that
+ * contribution's fixed 255px sidebar with the reference share.
+ */
+const REFERENCE_SIDEBAR_SHARE = 0.15625;
+const REFERENCE_UTILITY_SHARE = 0.2251;
+
+/**
+ * The Agent Home navigation and the reference three-column proportions.
+ *
+ * The sidebar of the Agents Window is a session tree with a small New Chat pill, so
+ * this contribution mounts the reference navigation above it and takes the obsolete
+ * controls out of the DOM. Everything is gated to the Sessions workbench, so the IDE
+ * sidebar and title bar keep their own behaviour.
+ */
+class AgentHomeNavContribution extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.caret.agentHomeNav';
+
+	constructor(
+		@IContextKeyService contextKeyService: IContextKeyService,
+		@IWorkbenchLayoutService private readonly layoutService: IWorkbenchLayoutService,
+		@IInstantiationService private readonly instantiationService: IInstantiationService,
+	) {
+		super();
+
+		if (!IsSessionsWindowContext.getValue(contextKeyService)) {
+			return;
+		}
+
+		this.mountNavigation();
+		this.applyReferenceProportions();
+	}
+
+	private mountNavigation(): void {
+		const sidebar = this.layoutService.getContainer(mainWindow, Parts.SIDEBAR_PART);
+		if (!sidebar) {
+			return;
+		}
+		const content = sidebar.querySelector<HTMLElement>(':scope > .content');
+		if (!content) {
+			return;
+		}
+
+		const nav = this._register(this.instantiationService.createInstance(AgentHomeNav, content));
+		sidebar.classList.add('caret-agent-home-sidebar');
+		// The sessions list inside this sidebar draws its own project groups; the navigation
+		// attaches the project menu to those rows too, so the same right-click works wherever
+		// the project row comes from.
+		nav.attachSessionsListMenu(sidebar);
+
+		// The base sidebar header (a small "New Chat" pill plus filter and find icons)
+		// and the detached "Customizations" footer are replaced by the navigation rows,
+		// so they are taken out of the DOM rather than left mounted behind the new
+		// navigation. Removing them also removes their focus targets and their entries
+		// in the accessibility tree.
+		for (const selector of ['.agent-sessions-header-row', '.agent-sessions-customizations-section']) {
+			sidebar.querySelector(selector)?.remove();
+		}
+	}
+
+	private applyReferenceProportions(): void {
+		const width = this.layoutService.getContainer(mainWindow).clientWidth;
+		if (width <= 0) {
+			return;
+		}
+		this.layoutService.setSize(Parts.SIDEBAR_PART, { width: Math.round(width * REFERENCE_SIDEBAR_SHARE), height: 0 });
+		this.layoutService.setSize(Parts.EDITOR_PART, { width: Math.round(width * REFERENCE_UTILITY_SHARE), height: 0 });
+	}
+}
+
+registerWorkbenchContribution2(AgentHomeNavContribution.ID, AgentHomeNavContribution, WorkbenchPhase.AfterRestored);
