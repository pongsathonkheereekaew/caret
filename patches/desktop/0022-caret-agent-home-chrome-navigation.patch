+++ b/src/vs/sessions/contrib/home/browser/agentHomeNavReact.ts
@@ -0,0 +1,152 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Caret. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { createElement, Fragment, type FunctionComponent, type ReactElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+
+/**
+ * The sidebar navigation as a React surface (R3).
+ *
+ * Same reason as the Apps panel (`appsPanelReact.ts`): the reference's agent window is a React
+ * tree, and Caret's own panes were hand-built DOM, so every wording or ordering change was another
+ * `append` / `classList` edit spread over the pane. Here the pane keeps everything that decides
+ * something - which rows exist, what they run, whether the filter is open, what the repositories
+ * are - and React owns the markup from that model.
+ *
+ * `createElement` rather than JSX: the pinned base's `src/tsconfig.json` sets no `jsx` option, and
+ * turning JSX on for the whole workbench is a separate, reviewable change. The markup keeps the
+ * pane's existing class names, so `media/agentHomeNav.css`, the Caret token layer and the parity
+ * gate see exactly what they saw before.
+ */
+
+/** One full-width navigation row (New Chat, Search, Automations, Customize). */
+export interface IAgentHomeNavRow {
+	readonly id: string;
+	readonly label: string;
+	readonly iconId: string;
+	readonly selected: boolean;
+}
+
+/** A section header's action, which is the only place the reference puts them. */
+export interface IAgentHomeNavAction {
+	readonly id: string;
+	readonly label: string;
+	readonly iconId: string;
+	/** Only the filter toggle is a disclosure, so only it carries `aria-expanded`. */
+	readonly expanded?: boolean;
+}
+
+/** One row inside a section body: a repository the window can actually see. */
+export interface IAgentHomeNavEntry {
+	readonly label: string;
+	readonly iconId: string;
+	/** The repository filter hides rows rather than dropping them, so the filter stays cheap. */
+	readonly hidden: boolean;
+}
+
+export interface IAgentHomeNavFilter {
+	readonly label: string;
+	readonly placeholder: string;
+	readonly open: boolean;
+	readonly query: string;
+}
+
+export interface IAgentHomeNavSection {
+	readonly id: string;
+	readonly title: string;
+	readonly actions: readonly IAgentHomeNavAction[];
+	readonly filter?: IAgentHomeNavFilter;
+	readonly entries: readonly IAgentHomeNavEntry[];
+	/** Shown when the section has no entries at all. */
+	readonly empty?: string;
+	/** The second empty note, shown only while the filter is narrowing the list to nothing. */
+	readonly filterEmpty?: { readonly label: string; readonly hidden: boolean };
+}
+
+export interface IAgentHomeNavModel {
+	readonly rows: readonly IAgentHomeNavRow[];
+	readonly sections: readonly IAgentHomeNavSection[];
+}
+
+export interface IAgentHomeNavHandlers {
+	readonly onRow: (id: string) => void;
+	readonly onAction: (id: string) => void;
+	readonly onFilterInput: (sectionId: string, query: string) => void;
+}
+
+export interface IAgentHomeNavHandle {
+	update(model: IAgentHomeNavModel): void;
+	dispose(): void;
+}
+
+/** The codicon span the pane's CSS expects, without an element factory. */
+function icon(iconId: string, className: string): ReactElement {
+	return createElement('span', { className, 'aria-hidden': 'true' },
+		createElement('span', { className: `codicon codicon-${iconId}` }));
+}
+
+const NavRow: FunctionComponent<{ readonly row: IAgentHomeNavRow; readonly onRow: (id: string) => void }> = ({ row, onRow }) =>
+	createElement('button', {
+		type: 'button',
+		className: row.selected ? 'caret-agent-home-nav-row selected' : 'caret-agent-home-nav-row',
+		'data-caret-nav-id': row.id,
+		'aria-label': row.label,
+		'aria-current': row.selected ? 'page' : undefined,
+		onClick: () => onRow(row.id),
+	},
+		icon(row.iconId, 'caret-agent-home-nav-icon'),
+		createElement('span', { className: 'caret-agent-home-nav-label' }, row.label));
+
+const SectionAction: FunctionComponent<{ readonly action: IAgentHomeNavAction; readonly onAction: (id: string) => void }> = ({ action, onAction }) =>
+	createElement('button', {
+		type: 'button',
+		className: 'caret-agent-home-nav-section-action',
+		'aria-label': action.label,
+		title: action.label,
+		'aria-expanded': action.expanded === undefined ? undefined : String(action.expanded),
+		onClick: () => onAction(action.id),
+	}, createElement('span', { className: `codicon codicon-${action.iconId}` }));
+
+const NavSection: FunctionComponent<{ readonly section: IAgentHomeNavSection; readonly handlers: IAgentHomeNavHandlers }> = ({ section, handlers }) =>
+	createElement('div', { className: 'caret-agent-home-nav-section' },
+		createElement('div', { className: 'caret-agent-home-nav-section-header' },
+			createElement('span', { className: 'caret-agent-home-nav-section-title' }, section.title),
+			section.actions.map(action => createElement(SectionAction, { key: action.id, action, onAction: handlers.onAction }))),
+		section.filter
+			? createElement('input', {
+				className: 'caret-agent-home-nav-filter',
+				type: 'text',
+				hidden: !section.filter.open,
+				placeholder: section.filter.placeholder,
+				'aria-label': section.filter.label,
+				value: section.filter.query,
+				onInput: (event: { currentTarget: { value: string } }) => handlers.onFilterInput(section.id, event.currentTarget.value),
+			})
+			: null,
+		createElement('div', { className: 'caret-agent-home-nav-section-body' },
+			section.entries.map((entry, index) => createElement('div', {
+				key: `${entry.label}-${index}`,
+				className: 'caret-agent-home-nav-entry',
+				hidden: entry.hidden,
+			},
+				icon(entry.iconId, 'caret-agent-home-nav-icon'),
+				createElement('span', { className: 'caret-agent-home-nav-label' }, entry.label))),
+			section.empty ? createElement('div', { className: 'caret-agent-home-nav-empty' }, section.empty) : null,
+			section.filterEmpty ? createElement('div', { className: 'caret-agent-home-nav-empty', hidden: section.filterEmpty.hidden }, section.filterEmpty.label) : null));
+
+const NavView: FunctionComponent<{ readonly model: IAgentHomeNavModel; readonly handlers: IAgentHomeNavHandlers }> = ({ model, handlers }) =>
+	createElement(Fragment, null,
+		model.rows.map(row => createElement(NavRow, { key: row.id, row, onRow: handlers.onRow })),
+		model.sections.map(section => createElement(NavSection, { key: section.id, section, handlers })),
+		createElement('div', { className: 'caret-agent-home-nav-spacer' }));
+
+export function mountAgentHomeNav(host: HTMLElement, model: IAgentHomeNavModel, handlers: IAgentHomeNavHandlers): IAgentHomeNavHandle {
+	const root: Root = createRoot(host);
+	root.render(createElement(NavView, { model, handlers }));
+	return {
+		update: next => root.render(createElement(NavView, { model: next, handlers })),
+		dispose: () => root.unmount(),
+	};
+}
diff --git a/src/vs/sessions/contrib/home/browser/media/agentHomeNav.css b/src/vs/sessions/contrib/home/browser/media/agentHomeNav.css
