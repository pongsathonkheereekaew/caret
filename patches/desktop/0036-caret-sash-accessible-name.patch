 }
 
 export interface IVerticalSashOptions extends ISashOptions {
@@ -439,6 +447,15 @@ export class Sash extends Disposable {
 
 		this.el = append(container, $('.monaco-sash'));
 
+		if (options.ariaLabel) {
+			// A labelled divider is a separator to a screen reader. Unlabelled ones
+			// are left alone so the workbench does not gain unnamed separators in
