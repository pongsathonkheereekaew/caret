@@ -0,0 +1,138 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Cedia. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import './media/cediaModelPicker.css';
+
+import { ThemeIcon } from '../../../../../../../base/common/themables.js';
+import { localize } from '../../../../../../../nls.js';
+import { ActionListItemKind, IActionListItem } from '../../../../../../../platform/actionWidget/browser/actionList.js';
+import { IActionWidgetDropdownAction } from '../../../../../../../platform/actionWidget/browser/actionWidgetDropdown.js';
+import { ILanguageModelChatMetadataAndIdentifier } from '../../../../common/languageModels.js';
+import { getProviderIconForIdentity } from './modelProviderIcons.js';
+
+/**
+ * The Agents window's model control, drawn from Cedia's own option groups.
+ *
+ * Why this exists instead of the base's picker: that picker groups and badges rows by a vendor or a
+ * `modelGroup` identity, and neither can carry the OMP provider - the option-group projection sets
+ * `vendor`/`modelGroup` from the item, but the rows the picker ends up with are the registered
+ * vendor rows (`cedia-omp`), so every row and the whole tab strip collapsed to one label (measured
+ * 2026-09-18/19, `evidence/agents-home-hero-and-provider-marks-2026-09-18/`). Cedia's own items *do*
+ * name the provider (`modelMetadata.vendor`), so this draws them directly: a row per provider with
+ * that provider's mark, its models in the row's submenu, and the model's reasoning ladder as a
+ * sibling row. Rows carry the provider's mark - not the model vendor's - because the question a row
+ * answers is "through which API does this run", which is the one thing the composer cannot otherwise
+ * show.
+ */
+export interface CediaModelPickerGroup {
+	readonly provider: string;
+	readonly models: readonly ILanguageModelChatMetadataAndIdentifier[];
+	readonly selectedIdentifier: string | undefined;
+}
+
+export interface CediaModelPickerReasoning {
+	readonly current: string | undefined;
+	readonly levels: readonly { readonly id: string; readonly name: string }[];
+}
+
+/**
+ * The provider a catalogue row runs through.
+ *
+ * Cedia's extension puts it in the row's `detail` (the one free-form line the workbench draws beside
+ * the name), because neither `vendor` nor `modelGroup` can carry it: the vendor is fixed to the
+ * registering vendor (`cedia-omp`) and the option-group projection's own `vendor` does not survive
+ * to the rows this picker receives. Roles, when OMP has any, follow after a separator.
+ */
+export function cediaProviderOf(model: { readonly metadata: { readonly detail?: string; readonly vendor: string } }): string {
+	const detail = model.metadata.detail?.trim();
+	if (detail) {
+		const [first, ...rest] = detail.split(' · ');
+		return (rest.at(-1) ?? first ?? '').trim();
+	}
+	return model.metadata.vendor;
+}
+
+/** Group Cedia's model items by the provider that runs them, ordered by the name shown. */
+export function cediaModelPickerGroups(
+	models: readonly ILanguageModelChatMetadataAndIdentifier[],
+	selectedIdentifier: string | undefined,
+): CediaModelPickerGroup[] {
+	const byProvider = new Map<string, ILanguageModelChatMetadataAndIdentifier[]>();
+	for (const model of models) {
+		const provider = cediaProviderOf(model);
+		const bucket = byProvider.get(provider);
+		if (bucket) {
+			bucket.push(model);
+		} else {
+			byProvider.set(provider, [model]);
+		}
+	}
+	return [...byProvider.entries()]
+		.map(([provider, models]) => ({
+			provider,
+			models: [...models].sort((left, right) => left.metadata.name.localeCompare(right.metadata.name)),
+			selectedIdentifier,
+		}))
+		.sort((left, right) => left.provider.localeCompare(right.provider));
+}
+
+/**
+ * The picker's items: the model's reasoning ladder first when OMP advertises one, then one section
+ * per provider holding that provider's models.
+ *
+ * A flat, grouped list rather than the platform's flyout submenus: the flyout grew to the height of
+ * the longest provider (OpenRouter carries 528 models) and drew past the window's edges. A single
+ * list with a capped height scrolls instead, and the list's own filter searches every provider at
+ * once - which is what the reference's picker does. The selected model is the checked row, and each
+ * row carries its provider's mark, so "through which API does this run" stays visible after the
+ * section header scrolls away.
+ */
+export function buildCediaModelPickerItems(
+	groups: readonly CediaModelPickerGroup[],
+	reasoning: CediaModelPickerReasoning | undefined,
+	onPickModel: (model: ILanguageModelChatMetadataAndIdentifier) => void,
+	onPickReasoning: (level: { readonly id: string }) => void,
+): IActionListItem<IActionWidgetDropdownAction>[] {
+	const items: IActionListItem<IActionWidgetDropdownAction>[] = [];
+	if (reasoning && reasoning.levels.length > 0) {
+		items.push({ kind: ActionListItemKind.Header, group: { title: localize('cedia.modelPicker.effortSection', "Effort") }, label: localize('cedia.modelPicker.effortSection', "Effort") });
+		for (const level of reasoning.levels) {
+			items.push({
+				item: { id: `cedia.reasoning.${level.id}`, label: level.name, enabled: true, checked: level.id === reasoning.current, class: undefined, tooltip: level.name, run: () => onPickReasoning(level) },
+				kind: ActionListItemKind.Action,
+				label: level.name,
+				group: { title: '', icon: ThemeIcon.fromId(level.id === reasoning.current ? 'check' : 'blank') },
+				hideIcon: false,
+			});
+		}
+	}
+	for (const group of groups) {
+		const icon = getProviderIconForIdentity(group.provider);
+		items.push({
+			kind: ActionListItemKind.Header,
+			group: { title: group.provider, icon },
+			label: group.provider,
+		});
+		for (const model of group.models) {
+			const selected = model.identifier === group.selectedIdentifier;
+			items.push({
+				item: {
+					id: model.identifier,
+					label: model.metadata.name,
+					enabled: true,
+					checked: selected,
+					class: ThemeIcon.asClassName(icon),
+					tooltip: model.metadata.tooltip ?? model.metadata.name,
+					run: () => onPickModel(model),
+				},
+				kind: ActionListItemKind.Action,
+				label: model.metadata.name,
+				group: { title: '', icon: selected ? ThemeIcon.fromId('check') : icon },
+				hideIcon: false,
+			});
+		}
+	}
+	return items;
+}
