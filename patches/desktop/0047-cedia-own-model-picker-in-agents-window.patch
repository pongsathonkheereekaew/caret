+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Cedia. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/* Cedia's Agents-window model picker.
+ *
+ * A fixed height with its own scrollbar, the way the reference picker behaves: OpenRouter alone
+ * carries 528 models, and a list that grows to fit them draws past the window. The height is the
+ * reference's own list height (about 360px) and the width is the reference composer's 320px column
+ * plus room for a provider's mark.
+ */
+.cedia-model-picker-dropdown .monaco-list {
+	max-height: 360px;
+}
+
+/* Provider headings and their rows: the heading names the provider once, every row under it keeps
+ * the provider's mark so the answer survives scrolling. */
+.cedia-model-picker-dropdown .group-header {
+	position: sticky;
+	top: 0;
+	z-index: 1;
+	background: var(--vscode-editorWidget-background);
+}
+
+.cedia-model-picker-dropdown .monaco-list .monaco-list-row {
+	padding-left: 6px;
+}
