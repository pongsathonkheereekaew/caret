+/**
+ * Canonicalize paths whose final file may not exist yet. Native editors can
+ * own an untitled buffer below a symlinked workspace directory, so resolving
+ * only the complete path would incorrectly treat the response as a different
+ * document. Permission and other filesystem errors are propagated deliberately
+ * instead of being converted into a permissive lexical comparison.
+ */
+async function canonicalDocumentPath(inputPath: string): Promise<string> {
+	const lexical = path.resolve(inputPath);
+	let ancestor = lexical;
+	for (;;) {
+		try {
+			const realAncestor = await fs.realpath(ancestor);
+			return path.resolve(realAncestor, path.relative(ancestor, lexical));
+		} catch (error) {
+			if (!isMissingPathError(error)) throw error;
+		}
+		const parent = path.dirname(ancestor);
+		if (parent === ancestor) {
+			throw new Error("Caret native editor path could not resolve an existing ancestor");
+		}
+		ancestor = parent;
+	}
