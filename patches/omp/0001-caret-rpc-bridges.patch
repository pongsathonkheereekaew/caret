diff --git a/packages/coding-agent/test/caret-client-bridge.test.ts b/packages/coding-agent/test/caret-client-bridge.test.ts
new file mode 100644
index 0000000..e53963e
--- /dev/null
+++ b/packages/coding-agent/test/caret-client-bridge.test.ts
@@ -0,0 +1,139 @@
+import { describe, expect, it } from "bun:test";
+import type {
+	ClientBridgePermissionOption,
+	ClientBridgePermissionToolCall,
+} from "@oh-my-pi/pi-coding-agent/session/client-bridge";
+import {
+	CARET_NATIVE_PERMISSION_DEFINITION,
+	createCaretPermissionBridge,
+} from "@oh-my-pi/pi-coding-agent/modes/rpc/caret-client-bridge";
+import { RpcHostToolBridge } from "@oh-my-pi/pi-coding-agent/modes/rpc/host-tools";
+import type { RpcHostToolCallRequest, RpcHostToolCancelRequest } from "@oh-my-pi/pi-coding-agent/modes/rpc/rpc-types";
+
+const toolCall: ClientBridgePermissionToolCall = {
+	toolCallId: "toolu_permission_1",
+	toolName: "bash",
+	title: "Run a command",
+	kind: "execute",
+	status: "pending",
+	rawInput: { command: "echo hello" },
+};
+
+const permissionOptions: ClientBridgePermissionOption[] = [
+	{ optionId: "allow_once", name: "Allow once", kind: "allow_once" },
+	{ optionId: "reject_once", name: "Reject", kind: "reject_once" },
+];
+
+function makeBridge() {
+	const frames: Array<RpcHostToolCallRequest | RpcHostToolCancelRequest> = [];
+	const host = new RpcHostToolBridge(frame => frames.push(frame));
+	const bridge = createCaretPermissionBridge(host, { timeoutMs: 50 });
+	return { bridge, host, frames };
+}
+
+function resultText(outcome: unknown) {
+	return { content: [{ type: "text" as const, text: JSON.stringify(outcome) }] };
+}
+
+function requestFrame(frames: Array<RpcHostToolCallRequest | RpcHostToolCancelRequest>): RpcHostToolCallRequest {
+	const frame = frames[0];
+	if (!frame || frame.type !== "host_tool_call") throw new Error("Expected host_tool_call frame");
+	return frame;
+}
+
+function requestPermission(
+	bridge: ReturnType<typeof createCaretPermissionBridge>,
+	...args: Parameters<NonNullable<ReturnType<typeof createCaretPermissionBridge>["requestPermission"]>>
+) {
+	if (!bridge.requestPermission) throw new Error("Expected permission capability");
+	return bridge.requestPermission(...args);
+}
+
+describe("Caret native permission ClientBridge", () => {
+	it("forwards exact tool call and options through RpcHostToolBridge", async () => {
+		const { bridge, host, frames } = makeBridge();
+		const execution = requestPermission(bridge, toolCall, permissionOptions);
+		const request = requestFrame(frames);
+
+		expect(request.toolName).toBe(CARET_NATIVE_PERMISSION_DEFINITION.name);
+		expect(request.toolCallId).toBe(toolCall.toolCallId);
+		expect(request.arguments).toEqual({ kind: "permission", toolCall, options: permissionOptions });
+		expect(request.arguments.toolCall).not.toBe(toolCall);
+		expect(request.arguments.options).not.toBe(permissionOptions);
+
+		host.handleResult({
+			type: "host_tool_result",
+			id: request.id,
+			result: resultText({ outcome: "selected", optionId: "allow_once", kind: "allow_once" }),
+		});
+
+		await expect(execution).resolves.toEqual({ outcome: "selected", optionId: "allow_once", kind: "allow_once" });
+	});
+
+	it("accepts a structured cancelled outcome", async () => {
+		const { bridge, host, frames } = makeBridge();
+		const execution = requestPermission(bridge, toolCall, permissionOptions);
+		const request = requestFrame(frames);
+
+		host.handleResult({
+			type: "host_tool_result",
+			id: request.id,
+			result: resultText({ outcome: "cancelled" }),
+		});
+
+		await expect(execution).resolves.toEqual({ outcome: "cancelled" });
+	});
+
+	it("sends a host-tool cancel and resolves cancelled when the caller aborts", async () => {
+		const { bridge, frames } = makeBridge();
+		const controller = new AbortController();
+		const execution = requestPermission(bridge, toolCall, permissionOptions, controller.signal);
+		const request = requestFrame(frames);
+
+		controller.abort();
+
+		expect(frames[1]).toMatchObject({ type: "host_tool_cancel", targetId: request.id });
+		await expect(execution).resolves.toEqual({ outcome: "cancelled" });
+	});
+
+	it("fails closed when the host selects an unknown option ID", async () => {
+		const { bridge, host, frames } = makeBridge();
+		const execution = requestPermission(bridge, toolCall, permissionOptions);
+		const request = requestFrame(frames);
+
+		host.handleResult({
+			type: "host_tool_result",
+			id: request.id,
+			result: resultText({ outcome: "selected", optionId: "allow_always", kind: "allow_always" }),
+		});
+
+		await expect(execution).rejects.toThrow(/unknown option ID/);
+	});
+
+	it("fails closed for malformed or mismatched structured outcomes", async () => {
+		const malformed = makeBridge();
+		const malformedExecution = requestPermission(malformed.bridge, toolCall, permissionOptions);
+		const malformedRequest = requestFrame(malformed.frames);
+		malformed.host.handleResult({
+			type: "host_tool_result",
+			id: malformedRequest.id,
+			result: { content: [{ type: "text", text: "allow" }] },
+		});
+		await expect(malformedExecution).rejects.toThrow(/malformed/);
+
+		const mismatched = makeBridge();
+		const mismatchedExecution = requestPermission(mismatched.bridge, toolCall, permissionOptions);
+		const mismatchedRequest = requestFrame(mismatched.frames);
+		mismatched.host.handleResult({
+			type: "host_tool_result",
+			id: mismatchedRequest.id,
+			result: resultText({ outcome: "selected", optionId: "allow_once", kind: "reject_once" }),
+		});
+		await expect(mismatchedExecution).rejects.toThrow(/kind does not match/);
+	});
+
+	it("returns cancelled at the bounded permission deadline", async () => {
+		const { bridge } = makeBridge();
+		await expect(requestPermission(bridge, toolCall, permissionOptions)).resolves.toEqual({ outcome: "cancelled" });
+	});
+});
diff --git a/packages/coding-agent/test/caret-editor-bridge.test.ts b/packages/coding-agent/test/caret-editor-bridge.test.ts
new file mode 100644
index 0000000..87656d8
--- /dev/null
+++ b/packages/coding-agent/test/caret-editor-bridge.test.ts
@@ -0,0 +1,234 @@
+import { describe, expect, it } from "bun:test";
+import * as fs from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+import { RpcHostToolBridge } from "@oh-my-pi/pi-coding-agent/modes/rpc/host-tools";
+import {
+	CARET_NATIVE_EDITOR_DEFINITION,
+	createCaretEditorBridge,
+} from "@oh-my-pi/pi-coding-agent/modes/rpc/caret-client-bridge";
+import type { RpcHostToolCallRequest, RpcHostToolCancelRequest } from "@oh-my-pi/pi-coding-agent/modes/rpc/rpc-types";
+import { removeWithRetries } from "@oh-my-pi/pi-utils";
+
+const document = {
+	handle: { id: "doc-1", uri: "file:///workspace/example.ts" },
+	path: "/workspace/example.ts",
+	text: "unsaved\r\ntext\r\n",
+	documentVersion: 17,
+	sha256: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
+	dirty: true,
+};
+
+function resultText(value: unknown) {
+	return { content: [{ type: "text" as const, text: JSON.stringify(value) }] };
+}
+
+function requestFrame(frames: Array<RpcHostToolCallRequest | RpcHostToolCancelRequest>): RpcHostToolCallRequest {
+	const frame = frames[0];
+	if (!frame || frame.type !== "host_tool_call") throw new Error("Expected host_tool_call frame");
+	return frame;
+}
+
+describe("Caret native editor ClientBridge", () => {
+	it("forwards a snapshot request and preserves dirty text metadata", async () => {
+		const frames: Array<RpcHostToolCallRequest | RpcHostToolCancelRequest> = [];
+		const host = new RpcHostToolBridge(frame => frames.push(frame));
+		const bridge = createCaretEditorBridge(host, { timeoutMs: 100 });
+		if (!bridge.nativeEditor) throw new Error("Expected native editor capability");
+
+		const pending = bridge.nativeEditor.snapshot({ path: document.path });
+		const request = requestFrame(frames);
+		expect(request.toolName).toBe(CARET_NATIVE_EDITOR_DEFINITION.name);
+		expect(request.arguments).toEqual({ kind: "snapshot", path: document.path });
+		host.handleResult({
+			type: "host_tool_result",
+			id: request.id,
+			result: resultText({ document }),
+		});
+
+		expect(await pending).toEqual({ document });
+	});
+
+	it("returns null for a path never owned by the native editor", async () => {
+		const frames: Array<RpcHostToolCallRequest | RpcHostToolCancelRequest> = [];
+		const host = new RpcHostToolBridge(frame => frames.push(frame));
+		const bridge = createCaretEditorBridge(host, { timeoutMs: 100 });
+		if (!bridge.nativeEditor) throw new Error("Expected native editor capability");
+
+		const pending = bridge.nativeEditor.snapshot({ path: "/workspace/headless.txt" });
+		const request = requestFrame(frames);
+		host.handleResult({ type: "host_tool_result", id: request.id, result: resultText({ document: null }) });
+
+		expect(await pending).toEqual({ document: null });
+	});
+
+	it("matches a missing document below a symlinked directory by its canonical ancestor", async () => {
+		const root = await fs.mkdtemp(path.join(os.tmpdir(), "caret-editor-bridge-path-"));
+		try {
+			const realDir = path.join(root, "workspace");
+			const aliasDir = path.join(root, "alias");
+			await fs.mkdir(realDir);
+			await fs.symlink(realDir, aliasDir, "dir");
+			const requestedPath = path.join(aliasDir, "untitled.ts");
+			const responseDocument = { ...document, path: path.join(realDir, "untitled.ts") };
+			const frames: Array<RpcHostToolCallRequest | RpcHostToolCancelRequest> = [];
+			const host = new RpcHostToolBridge(frame => frames.push(frame));
+			const bridge = createCaretEditorBridge(host, { timeoutMs: 100 });
+			if (!bridge.nativeEditor) throw new Error("Expected native editor capability");
+
+			const pending = bridge.nativeEditor.snapshot({ path: requestedPath });
+			const request = requestFrame(frames);
+			host.handleResult({
+				type: "host_tool_result",
+				id: request.id,
+				result: resultText({ document: responseDocument }),
+			});
+
+			expect(await pending).toEqual({ document: responseDocument });
+		} finally {
+			await removeWithRetries(root);
+		}
+	});
+
+	it("forwards an exact guarded apply and requires unsaved/undo-preserved response flags", async () => {
+		const frames: Array<RpcHostToolCallRequest | RpcHostToolCancelRequest> = [];
+		const host = new RpcHostToolBridge(frame => frames.push(frame));
+		const bridge = createCaretEditorBridge(host, { timeoutMs: 100 });
+		if (!bridge.nativeEditor) throw new Error("Expected native editor capability");
+
+		const params = {
+			path: document.path,
+			handle: document.handle,
+			expectedVersion: document.documentVersion,
+			expectedHash: document.sha256,
+			content: "agent\r\ntext\r\n",
+		};
+		const pending = bridge.nativeEditor.apply(params);
+		const request = requestFrame(frames);
+		expect(request.arguments).toEqual({ kind: "apply", ...params });
+		// Host metadata advances after applying while keeping the operation in the
+		// editor's undo stack; the buffer is intentionally not saved to disk.
+		const postDocument = { ...document, text: params.content, documentVersion: 18, dirty: true };
+		host.handleResult({
+			type: "host_tool_result",
+			id: request.id,
+			result: resultText({ text: params.content, document: postDocument, saved: false, undoPreserved: true }),
+		});
+
+		expect(await pending).toEqual({
+			text: params.content,
+			document: postDocument,
+			saved: false,
+			undoPreserved: true,
+		});
+	});
+
+	it("fails closed on malformed metadata instead of returning a disk fallback", async () => {
+		const frames: Array<RpcHostToolCallRequest | RpcHostToolCancelRequest> = [];
+		const host = new RpcHostToolBridge(frame => frames.push(frame));
+		const bridge = createCaretEditorBridge(host, { timeoutMs: 100 });
+		if (!bridge.nativeEditor) throw new Error("Expected native editor capability");
+
+		const pending = bridge.nativeEditor.snapshot({ path: document.path });
+		const request = requestFrame(frames);
+		host.handleResult({
+			type: "host_tool_result",
+			id: request.id,
+			result: resultText({ document: { ...document, sha256: "stale" } }),
+		});
+
+		await expect(pending).rejects.toThrow(/SHA-256/);
+	});
+
+	it("forwards create, delete and move through the hidden host tool", async () => {
+		const frames: Array<RpcHostToolCallRequest | RpcHostToolCancelRequest> = [];
+		const host = new RpcHostToolBridge(frame => frames.push(frame));
+		const bridge = createCaretEditorBridge(host, { timeoutMs: 100 });
+		if (!bridge.nativeEditor?.create || !bridge.nativeEditor.delete || !bridge.nativeEditor.move) {
+			throw new Error("Expected native editor file operations");
+		}
+
+		const created = bridge.nativeEditor.create({ path: document.path, content: "new\n" });
+		const createRequest = requestFrame(frames);
+		expect(createRequest.arguments).toEqual({ kind: "create", path: document.path, content: "new\n" });
+		const createdDocument = { ...document, text: "new\n" };
+		host.handleResult({
+			type: "host_tool_result",
+			id: createRequest.id,
+			result: resultText({ document: createdDocument, saved: false, undoPreserved: true }),
+		});
+		expect(await created).toMatchObject({ saved: false, undoPreserved: true, text: "new\n" });
+
+		frames.length = 0;
+		const deleted = bridge.nativeEditor.delete({
+			path: document.path,
+			handle: document.handle,
+			expectedVersion: document.documentVersion,
+			expectedHash: document.sha256,
+		});
+		const deleteRequest = requestFrame(frames);
+		expect(deleteRequest.arguments).toMatchObject({ kind: "delete", path: document.path });
+		host.handleResult({
+			type: "host_tool_result",
+			id: deleteRequest.id,
+			result: resultText({ deleted: true, path: document.path, uri: document.handle.uri }),
+		});
+		expect(await deleted).toEqual({ deleted: true, path: document.path, uri: document.handle.uri });
+	});
+
+	it("cancels the host request when the caller aborts", async () => {
+		const frames: Array<RpcHostToolCallRequest | RpcHostToolCancelRequest> = [];
+		const host = new RpcHostToolBridge(frame => frames.push(frame));
+		const bridge = createCaretEditorBridge(host, { timeoutMs: 100 });
+		if (!bridge.nativeEditor) throw new Error("Expected native editor capability");
+		const controller = new AbortController();
+
+		const pending = bridge.nativeEditor.snapshot({ path: document.path }, controller.signal);
+		const request = requestFrame(frames);
+		controller.abort();
+
+		expect(frames[1]).toMatchObject({ type: "host_tool_cancel", targetId: request.id });
+		await expect(pending).rejects.toThrow(/aborted/);
+	});
+});
+
+it("forwards guarded disk bases and rejects an unverifiable successful outcome", async () => {
+	const frames: Array<RpcHostToolCallRequest | RpcHostToolCancelRequest> = [];
+	const host = new RpcHostToolBridge(frame => frames.push(frame));
+	const bridge = createCaretEditorBridge(host, { timeoutMs: 100 });
+	const params = {
+		path: "/workspace/a.ts",
+		expectedCanonicalPath: "/workspace/a.ts",
+		expectedText: "old",
+		content: "new",
+	};
+	const pending = bridge.nativeEditor!.applyDisk!(params);
+	const request = requestFrame(frames);
+	expect(request.arguments).toEqual({ kind: "apply_disk", ...params });
+	host.handleResult({
+		type: "host_tool_result",
+		id: request.id,
+		result: resultText({ text: "different", saved: true, canonicalPath: params.expectedCanonicalPath }),
+	});
+	await expect(pending).rejects.toThrow("outcome is unknown");
+});
+
+it("requires explicit guarded disk completion flags", async () => {
+	const frames: Array<RpcHostToolCallRequest | RpcHostToolCancelRequest> = [];
+	const host = new RpcHostToolBridge(frame => frames.push(frame));
+	const bridge = createCaretEditorBridge(host, { timeoutMs: 100 });
+	const params = {
+		path: "/workspace/a.ts",
+		expectedCanonicalPath: "/workspace/a.ts",
+		expectedText: "old",
+		content: "new",
+	};
+	const pending = bridge.nativeEditor!.applyDisk!(params);
+	const request = requestFrame(frames);
+	host.handleResult({
+		type: "host_tool_result",
+		id: request.id,
+		result: resultText({ text: "new", saved: true, canonicalPath: params.expectedCanonicalPath }),
+	});
+	expect(await pending).toEqual({ text: "new", saved: true, canonicalPath: params.expectedCanonicalPath });
+});
diff --git a/packages/coding-agent/test/caret-editor-routing.test.ts b/packages/coding-agent/test/caret-editor-routing.test.ts
new file mode 100644
index 0000000..53e9c85
--- /dev/null
+++ b/packages/coding-agent/test/caret-editor-routing.test.ts
@@ -0,0 +1,676 @@
+import { afterEach, beforeEach, describe, expect, it } from "bun:test";
+import { createHash } from "node:crypto";
+import * as fs from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { EditTool } from "@oh-my-pi/pi-coding-agent/edit";
+import type { ClientBridge, ClientBridgeEditorDocumentSnapshot } from "@oh-my-pi/pi-coding-agent/session/client-bridge";
+import type { ToolSession } from "@oh-my-pi/pi-coding-agent/tools";
+import { ReadTool } from "@oh-my-pi/pi-coding-agent/tools/read";
+import { WriteTool } from "@oh-my-pi/pi-coding-agent/tools/write";
+import { removeWithRetries } from "@oh-my-pi/pi-utils";
+
+const document: ClientBridgeEditorDocumentSnapshot = {
+	handle: { id: "doc-1", uri: "file:///workspace/dirty.ts" },
+	path: "/workspace/dirty.ts",
+	text: "export const source = 'unsaved';\r\n",
+	documentVersion: 4,
+	sha256: createHash("sha256").update("export const source = 'unsaved';\r\n").digest("hex"),
+	dirty: true,
+};
+
+function outputText(result: { content: Array<{ type: string; text?: string }> }): string {
+	return result.content
+		.filter(content => content.type === "text")
+		.map(content => content.text ?? "")
+		.join("\n");
+}
+
+function documentFor(pathname: string, text = document.text, documentVersion = document.documentVersion) {
+	return {
+		...document,
+		path: pathname,
+		text,
+		documentVersion,
+		sha256: createHash("sha256").update(text).digest("hex"),
+	};
+}
+
+function createSession(cwd: string, bridge: ClientBridge): ToolSession {
+	return {
+		cwd,
+		hasUI: false,
+		getSessionFile: () => path.join(cwd, "session.jsonl"),
+		getSessionSpawns: () => "*",
+		getArtifactsDir: () => path.join(cwd, "artifacts"),
+		allocateOutputArtifact: async () => ({ id: "artifact-1", path: path.join(cwd, "artifact-1.log") }),
+		settings: Settings.isolated(),
+		getClientBridge: () => bridge,
+	} as ToolSession;
+}
+
+describe("Caret native editor read routing", () => {
+	let tmpDir: string;
+
+	beforeEach(async () => {
+		tmpDir = await fs.mkdtemp(path.join(os.tmpdir(), "caret-editor-routing-"));
+		await Bun.write(path.join(tmpDir, "dirty.ts"), "export const source = 'disk';\n");
+	});
+
+	afterEach(async () => {
+		await removeWithRetries(tmpDir);
+	});
+
+	it("reads unsaved native text even when the disk file is stale", async () => {
+		const requested: string[] = [];
+		const bridge: ClientBridge = {
+			capabilities: { nativeEditor: true },
+			nativeEditor: {
+				snapshot: async ({ path: target }) => {
+					requested.push(target);
+					return { document };
+				},
+				apply: async () => {
+					throw new Error("not used");
+				},
+			},
+		};
+
+		const result = await new ReadTool(createSession(tmpDir, bridge)).execute("read", {
+			path: path.join(tmpDir, "dirty.ts"),
+		});
+		const text = outputText(result);
+
+		expect(requested).toEqual([path.join(tmpDir, "dirty.ts")]);
+		expect(text).toContain("unsaved");
+		expect(text).not.toContain("disk");
+	});
+
+	it("reads a native-only unsaved file that does not exist on disk", async () => {
+		const missingPath = path.join(tmpDir, "new.ts");
+		const bridge: ClientBridge = {
+			capabilities: { nativeEditor: true },
+			nativeEditor: {
+				snapshot: async () => ({ document: { ...document, path: missingPath } }),
+				apply: async () => {
+					throw new Error("not used");
+				},
+			},
+		};
+
+		const result = await new ReadTool(createSession(tmpDir, bridge)).execute("read", { path: missingPath });
+		expect(outputText(result)).toContain("unsaved");
+	});
+
+	it("does not fall back to disk when the native snapshot transport fails", async () => {
+		const bridge: ClientBridge = {
+			capabilities: { nativeEditor: true },
+			nativeEditor: {
+				snapshot: async () => {
+					throw new Error("native editor disconnected");
+				},
+				apply: async () => {
+					throw new Error("not used");
+				},
+			},
+		};
+
+		await expect(
+			new ReadTool(createSession(tmpDir, bridge)).execute("read", { path: path.join(tmpDir, "dirty.ts") }),
+		).rejects.toThrow("native editor disconnected");
+	});
+
+	it("routes a whole-file write through the native guarded apply and leaves disk untouched", async () => {
+		const target = path.join(tmpDir, "dirty.ts");
+		const editorDocument = documentFor(target);
+		const snapshots: string[] = [];
+		const applied: Array<{
+			path: string;
+			handle: { id: string; uri: string };
+			content: string;
+			expectedVersion: number;
