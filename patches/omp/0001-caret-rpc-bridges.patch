index 0000000..a02ab25
--- /dev/null
+++ b/packages/coding-agent/src/tools/native-editor-observations.ts
@@ -0,0 +1,114 @@
+import { realpathSync } from "node:fs";
+import * as path from "node:path";
+import type { ClientBridgeEditorDocumentSnapshot } from "../session/client-bridge";
+import type { ToolSession } from "../tools";
+
+/**
+ * A session-local bound on native editor observations. The map is deliberately
+ * weakly keyed by ToolSession so a finished OMP session cannot keep editor
+ * buffers alive. A native write may only use an observation recorded by a
+ * successful, model-visible read (or by a confirmed native apply).
+ */
+export const NATIVE_EDITOR_OBSERVATION_CAPACITY = 8192;
+
+type Observation = ClientBridgeEditorDocumentSnapshot;
+const observations = new WeakMap<object, Map<string, Observation>>();
+const observationBytes = new WeakMap<object, number>();
+const MAX_OBSERVATION_BYTES = 32 * 1024 * 1024;
+const sizeOf = (document: Observation | undefined): number =>
+	document ? Buffer.byteLength(JSON.stringify(document)) : 0;
+
+function isMissingPathError(error: unknown): boolean {
+	return (
+		!!error &&
+		typeof error === "object" &&
+		"code" in error &&
+		((error as { code?: unknown }).code === "ENOENT" || (error as { code?: unknown }).code === "ENOTDIR")
+	);
+}
+
+/**
+ * Resolve a path using the deepest existing ancestor. Native editor snapshots
+ * can describe an untitled/missing file below a symlinked workspace directory;
+ * resolving only the complete path would lose that alias. Permission and
+ * malformed-path errors are intentionally propagated so a caller cannot
+ * silently fall back to disk with an uncertain identity.
+ */
+export function canonicalNativeEditorPath(inputPath: string): string {
+	const lexical = path.resolve(inputPath);
+	let ancestor = lexical;
+	for (;;) {
+		try {
+			const realAncestor = realpathSync.native(ancestor);
+			return path.resolve(realAncestor, path.relative(ancestor, lexical));
+		} catch (error) {
+			if (!isMissingPathError(error)) throw error;
+		}
+		const parent = path.dirname(ancestor);
+		if (parent === ancestor) {
+			// The filesystem root should always be resolvable. Keep the lexical path
+			// only for unusual test sandboxes where even root lookup is unavailable.
+			return lexical;
+		}
+		ancestor = parent;
+	}
+}
+
+function cloneObservation(document: ClientBridgeEditorDocumentSnapshot): Observation {
+	return {
+		handle: { id: document.handle.id, uri: document.handle.uri },
+		path: document.path,
+		text: document.text,
+		documentVersion: document.documentVersion,
+		sha256: document.sha256,
+		dirty: document.dirty,
+	};
+}
+
+function getObservationMap(session: ToolSession): Map<string, Observation> {
+	let map = observations.get(session);
+	if (!map) {
+		map = new Map<string, Observation>();
+		observations.set(session, map);
+	}
+	return map;
+}
+
+/**
+ * Record the exact snapshot that was exposed to the model. `targetPath` is
+ * used as the identity key because test/embedding bridges may return a URI
+ * spelling for `document.path`; the document metadata itself remains intact
+ * for the guarded apply. Existing entries are replaced in place so a write
+ * sequence can advance its observed version without consuming capacity.
+ */
+export function recordNativeEditorObservation(
+	session: ToolSession,
+	targetPath: string,
+	document: ClientBridgeEditorDocumentSnapshot,
+): void {
+	const map = getObservationMap(session);
+	const key = canonicalNativeEditorPath(targetPath);
+	if (!map.has(key) && map.size >= NATIVE_EDITOR_OBSERVATION_CAPACITY) {
+		throw new Error("Native editor observation capacity reached; read fewer open documents before retrying");
+	}
+	const nextBytes = (observationBytes.get(session) ?? 0) - sizeOf(map.get(key)) + sizeOf(document);
+	if (nextBytes > MAX_OBSERVATION_BYTES) throw new Error("Native editor observation byte capacity reached");
+	map.set(key, cloneObservation(document));
+	observationBytes.set(session, nextBytes);
+}
+
+/** Return the last successful model-visible snapshot for `targetPath`. */
+export function getNativeEditorObservation(
+	session: ToolSession,
+	targetPath: string,
+): ClientBridgeEditorDocumentSnapshot | undefined {
+	const map = observations.get(session);
+	const document = map?.get(canonicalNativeEditorPath(targetPath));
+	return document ? cloneObservation(document) : undefined;
+}
+
+/** Clear observations for an explicit session teardown or test fixture. */
+export function clearNativeEditorObservations(session: ToolSession): void {
+	observations.delete(session);
+	observationBytes.delete(session);
+}
