+		for (const widget of this.#widgetsAbove.values()) this.#surface.addChild(widget);
+		if (this.#editor) this.#surface.addChild(this.#editor);
+		for (const component of this.#customComponents) this.#surface.addChild(component);
+		for (const widget of this.#widgetsBelow.values()) this.#surface.addChild(widget);
+		if (this.#footer) this.#surface.addChild(this.#footer);
+		this.tui.requestRender(true);
+	}
