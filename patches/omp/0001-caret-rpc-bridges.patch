+	ClientBridgeEditorDocumentSnapshot,
+	ClientBridgeEditorSnapshotResponse,
+	ClientBridgeNativeEditor,
+	ClientBridgePermissionOption,
+	ClientBridgePermissionOutcome,
+	ClientBridgePermissionToolCall,
+} from "../../session/client-bridge";
+import { RpcHostToolBridge } from "./host-tools";
+import type { RpcHostToolDefinition } from "./rpc-types";
+
+/** Maximum time a native permission prompt may wait for the embedding host. */
+export const CARET_NATIVE_PERMISSION_TIMEOUT_MS = 120_000;
+
+/** Maximum time a native editor snapshot/apply may wait for the host. */
+export const CARET_NATIVE_EDITOR_TIMEOUT_MS = 120_000;
+
+/**
+ * Internal host-tool definition used only by Caret's RPC dispatcher.
+ *
+ * Keep this out of `set_host_tools`: exposing it to the model would create a
+ * second permission/tool surface instead of routing OMP's own permission gate
+ * through the host.
+ */
+export const CARET_NATIVE_PERMISSION_DEFINITION: RpcHostToolDefinition = {
+	name: "caret_native_permission",
+	label: "Caret native permission",
+	description: "Internal Caret permission bridge; not a model-facing tool.",
+	hidden: true,
+	parameters: {
+		type: "object",
+		properties: {
+			kind: { const: "permission" },
+			toolCall: { type: "object" },
+			options: { type: "array", items: { type: "object" } },
+		},
+		required: ["kind", "toolCall", "options"],
+		additionalProperties: false,
+	},
+};
+
+/**
+ * Internal host-tool definition for the native editor facade. This is kept
+ * distinct from ACP's unversioned fs/read_text_file and fs/write_text_file
