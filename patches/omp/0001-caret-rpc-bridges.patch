+
+async function parseEditorMoveResponse(
+	result: unknown,
+	destination: string,
+): Promise<ClientBridgeEditorApplyResponse> {
+	const parsed = textOutcome(result);
+	if (!isRecord(parsed)) throw new Error("Caret native editor response was malformed: expected an object");
+	if (parsed.saved !== false) {
+		throw new Error("Caret native editor response was malformed: move.saved must be false");
+	}
