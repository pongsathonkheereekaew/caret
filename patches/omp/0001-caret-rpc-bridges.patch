+function documentSnapshot(value: unknown): ClientBridgeEditorDocumentSnapshot {
+	if (!isRecord(value)) {
+		throw new Error("Caret native editor response was malformed: document must be an object or null");
+	}
+	if (!isRecord(value.handle)) {
+		throw new Error("Caret native editor response was malformed: document.handle must be an object");
+	}
+	const handle = {
+		id: nonEmptyString(value.handle.id, "document.handle.id"),
+		uri: nonEmptyString(value.handle.uri, "document.handle.uri"),
+	};
+	const documentVersion = value.documentVersion;
+	if (typeof documentVersion !== "number" || !Number.isSafeInteger(documentVersion) || documentVersion < 0) {
+		throw new Error(
+			"Caret native editor response was malformed: document.documentVersion must be a non-negative integer",
+		);
+	}
+	if (typeof value.text !== "string") {
+		throw new Error("Caret native editor response was malformed: document.text must be a string");
+	}
+	if (typeof value.dirty !== "boolean") {
+		throw new Error("Caret native editor response was malformed: document.dirty must be a boolean");
+	}
