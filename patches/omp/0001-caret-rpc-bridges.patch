+		const previous = this.#widgetsAbove.get(key) ?? this.#widgetsBelow.get(key);
+		if (previous) {
+			previous.dispose?.();
+			this.#widgetsAbove.delete(key);
+			this.#widgetsBelow.delete(key);
+		}
+		if (content === undefined) {
+			this.#rebuildSurface();
+			return;
+		}
