+/**
+ * Caret's native-client bridge for OMP RPC mode.
+ *
+ * This bridge is intentionally narrow: OMP keeps ownership of the agent loop
+ * and asks the embedding host for a structured permission decision through the
+ * existing host-tool transport.  The internal tool definition is never handed
+ * to the model/tool registry; the host dispatcher registers it directly.
+ */
+import * as fs from "node:fs/promises";
+import * as path from "node:path";
+import type {
+	ClientBridge,
+	ClientBridgeEditorApplyParams,
