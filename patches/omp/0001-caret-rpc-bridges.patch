+const text = (result: unknown) => JSON.stringify(result);
+
+test("AST glob discovers dirty-only matches and uses guarded apply without saving", async () => {
+	const a = join(dir, "a.ts"),
+		b = join(dir, "b.ts");
+	await writeFile(a, "diskOnly();\n");
+	await writeFile(b, "untouched();\n");
+	const f = fixture([doc(a, "oldCall('dirty');\n"), doc(b, "untouched();\n")]);
+	expect(text(await f.preview())).toContain("oldCall");
+	expect(f.snapshots).toContain(a);
+	expect(f.snapshots).toContain(b);
+	expect(getNativeEditorObservation(f.session, a)).toBeUndefined();
+	expect(text(await f.apply())).toContain("Applied 1 replacement");
+	expect(f.applied).toEqual([a]);
+	expect(f.documents.get(a)!.text).toBe("newCall('dirty');\n");
+	expect(await readFile(a, "utf8")).toBe("diskOnly();\n");
+	expect(getNativeEditorObservation(f.session, a)?.documentVersion).toBe(2);
+});
+
+test("later stale file with same replacement count prevents all AST writes", async () => {
