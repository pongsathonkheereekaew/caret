+		(placement === "belowEditor" ? this.#widgetsBelow : this.#widgetsAbove).set(key, component);
+		this.#rebuildSurface();
+	}
+
+	#createWidget(content: ExtensionWidgetContent): MountedComponent {
+		if (Array.isArray(content)) {
+			const container = new Container();
+			for (const line of content.slice(0, 10)) container.addChild(new Text(line, 1, 0));
+			if (content.length > 10) container.addChild(new Text("... (widget truncated)", 1, 0));
+			return container;
+		}
+		if (content === undefined) throw new Error("Widget content missing");
+		return content(this.tui, theme);
+	}
+
+	setHeader(factory: ExtensionUiComponentFactory | undefined): void {
+		this.#assertActive();
+		if (this.#delegate) {
+			this.#delegate.setHeader(factory);
+			return;
+		}
+		this.#header?.dispose?.();
+		this.#header = factory?.(this.tui, theme);
+		this.#rebuildSurface();
+	}
+
+	setFooter(factory: ExtensionUiComponentFactory | undefined): void {
+		this.#assertActive();
+		if (this.#delegate) {
+			this.#delegate.setFooter(factory);
+			return;
+		}
+		this.#footer?.dispose?.();
+		this.#footer = factory?.(this.tui, theme);
+		this.#rebuildSurface();
+	}
+
+	onTerminalInput(handler: TerminalInputHandler): () => void {
+		this.#assertActive();
+		if (this.#delegate) return this.#delegate.onTerminalInput(handler);
+		const unsubscribe = this.tui.addInputListener(handler);
+		this.#inputUnsubscribers.add(unsubscribe);
+		return () => {
+			unsubscribe();
+			this.#inputUnsubscribers.delete(unsubscribe);
+		};
+	}
+
+	sendInput(data: string): void {
+		this.#assertActive();
+		this.terminal.sendInput(data);
+	}
+
+	resize(columns: number, rows: number): void {
+		this.#assertActive();
+		this.terminal.resize(columns, rows);
+	}
+
+	setEditorText(text: string): void {
+		this.#assertActive();
+		if (this.#delegate) {
+			this.#delegate.setEditorText(text);
+			return;
+		}
+		this.#editorText = text;
+		if (!this.#editor) this.setEditorComponent(undefined);
+		this.#editor!.setText(text);
+		this.tui.requestRender(true);
+	}
+
+	pasteToEditor(text: string): void {
+		this.#assertActive();
+		if (this.#delegate) {
+			this.#delegate.pasteToEditor(text);
+			return;
+		}
+		if (!this.#editor) this.setEditorComponent(undefined);
+		this.#editor!.pasteText(text);
+		this.#editorText = this.#editor!.getText();
+		this.tui.requestRender(true);
+	}
+
+	getEditorText(): string {
+		if (this.#delegate) return this.#delegate.getEditorText();
+		return this.#editor?.getText() ?? this.#editorText;
+	}
+
+	setEditorComponent(
+		factory: ((tui: TUI, editorTheme: EditorTheme, keybindings: KeybindingsManager) => CustomEditor) | undefined,
+	): void {
+		this.#assertActive();
+		if (this.#delegate) {
+			this.#delegate.setEditorComponent(factory);
+			return;
+		}
+		this.#editorText = this.getEditorText();
+		this.#editor?.dispose?.();
+		this.#editor = factory
+			? factory(this.tui, getEditorTheme(), KeybindingsManager.inMemory())
+			: new CustomEditor(this.tui, getEditorTheme(), KeybindingsManager.inMemory());
+		this.#editor.setText(this.#editorText);
+		if (!this.#customComponents.size) this.tui.setFocus(this.#editor);
+		this.#rebuildSurface();
+	}
+
+	getAllThemes(): Promise<{ name: string; path: string | undefined }[]> {
+		if (this.#delegate) return this.#delegate.getAllThemes();
+		return getAvailableThemesWithPaths().then(values =>
+			values.map(value => ({ name: value.name, path: value.path })),
+		);
+	}
+
+	getTheme(name: string): Promise<Theme | undefined> {
+		if (this.#delegate) return this.#delegate.getTheme(name);
+		return getThemeByName(name);
+	}
+
+	setTheme(value: string | Theme): Promise<{ success: boolean; error?: string }> {
+		if (this.#delegate) return this.#delegate.setTheme(value);
+		return typeof value === "string"
+			? setTheme(value, true)
+			: Promise.resolve({ success: false, error: "Direct theme object not supported" });
+	}
+
+	getToolsExpanded(): boolean {
+		if (this.#delegate) return this.#delegate.getToolsExpanded();
+		return this.#toolsExpanded;
+	}
+
+	setToolsExpanded(expanded: boolean): void {
+		if (this.#delegate) {
+			this.#delegate.setToolsExpanded(expanded);
+			return;
+		}
+		this.#toolsExpanded = expanded;
+		this.tui.requestRender();
+	}
+}
+
+function defaultOverlayOptions(): OverlayOptions {
+	return { anchor: "bottom-center", width: "100%", maxHeight: "100%", margin: 0 };
+}
