+/**
+ * Public entrypoint for Caret's negotiated virtual terminal adapter.
+ *
+ * The implementation is kept alongside the virtual UI owner so the terminal
+ * framing and component lifecycle cannot drift apart.  This module gives
+ * launchers and tests a stable, focused import without exposing the RPC mode
+ * runner itself.
+ */
+export {
+	CARET_TERMINAL_MAX_INPUT_BYTES,
+	CARET_TERMINAL_MAX_OUTPUT_BYTES,
+	CARET_TERMINAL_MAX_COLUMNS,
+	CARET_TERMINAL_MAX_ROWS,
+	CARET_TERMINAL_MIN_COLUMNS,
+	CARET_TERMINAL_MIN_ROWS,
+	CaretVirtualTerminal,
+	type CaretTerminalCloseFrame,
+	type CaretTerminalOpenFrame,
+	type CaretTerminalOutputFrame,
+	type CaretVirtualUiFrame,
+	type CaretVirtualUiOptions,
+	type CaretVirtualUiOutput,
+} from "./rpc-virtual-ui";
diff --git a/packages/coding-agent/src/modes/rpc/rpc-virtual-ui.ts b/packages/coding-agent/src/modes/rpc/rpc-virtual-ui.ts
new file mode 100644
index 0000000..3840a4c
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/rpc-virtual-ui.ts
@@ -0,0 +1,817 @@
+/**
+ * Opt-in RPC backed TUI surface.
+ *
+ * RPC mode is deliberately headless by default.  When a client negotiates the
+ * `caret_terminal` capability, extensions may use the same in-process TUI
+ * factories they use in interactive mode.  The terminal adapter keeps the
+ * OMP renderer and component tree in this process and forwards only bounded
+ * terminal bytes to the RPC client; it never starts another agent loop.
+ */
+import { Terminal as HeadlessTerminal } from "@oh-my-pi/pi-utils/vterm";
+import {
+	Container,
+	Text,
+	TUI,
+	type EditorTheme,
+	type OverlayHandle,
+	type OverlayOptions,
+	type Terminal,
+	type TerminalAppearance,
+} from "@oh-my-pi/pi-tui";
+import { KeybindingsManager } from "../../config/keybindings";
+import type {
+	ExtensionCustomOptions,
+	ExtensionUiComponent,
+	ExtensionUiComponentFactory,
+	ExtensionWidgetContent,
+	ExtensionWidgetOptions,
+	TerminalInputHandler,
+} from "../../extensibility/extensions";
+import { CustomEditor } from "../../modes/components/custom-editor";
+import {
+	getAvailableThemesWithPaths,
+	getEditorTheme,
+	getThemeByName,
+	setTheme,
+	theme,
+	type Theme,
+} from "../../modes/theme/theme";
+
+/** Version of the Caret terminal framing contract. */
+export const CARET_VIRTUAL_UI_VERSION = 1 as const;
+
+/** Maximum dimensions accepted from a remote renderer. */
+export const CARET_TERMINAL_MIN_COLUMNS = 2;
+export const CARET_TERMINAL_MAX_COLUMNS = 500;
+export const CARET_TERMINAL_MIN_ROWS = 1;
+export const CARET_TERMINAL_MAX_ROWS = 200;
+
+/** Maximum bytes in one terminal output frame. */
+export const CARET_TERMINAL_MAX_OUTPUT_BYTES = 64 * 1024;
+/** Maximum bytes accepted by one input command. */
+export const CARET_TERMINAL_MAX_INPUT_BYTES = 64 * 1024;
+
+export type CaretTerminalOpenFrame = {
+	type: "caret_terminal_open";
+	terminalId: string;
+	title?: string;
+	cols: number;
+	rows: number;
+};
+
+export type CaretTerminalOutputFrame = {
+	type: "caret_terminal_output";
+	terminalId: string;
+	sequence: number;
+	data: string;
+};
+
+export type CaretTerminalCloseFrame = {
+	type: "caret_terminal_close";
+	terminalId: string;
+	reason: string;
+};
+
+export type CaretVirtualUiFrame = CaretTerminalOpenFrame | CaretTerminalOutputFrame | CaretTerminalCloseFrame;
+
+export type CaretVirtualUiOutput = (frame: CaretVirtualUiFrame) => void;
+
+export type CaretVirtualUiOptions = {
+	output: CaretVirtualUiOutput;
+	terminalId?: string;
+	columns?: number;
+	rows?: number;
+	title?: string;
+	/** Leave TUI ownership to the shared Composer/InteractiveMode surface. */
+	externalRenderer?: boolean;
+};
+
+/** InteractiveMode-backed implementation used when RPC shares one TUI tree. */
+export type RpcVirtualUiDelegate = {
+	custom<T>(
+		factory: (
+			tui: TUI,
+			theme: Theme,
+			keybindings: KeybindingsManager,
+			done: (result: T) => void,
+		) => ExtensionUiComponent | Promise<ExtensionUiComponent>,
+		options?: ExtensionCustomOptions,
+	): Promise<T>;
+	setWidget(key: string, content: ExtensionWidgetContent, options?: ExtensionWidgetOptions): void;
+	setHeader(factory: ExtensionUiComponentFactory | undefined): void;
+	setFooter(factory: ExtensionUiComponentFactory | undefined): void;
+	onTerminalInput(handler: TerminalInputHandler): () => void;
+	setEditorText(text: string): void;
+	pasteToEditor(text: string): void;
+	getEditorText(): string;
+	setEditorComponent(
+		factory: ((tui: TUI, editorTheme: EditorTheme, keybindings: KeybindingsManager) => CustomEditor) | undefined,
+	): void;
+	getAllThemes(): Promise<{ name: string; path: string | undefined }[]>;
+	getTheme(name: string): Promise<Theme | undefined>;
+	setTheme(value: string | Theme): Promise<{ success: boolean; error?: string }>;
+	getToolsExpanded(): boolean;
+	setToolsExpanded(expanded: boolean): void;
+	/** Release InteractiveMode-owned components before the shared TUI stops. */
+	close?(): void;
+};
+
+export type CaretVirtualUiNegotiation = {
+	version: typeof CARET_VIRTUAL_UI_VERSION;
+	terminalId: string;
+	cols: number;
+	rows: number;
+};
+
+function assertDimension(value: number | undefined, min: number, max: number, label: string, fallback: number): number {
+	const candidate = value === undefined ? fallback : value;
+	if (!Number.isInteger(candidate) || candidate < min || candidate > max) {
+		throw new Error(`${label} must be an integer between ${min} and ${max}`);
+	}
+	return candidate;
+}
+
+function utf8ByteLength(value: string): number {
+	return Buffer.byteLength(value, "utf8");
+}
+
+/** Split a string at code-point boundaries while preserving its UTF-8 bytes. */
+function splitUtf8(value: string, maxBytes: number): string[] {
+	if (utf8ByteLength(value) <= maxBytes) return [value];
+	const chunks: string[] = [];
+	let current = "";
+	let currentBytes = 0;
+	for (const codePoint of value) {
+		const bytes = utf8ByteLength(codePoint);
+		if (current && currentBytes + bytes > maxBytes) {
+			chunks.push(current);
+			current = "";
+			currentBytes = 0;
+		}
+		// A single Unicode scalar is always <= 4 UTF-8 bytes and therefore fits
+		// the current frame budget.  Keep this guard for future budget changes.
+		if (bytes > maxBytes) throw new Error("Terminal output character exceeds frame budget");
+		current += codePoint;
+		currentBytes += bytes;
+	}
+	if (current) chunks.push(current);
+	return chunks;
+}
+
+/**
+ * Small `pi-tui` Terminal implementation backed by the production headless
+ * vterm parser.  It intentionally has no stdin/stdout ownership: all writes
+ * are framed for the negotiated RPC client and all input is injected by the
+ * caller through {@link sendInput}.
+ */
+export class CaretVirtualTerminal implements Terminal {
+	readonly terminalId: string;
+	#terminal: HeadlessTerminal;
+	#output: CaretVirtualUiOutput;
+	#title: string | undefined;
+	#sequence = 0;
+	#inputHandler: ((data: string) => void) | undefined;
+	#resizeHandler: (() => void) | undefined;
+	#dataSubscription: { dispose(): void } | undefined;
+	#started = false;
+	#closed = false;
+	#pendingOutputBytes = 0;
+	#closeReason = "stopped";
+
+	constructor(options: CaretVirtualUiOptions) {
+		this.terminalId = options.terminalId ?? `caret-terminal-${crypto.randomUUID()}`;
+		const columns = assertDimension(
+			options.columns,
+			CARET_TERMINAL_MIN_COLUMNS,
+			CARET_TERMINAL_MAX_COLUMNS,
+			"cols",
+			100,
+		);
+		const rows = assertDimension(options.rows, CARET_TERMINAL_MIN_ROWS, CARET_TERMINAL_MAX_ROWS, "rows", 30);
+		this.#output = options.output;
+		this.#title = options.title;
+		this.#terminal = new HeadlessTerminal({ cols: columns, rows, scrollback: 1_000 });
+	}
+
+	start(onInput: (data: string) => void, onResize: () => void, onDisconnect?: () => void): void {
+		if (this.#closed || this.#started) return;
+		this.#started = true;
+		this.#inputHandler = onInput;
+		this.#resizeHandler = onResize;
+		this.#dataSubscription = this.#terminal.onData(data => queueMicrotask(() => this.#inputHandler?.(data)));
+		this.#output({
+			type: "caret_terminal_open",
+			terminalId: this.terminalId,
+			title: this.#title,
+			cols: this.columns,
+			rows: this.rows,
+		});
+		// `onDisconnect` belongs to physical terminals.  Keep the parameter in
+		// the interface and intentionally do not invoke it for client input loss;
+		// the RPC owner performs bounded shutdown explicitly.
+		void onDisconnect;
+	}
+
+	stop(): void {
+		if (this.#closed) return;
+		this.#closed = true;
+		this.#dataSubscription?.dispose();
+		this.#dataSubscription = undefined;
+		this.#inputHandler = undefined;
+		this.#resizeHandler = undefined;
+		this.#terminal.dispose();
+		if (this.#started) {
+			this.#output({ type: "caret_terminal_close", terminalId: this.terminalId, reason: this.#closeReason });
+		}
+	}
+
+	setCloseReason(reason: string): void {
+		if (reason.trim()) this.#closeReason = reason.slice(0, 200);
+	}
+
+	async drainInput(_maxMs?: number, _idleMs?: number): Promise<void> {
+		// There is no operating-system input queue for a virtual terminal.
+	}
+
+	write(data: string): void {
+		if (this.#closed || !data) return;
+		const bytes = utf8ByteLength(data);
+		if (bytes > CARET_TERMINAL_MAX_OUTPUT_BYTES) {
+			for (const chunk of splitUtf8(data, CARET_TERMINAL_MAX_OUTPUT_BYTES)) this.#writeChunk(chunk);
+			return;
+		}
+		this.#writeChunk(data);
+	}
+
+	#writeChunk(data: string): void {
+		const bytes = utf8ByteLength(data);
+		this.#pendingOutputBytes += bytes;
+		try {
+			// Parse before forwarding so query replies (for example CPR) are queued
+			// in the same order as a real terminal would produce them.
+			this.#terminal.write(data);
+			this.#output({
+				type: "caret_terminal_output",
+				terminalId: this.terminalId,
+				sequence: this.#sequence++,
+				data,
+			});
+		} finally {
+			this.#pendingOutputBytes = Math.max(0, this.#pendingOutputBytes - bytes);
+		}
+	}
+
+	get columns(): number {
+		return this.#terminal.cols;
+	}
+
+	get rows(): number {
+		return this.#terminal.rows;
+	}
+
+	get pendingOutputBytes(): number {
+		return this.#pendingOutputBytes;
+	}
+
+	get kittyProtocolActive(): boolean {
+		return false;
+	}
+
+	get kittyEnableSequence(): string | null {
+		return null;
+	}
+
+	get keyboardEnhancementEnterSequence(): string | null {
+		return null;
+	}
+
+	get keyboardEnhancementExitSequence(): string | null {
+		return null;
+	}
+
+	get appearance(): TerminalAppearance | undefined {
+		return undefined;
+	}
+
+	onAppearanceChange(_callback: (appearance: TerminalAppearance) => void): void {
+		// A remote renderer owns appearance detection.
+	}
+
+	onPrivateModeReport(
+		_callback: (mode: number, supported: boolean, confirmed?: boolean, status?: number) => void,
+	): void {
+		// The headless parser does not answer capability probes.
+	}
+
+	resize(columns: number, rows: number): void {
+		if (this.#closed) throw new Error("Virtual terminal is closed");
+		const nextColumns = assertDimension(
+			columns,
+			CARET_TERMINAL_MIN_COLUMNS,
+			CARET_TERMINAL_MAX_COLUMNS,
+			"cols",
+			this.columns,
+		);
+		const nextRows = assertDimension(rows, CARET_TERMINAL_MIN_ROWS, CARET_TERMINAL_MAX_ROWS, "rows", this.rows);
+		if (nextColumns === this.columns && nextRows === this.rows) return;
+		this.#terminal.resize(nextColumns, nextRows);
+		this.#resizeHandler?.();
+	}
+
+	sendInput(data: string): void {
+		if (this.#closed || !this.#started) throw new Error("Virtual terminal is not active");
+		if (utf8ByteLength(data) > CARET_TERMINAL_MAX_INPUT_BYTES) {
+			throw new Error(`Terminal input exceeds ${CARET_TERMINAL_MAX_INPUT_BYTES} bytes`);
+		}
+		this.#inputHandler?.(data);
+	}
+
+	moveBy(lines: number): void {
+		if (lines > 0) this.write(`\x1b[${Math.trunc(lines)}B`);
+		else if (lines < 0) this.write(`\x1b[${Math.trunc(-lines)}A`);
+	}
+
+	hideCursor(_force?: boolean): void {
+		this.write("\x1b[?25l");
+	}
+
+	showCursor(_force?: boolean): void {
+		this.write("\x1b[?25h");
+	}
+
+	setCursorShape(_shape: "default" | "block" | "underline" | "bar"): void {
+		// Software cursors are rendered by the remote TUI.
+	}
+
+	clearLine(): void {
+		this.write("\x1b[2K");
+	}
+
+	clearFromCursor(): void {
+		this.write("\x1b[J");
+	}
+
+	clearScreen(): void {
+		this.write("\x1b[2J\x1b[H");
+	}
+
+	setTitle(title: string): void {
+		this.#title = title;
+		this.write(`\x1b]0;${title.replaceAll(/[\x00-\x1f\x7f]/g, " ")}\x07`);
+	}
+
+	setProgress(active: boolean): void {
+		this.write(active ? "\x1b]9;4;3\x07" : "\x1b]9;4;0;\x07");
+	}
+}
+
+type MountedComponent = ExtensionUiComponent & { dispose?(): void };
+
+type RpcVirtualUiWaiter = {
+	resolve: (ui: RpcVirtualUi) => void;
+	reject: (error: Error) => void;
+	onAbort?: () => void;
+	signal?: AbortSignal;
+};
+
+/**
+ * Gates extension UI calls until a Caret virtual terminal handshake completes.
+ *
+ * `session_start` hooks can run before the RPC reader has accepted a client
+ * frame.  `reject()` fails current waiters so a failed negotiation can be
+ * retried; `close()` permanently rejects future waits on disconnect.
+ */
+export class RpcVirtualUiReadyGate {
+	#value: RpcVirtualUi | undefined;
+	#closedError: Error | undefined;
+	#waiters = new Set<RpcVirtualUiWaiter>();
+
+	wait(signal?: AbortSignal): Promise<RpcVirtualUi> {
+		if (this.#value) return Promise.resolve(this.#value);
+		if (this.#closedError) return Promise.reject(this.#closedError);
+		if (signal?.aborted) {
+			return Promise.reject(signal.reason ?? new DOMException("Dialog aborted", "AbortError"));
+		}
+		return new Promise<RpcVirtualUi>((resolve, reject) => {
+			const waiter: RpcVirtualUiWaiter = { resolve, reject, signal };
+			const cleanup = () => {
+				this.#waiters.delete(waiter);
+				if (waiter.onAbort && signal) signal.removeEventListener("abort", waiter.onAbort);
+			};
+			waiter.onAbort = () => {
+				cleanup();
+				reject(signal?.reason ?? new DOMException("Dialog aborted", "AbortError"));
+			};
+			this.#waiters.add(waiter);
+			signal?.addEventListener("abort", waiter.onAbort, { once: true });
+			// A handshake can complete between the initial check and adding the
+			// waiter.  Resolve immediately in that case.
+			if (this.#value) {
+				cleanup();
+				resolve(this.#value);
+			}
+		});
+	}
+
+	resolve(ui: RpcVirtualUi): void {
+		if (this.#closedError || this.#value) return;
+		this.#value = ui;
+		for (const waiter of Array.from(this.#waiters)) {
+			this.#waiters.delete(waiter);
+			if (waiter.onAbort && waiter.signal) waiter.signal.removeEventListener("abort", waiter.onAbort);
+			waiter.resolve(ui);
+		}
+	}
+
+	reject(error: Error): void {
+		for (const waiter of Array.from(this.#waiters)) {
+			this.#waiters.delete(waiter);
+			if (waiter.onAbort && waiter.signal) waiter.signal.removeEventListener("abort", waiter.onAbort);
+			waiter.reject(error);
+		}
+	}
+
+	close(message: string): void {
+		if (!this.#closedError) this.#closedError = new Error(message);
+		this.reject(this.#closedError);
+	}
+}
+
+/**
+ * Owns one virtual TUI and exposes the extension UI surface around it.  The
+ * class intentionally keeps all factories local to this OMP process; only
+ * terminal framing crosses the RPC boundary.
+ */
+export class RpcVirtualUi {
+	readonly terminal: CaretVirtualTerminal;
+	readonly tui: TUI;
+	#surface = new Container();
+	readonly #externalRenderer: boolean;
+	#delegate: RpcVirtualUiDelegate | undefined;
+	#started = false;
+	#closed = false;
+	#editorText = "";
+	#toolsExpanded = false;
+	#widgetsAbove = new Map<string, MountedComponent>();
+	#widgetsBelow = new Map<string, MountedComponent>();
+	#customComponents = new Set<MountedComponent>();
+	#header: MountedComponent | undefined;
+	#footer: MountedComponent | undefined;
+	#editor: (CustomEditor & MountedComponent) | undefined;
+	#inputUnsubscribers = new Set<() => void>();
+	#pendingCustomClosers = new Set<() => void>();
+
+	constructor(options: CaretVirtualUiOptions) {
+		this.terminal = new CaretVirtualTerminal(options);
+		this.#externalRenderer = options.externalRenderer === true;
+		this.tui = new TUI(this.terminal);
+		if (!this.#externalRenderer) this.tui.addChild(this.#surface);
+	}
+
+	/** Attach the InteractiveMode-backed surface before the RPC handshake starts. */
+	attachInteractiveSurface(delegate: RpcVirtualUiDelegate): void {
+		if (!this.#externalRenderer) throw new Error("Interactive surface requires an external renderer");
+		if (this.#closed) throw new Error("Caret virtual UI is closed");
+		this.#delegate = delegate;
+	}
+
+	get negotiation(): CaretVirtualUiNegotiation {
+		return {
+			version: CARET_VIRTUAL_UI_VERSION,
