+		handle,
+		path: nonEmptyString(value.path, "document.path"),
+		text: value.text,
+		documentVersion,
+		sha256: sha256(value.sha256, "document.sha256"),
+		dirty: value.dirty,
+		...(typeof value.isUntitled === "boolean" ? { isUntitled: value.isUntitled } : {}),
