index 0000000..e861e28
--- /dev/null
+++ b/packages/coding-agent/test/rpc-virtual-ui.test.ts
@@ -0,0 +1,243 @@
+import { describe, expect, test } from "bun:test";
+import type { Component } from "@oh-my-pi/pi-tui";
+import {
+	CARET_TERMINAL_MAX_INPUT_BYTES,
+	CARET_TERMINAL_MAX_OUTPUT_BYTES,
+	CaretVirtualTerminal,
+	RpcVirtualUi,
+	RpcVirtualUiReadyGate,
+} from "../src/modes/rpc/rpc-virtual-ui";
+import { ensureTheme } from "../src/modes/theme/theme";
+
+const encoder = new TextEncoder();
+
+await ensureTheme();
+
+function lineComponent(line: string, onInput?: (data: string) => void): Component & { disposed?: boolean } {
+	return {
+		render: () => [line],
+		handleInput: onInput,
+		dispose() {
+			this.disposed = true;
+		},
+	};
+}
+
+describe("Caret virtual RPC terminal", () => {
+	test("frames lifecycle, preserves output order, and bounds bytes", () => {
+		const frames: unknown[] = [];
+		const terminal = new CaretVirtualTerminal({
+			output: frame => frames.push(frame),
+			columns: 80,
+			rows: 24,
+		});
+		terminal.start(
+			() => {},
+			() => {},
+		);
+		terminal.write("hello");
+		terminal.write("x".repeat(CARET_TERMINAL_MAX_OUTPUT_BYTES * 2));
+		terminal.stop();
+
+		expect(frames[0]).toMatchObject({ type: "caret_terminal_open", cols: 80, rows: 24 });
+		const output = frames.filter((frame): frame is { type: string; data: string; sequence: number } => {
+			return (
+				typeof frame === "object" &&
+				frame !== null &&
+				"type" in frame &&
+				(frame as { type?: string }).type === "caret_terminal_output"
+			);
+		});
+		expect(output.map(frame => frame.sequence)).toEqual(output.map(frame => frame.sequence).sort((a, b) => a - b));
+		expect(output.every(frame => encoder.encode(frame.data).byteLength <= CARET_TERMINAL_MAX_OUTPUT_BYTES)).toBe(
+			true,
+		);
+		expect(output.map(frame => frame.data).join("")).toContain("hello");
+		expect(frames.at(-1)).toMatchObject({ type: "caret_terminal_close", reason: "stopped" });
+	});
+
+	test("rejects oversized input and dimensions", () => {
+		const terminal = new CaretVirtualTerminal({ output: () => {}, columns: 80, rows: 24 });
+		terminal.start(
+			() => {},
+			() => {},
+		);
+		expect(() => terminal.sendInput("x".repeat(CARET_TERMINAL_MAX_INPUT_BYTES + 1))).toThrow();
+		expect(() => terminal.resize(1, 24)).toThrow();
+		expect(() => terminal.resize(80, 201)).toThrow();
+		terminal.stop();
+	});
+});
+
+describe("RpcVirtualUi", () => {
+	test("releases session_start custom waits when the client negotiates", async () => {
+		const gate = new RpcVirtualUiReadyGate();
+		const ui = new RpcVirtualUi({ output: () => {}, columns: 40, rows: 8 });
+		ui.start();
+		let settled = false;
+		const custom = gate.wait().then(negotiated =>
+			negotiated.custom<string>((_tui, _theme, _keys, done) => {
+				return lineComponent("startup", data => done(data));
+			}),
+		);
+		void custom.finally(() => {
+			settled = true;
+		});
+		await Promise.resolve();
+		expect(settled).toBe(false);
+		gate.resolve(ui);
+		await Bun.sleep(0);
+		ui.sendInput("ready");
+		expect(await custom).toBe("ready");
+		expect(settled).toBe(true);
+		ui.close("test_done");
+	});
+
+	test("rejects pre-negotiation waits when the RPC client disconnects", async () => {
+		const gate = new RpcVirtualUiReadyGate();
+		const pending = gate.wait();
+		gate.close("client_disconnected");
+		await expect(pending).rejects.toThrow("client_disconnected");
+	});
+
+	test("runs custom factories in-process and routes negotiated input only to focus", async () => {
+		const frames: unknown[] = [];
+		const ui = new RpcVirtualUi({ output: frame => frames.push(frame), columns: 40, rows: 8 });
+		ui.start();
+		let received = "";
+		const result = ui.custom<string>((tui, passedTheme, keybindings, done) => {
+			expect(tui).toBe(ui.tui);
+			expect(passedTheme).toBeDefined();
+			expect(keybindings).toBeDefined();
+			return lineComponent("custom", data => {
+				received = data;
+				done(data);
+			});
+		});
+		await Promise.resolve();
+		ui.sendInput("enter");
+		expect(await result).toBe("enter");
+		expect(received).toBe("enter");
+		expect(
+			frames.some(
+				frame =>
+					typeof frame === "object" &&
+					frame !== null &&
+					(frame as { type?: string }).type === "caret_terminal_open",
+			),
+		).toBe(true);
+		ui.close("test_done");
+	});
+
+	test("retains and disposes header, footer, widget, and custom components", async () => {
+		const frames: unknown[] = [];
+		const ui = new RpcVirtualUi({ output: frame => frames.push(frame), columns: 60, rows: 10 });
+		ui.start();
+		const header = lineComponent("header");
+		const footer = lineComponent("footer");
+		const widget = lineComponent("widget");
+		ui.setHeader(() => header);
+		ui.setFooter(() => footer);
+		ui.setWidget("w", () => widget);
+		await Bun.sleep(60);
+		const rendered = frames
+			.filter((frame): frame is { type: string; data: string } => {
+				return (
+					typeof frame === "object" &&
+					frame !== null &&
+					(frame as { type?: string }).type === "caret_terminal_output"
+				);
+			})
+			.map(frame => frame.data)
+			.join("");
+		expect(rendered).toContain("header");
+		expect(rendered).toContain("widget");
+		expect(rendered).toContain("footer");
+		ui.close("test_done");
+		expect(header.disposed).toBe(true);
+		expect(widget.disposed).toBe(true);
+		expect(footer.disposed).toBe(true);
+	});
+
+	test("aborts a pending custom component and calls its disposer", async () => {
+		const ui = new RpcVirtualUi({ output: () => {}, columns: 40, rows: 8 });
+		ui.start();
+		const controller = new AbortController();
+		const component = lineComponent("pending");
+		const pending = ui.custom(() => component, { signal: controller.signal });
+		await Promise.resolve();
+		controller.abort(new Error("cancelled"));
+		await expect(pending).rejects.toThrow("cancelled");
+		expect(component.disposed).toBe(true);
+		ui.close();
+	});
+
+	test("rejects pending custom work when the terminal closes", async () => {
+		const ui = new RpcVirtualUi({ output: () => {}, columns: 40, rows: 8 });
+		ui.start();
+		const pending = ui.custom(() => new Promise<Component>(() => {}));
+		ui.close("client_disconnected");
+		await expect(pending).rejects.toThrow("Caret virtual UI closed");
+	});
+
+	test("isolates throwing disposers and still emits one terminal close frame", async () => {
+		const frames: unknown[] = [];
+		const ui = new RpcVirtualUi({ output: frame => frames.push(frame), columns: 40, rows: 8 });
+		ui.start();
+		let throwingDisposeCount = 0;
+		const throwingHeader: Component = {
+			render: () => ["throwing-header"],
+			dispose() {
+				throwingDisposeCount++;
+				throw new Error("fixture disposer failure");
+			},
+		};
+		const footer = lineComponent("surviving-footer");
+		const widget = lineComponent("surviving-widget");
+		ui.setHeader(() => throwingHeader);
+		ui.setFooter(() => footer);
+		ui.setWidget("fixture", () => widget);
+		await Bun.sleep(20);
+
+		ui.close("throwing_disposer");
+
+		expect(throwingDisposeCount).toBeGreaterThan(0);
+		expect(footer.disposed).toBe(true);
+		expect(widget.disposed).toBe(true);
+		const closes = frames.filter(
+			(frame): frame is { type: string; reason: string } =>
+				typeof frame === "object" && frame !== null && (frame as { type?: string }).type === "caret_terminal_close",
+		);
+		expect(closes).toHaveLength(1);
+		expect(closes[0]).toMatchObject({ reason: "throwing_disposer" });
+	});
+
+	test("mounts a real CustomEditor, renders its draft, and routes input to getEditorText", async () => {
+		const frames: unknown[] = [];
+		const ui = new RpcVirtualUi({ output: frame => frames.push(frame), columns: 60, rows: 10 });
+		ui.start();
+		ui.setEditorText("caret-editor-render-probe");
+		await Bun.sleep(40);
+
+		const rendered = frames
+			.filter((frame): frame is { type: string; data: string } => {
+				return (
+					typeof frame === "object" &&
+					frame !== null &&
+					(frame as { type?: string }).type === "caret_terminal_output" &&
+					typeof (frame as { data?: unknown }).data === "string"
+				);
+			})
+			.map(frame => frame.data)
+			.join("");
+		expect(rendered).toContain("caret-editor-render-probe");
+		expect(ui.getEditorText()).toBe("caret-editor-render-probe");
+
+		ui.sendInput("!");
+		await Bun.sleep(20);
+		expect(ui.getEditorText()).toBe("caret-editor-render-probe!");
+		const debugDocument = ui.tui.getDebugDocument().join("\n");
+		expect(debugDocument).toContain("caret-editor-render-probe!");
+		ui.close("editor_probe_done");
+	});
+});
