+		throw new Error(
+			"Caret native editor response was malformed: apply.document.path does not match the requested path",
+		);
+	}
+	return {
+		text: parsed.text,
+		document,
+		saved: false,
+		undoPreserved: true,
+	};
+}
+
+function cloneEditorGuardParams(params: {
+	path: string;
+	handle: { id: string; uri: string };
+	expectedVersion: number;
+	expectedHash: string;
