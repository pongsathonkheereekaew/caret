+++ b/packages/coding-agent/src/tools/ast-editor-plan.ts
@@ -0,0 +1,172 @@
+import { createHash } from "node:crypto";
+import type { ToolSession } from ".";
+import type { ClientBridgeEditorDocumentSnapshot } from "../session/client-bridge";
+import { FileChangeType, notifyWorkspaceWatchedFiles } from "../lsp/client";
+import { applyNativeEditorSnapshot } from "./acp-bridge";
+import { assertEditableFile } from "./auto-generated-guard";
+import { invalidateFsScanAfterWrite } from "./fs-cache-invalidation";
+import { canonicalNativeEditorPath } from "./native-editor-observations";
+
+export interface AstCapturedSource {
+	path: string;
+	before: string;
+	after: string;
+}
+interface CapturedResult {
+	sources?: AstCapturedSource[];
+	applied: boolean;
+}
+interface Entry {
+	lexical: string;
+	canonical: string;
+	source: AstCapturedSource;
+	editor: ClientBridgeEditorDocumentSnapshot | null;
+}
+const hash = (text: string) => createHash("sha256").update(text).digest("hex");
+const same = (base: ClientBridgeEditorDocumentSnapshot, current: ClientBridgeEditorDocumentSnapshot | null) =>
+	current &&
+	base.handle.id === current.handle.id &&
+	base.handle.uri === current.handle.uri &&
+	base.documentVersion === current.documentVersion &&
+	base.sha256 === current.sha256 &&
+	base.text === current.text;
+
+/** Freeze native AST output against exact editor/disk sources before publishing its preview. */
+export async function prepareAstEditorPlan<T extends CapturedResult>(
+	session: ToolSession,
+	run: (overrides?: Record<string, string>) => Promise<T>,
+	resolvePath: (displayPath: string) => string,
+	signal?: AbortSignal,
+) {
+	const bridge = session.getClientBridge?.();
+	if (!bridge?.capabilities.nativeEditor || !bridge.nativeEditor)
+		throw new Error("Native editor capability unavailable");
+	const nativeEditor = bridge.nativeEditor;
+	const initial = await run();
+	if (!initial.sources) throw new Error("Native AST source capture is unavailable; rebuild the pinned Caret runtime");
+	const entries = new Map<string, Entry>();
+	const overrides: Record<string, string> = Object.create(null);
+	let bytes = 0;
+	for (const source of initial.sources) {
+		signal?.throwIfAborted();
+		const lexical = resolvePath(source.path);
+		const canonical = canonicalNativeEditorPath(lexical);
+		if (entries.has(canonical)) throw new Error("AST scopes overlap; use a single scope for each source file");
+		if (entries.size >= 8192) throw new Error("AST candidate capacity exceeded; narrow the scope");
+		const { document } = await nativeEditor.snapshot({ path: canonical }, signal);
+		const before = document?.text ?? source.before;
+		if (document && (canonicalNativeEditorPath(document.path) !== canonical || hash(before) !== document.sha256))
+			throw new Error("Invalid native AST editor snapshot");
+		bytes += Buffer.byteLength(before);
+		if (bytes > 16 * 1024 * 1024) throw new Error("AST source capacity exceeded; narrow the scope");
+		// This private preview base is not a full-file model-visible read observation.
+		const editor = document ? { ...document, handle: { ...document.handle } } : null;
+		entries.set(canonical, { lexical, canonical, source: { ...source, before }, editor });
+		overrides[canonical] = before;
+	}
+	const result = await run(overrides);
+	if (!result.sources || result.sources.length !== entries.size)
+		throw new Error("AST candidate set changed during preview; retry");
+	const seen = new Set<string>();
+	let outputBytes = 0;
+	for (const source of result.sources) {
+		const key = canonicalNativeEditorPath(resolvePath(source.path));
+		const entry = entries.get(key);
+		if (!entry || seen.has(key) || source.before !== entry.source.before)
+			throw new Error("AST source changed during preview; retry");
+		seen.add(key);
+		outputBytes += Buffer.byteLength(source.before) + Buffer.byteLength(source.after);
+		if (outputBytes > 32 * 1024 * 1024) throw new Error("AST preview capacity exceeded; narrow the scope");
+		entry.source = { ...source };
+	}
+	let applied = false;
+	let attempted = false;
+	const verify = async (entry: Entry) => {
+		if (canonicalNativeEditorPath(entry.lexical) !== entry.canonical)
+			throw new Error("AST path changed its target; preview again");
+		const current = (await nativeEditor.snapshot({ path: entry.canonical })).document;
+		if (entry.editor) {
+			if (!same(entry.editor, current))
+				throw new Error("AST editor preview is stale; preview again before applying");
+		} else {
+			if (current) throw new Error("AST file is now owned by an editor; preview again before applying");
+			const file = Bun.file(entry.lexical);
+			const expected = Buffer.from(entry.source.before);
+			if (file.size !== expected.length) throw new Error("AST disk preview is stale; preview again before applying");
+			const bytes = await file.slice(0, expected.length + 1).arrayBuffer();
+			if (!Buffer.from(bytes).equals(expected))
+				throw new Error("AST disk preview is stale; preview again before applying");
+		}
+	};
+	return {
+		result,
+		text(path: string) {
+			const source = entries.get(canonicalNativeEditorPath(path))?.source;
+			return source ? (applied ? source.after : source.before) : undefined;
+		},
+		async apply(): Promise<T> {
+			if (attempted) throw new Error("AST preview already attempted; inspect the outcome before retrying");
+			attempted = true; // Claim before any asynchronous preflight; concurrent resolve cannot replay it.
+			// Preflight the complete preview before the first effect, including later files.
+			for (const entry of entries.values()) {
+				await verify(entry);
+				if (entry.source.before !== entry.source.after) {
+					if (
+						Buffer.byteLength(entry.source.before) > 8 * 1024 * 1024 ||
+						Buffer.byteLength(entry.source.after) > 8 * 1024 * 1024
+					)
+						throw new Error("AST guarded apply exceeds the per-file limit; narrow the edit");
+					if (!entry.editor && !nativeEditor.applyDisk)
+						throw new Error(
+							"Guarded headless AST apply is unavailable; open the task in Caret or upgrade the host",
+						);
+					await assertEditableFile(entry.lexical, entry.source.path, session.settings, entry.source.before);
+				}
+			}
+			let effectsStarted = false;
+			try {
+				for (const entry of entries.values()) {
+					if (entry.source.before === entry.source.after) continue;
+					// Recheck immediately before each effect; failures after earlier writes are explicit partial outcomes.
+					await verify(entry);
+					effectsStarted = true;
+					if (entry.editor) {
+						await applyNativeEditorSnapshot(
+							session,
+							entry.canonical,
+							entry.source.path,
+							entry.editor,
+							entry.source.after,
+						);
+					} else {
+						const outcome = await nativeEditor.applyDisk!({
+							path: entry.lexical,
+							expectedCanonicalPath: entry.canonical,
+							expectedText: entry.source.before,
+							content: entry.source.after,
+						});
+						if (
+							outcome.text !== entry.source.after ||
+							outcome.saved !== true ||
+							outcome.canonicalPath !== entry.canonical
+						)
+							throw new Error("Guarded disk apply outcome is unknown; inspect before retrying");
+						invalidateFsScanAfterWrite(entry.lexical);
+						session.bumpFileMutationVersion?.(entry.lexical);
+						if (session.enableLsp ?? true)
+							await notifyWorkspaceWatchedFiles(session.cwd, [
+								{ filePath: entry.lexical, type: FileChangeType.Changed },
+							]);
+					}
+				}
+			} catch (error) {
+				if (effectsStarted) {
+					throw new Error(`AST apply may have partially changed files; inspect before retrying: ${String(error)}`);
+				}
+				throw error;
+			}
+			applied = true;
+			return { ...result, applied: true };
+		},
+	};
+}
