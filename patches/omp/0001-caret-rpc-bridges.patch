+
+function parseEditorDeleteResponse(result: unknown, requestedPath: string): { deleted: true; path: string; uri: string } {
+	const parsed = textOutcome(result);
+	if (!isRecord(parsed) || parsed.deleted !== true) {
+		throw new Error("Caret native editor response was malformed: delete.deleted must be true");
+	}
+	const path = nonEmptyString(parsed.path, "delete.path");
+	const uri = nonEmptyString(parsed.uri, "delete.uri");
