@@ -0,0 +1,24 @@
+import { expect, test } from "bun:test";
+import { homedir } from "node:os";
+import { join } from "node:path";
+import { initLoaderContext } from "../native/loader-state.js";
+
+test("Caret compiled addons never share the upstream version cache", () => {
+	const oldCache = process.env.CARET_NATIVE_CACHE_DIR;
+	const oldCompiled = process.env.CARET_COMPILED_RUNTIME;
+	try {
+		delete process.env.CARET_NATIVE_CACHE_DIR;
+		process.env.CARET_COMPILED_RUNTIME = "1";
+		const compiled = initLoaderContext({ isCompiledBinary: true });
+		expect(compiled.nativesDir).toBe(join(homedir(), "Library", "Caches", "Caret", "omp-natives"));
+		process.env.CARET_NATIVE_CACHE_DIR = "/tmp/caret-private-native-cache";
+		expect(initLoaderContext({ isCompiledBinary: true }).nativesDir).toBe("/tmp/caret-private-native-cache");
+		process.env.CARET_NATIVE_CACHE_DIR = "relative-cache";
+		expect(() => initLoaderContext({ isCompiledBinary: true })).toThrow(/absolute/);
+	} finally {
+		if (oldCache === undefined) delete process.env.CARET_NATIVE_CACHE_DIR;
+		else process.env.CARET_NATIVE_CACHE_DIR = oldCache;
+		if (oldCompiled === undefined) delete process.env.CARET_COMPILED_RUNTIME;
+		else process.env.CARET_COMPILED_RUNTIME = oldCompiled;
+	}
+});
