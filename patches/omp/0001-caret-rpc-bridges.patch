+
+const PERMISSION_OPTION_KINDS = new Set<ClientBridgePermissionOption["kind"]>([
+	"allow_once",
+	"allow_always",
+	"reject_once",
+	"reject_always",
+]);
+
+type CombinedSignal = {
+	signal: AbortSignal;
+	isAborted: () => boolean;
+	dispose: () => void;
+};
+
+function makeCombinedSignal(parent: AbortSignal | undefined, timeoutMs: number): CombinedSignal {
+	const controller = new AbortController();
+	const deadline = performance.now() + timeoutMs;
+	let timedOut = false;
+	let disposed = false;
+	const abort = (reason: unknown): void => {
+		if (!controller.signal.aborted) controller.abort(reason);
+	};
+	const onParentAbort = (): void => abort(parent?.reason ?? new Error("Permission request cancelled"));
+	if (parent?.aborted) onParentAbort();
+	else parent?.addEventListener("abort", onParentAbort, { once: true });
+	const timer = setTimeout(() => {
+		timedOut = true;
+		abort(new Error("Caret native permission request timed out"));
+	}, timeoutMs);
+	timer.unref?.();
+
+	return {
+		signal: controller.signal,
+		isAborted: () =>
+			controller.signal.aborted || timedOut || performance.now() >= deadline || parent?.aborted === true,
+		dispose: () => {
+			if (disposed) return;
+			disposed = true;
+			clearTimeout(timer);
+			parent?.removeEventListener("abort", onParentAbort);
+		},
+	};
+}
+
+function normalizeTimeout(value: number | undefined): number {
+	const timeoutMs = value ?? CARET_NATIVE_PERMISSION_TIMEOUT_MS;
+	if (!Number.isFinite(timeoutMs) || timeoutMs <= 0) {
+		throw new TypeError("Caret native permission timeout must be a positive finite number");
+	}
+	return Math.min(Math.floor(timeoutMs), CARET_NATIVE_PERMISSION_TIMEOUT_MS);
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return !!value && typeof value === "object" && !Array.isArray(value);
+}
+
+function textOutcome(result: unknown): unknown {
+	if (!isRecord(result) || !Array.isArray(result.content)) {
+		throw new Error("Caret native permission response was malformed: missing content");
+	}
+	const content = result.content;
+	if (
+		content.length !== 1 ||
+		!isRecord(content[0]) ||
+		content[0].type !== "text" ||
+		typeof content[0].text !== "string"
+	) {
+		throw new Error("Caret native permission response was malformed: expected one JSON text block");
+	}
+	try {
+		return JSON.parse(content[0].text) as unknown;
+	} catch {
+		throw new Error("Caret native permission response was malformed: invalid JSON");
+	}
