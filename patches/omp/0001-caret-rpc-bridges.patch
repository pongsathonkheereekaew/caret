+	async custom<T>(
+		factory: (
+			tui: TUI,
+			theme: Theme,
+			keybindings: KeybindingsManager,
+			done: (result: T) => void,
+		) => ExtensionUiComponent | Promise<ExtensionUiComponent>,
+		options?: ExtensionCustomOptions,
+	): Promise<T> {
+		this.#assertActive();
+		if (this.#delegate) return this.#delegate.custom(factory, options);
+		const keybindings = KeybindingsManager.inMemory();
+		const { promise, resolve, reject } = Promise.withResolvers<T>();
+		let component: MountedComponent | undefined;
+		let overlayHandle: OverlayHandle | undefined;
+		let closed = false;
+		function closeOnUiEnd(): void {
+			fail(new Error("Caret virtual UI closed"));
+		}
+		const cleanup = () => {
+			overlayHandle?.hide();
+			overlayHandle = undefined;
+			if (component) {
+				this.#surface.removeChild(component);
+				this.#customComponents.delete(component);
+				component.dispose?.();
+			}
