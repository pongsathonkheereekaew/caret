+let dir: string;
+beforeEach(async () => {
+	dir = await realpath(await mkdtemp(join(tmpdir(), "caret-ast-")));
+});
+afterEach(async () => {
+	await rm(dir, { recursive: true, force: true });
+});
+const doc = (path: string, text: string, version = 1): ClientBridgeEditorDocumentSnapshot => ({
+	path,
+	text,
+	documentVersion: version,
+	sha256: createHash("sha256").update(text).digest("hex"),
+	handle: { id: path, uri: `file://${path}` },
+	dirty: true,
+});
+function fixture(initial: ClientBridgeEditorDocumentSnapshot[]) {
+	const documents = new Map(initial.map(document => [document.path, document]));
+	const snapshots: string[] = [],
+		applied: string[] = [];
+	let disconnected = false;
+	let failApplyPath: string | undefined;
+	let raceDiskPath: string | undefined;
+	const bridge: ClientBridge = {
+		capabilities: { nativeEditor: true },
+		nativeEditor: {
+			applyDisk: async params => {
+				if (params.path === raceDiskPath) writeFileSync(params.path, "manualAfterPreflight();\n");
+				if (
+					realpathSync(params.path) !== params.expectedCanonicalPath ||
+					readFileSync(params.path, "utf8") !== params.expectedText
+				)
+					throw new Error("host rejected changed disk at write boundary");
+				writeFileSync(params.path, params.content);
+				return { text: params.content, saved: true, canonicalPath: params.expectedCanonicalPath };
+			},
+			snapshot: async ({ path }) => {
+				if (disconnected) throw new Error("editor disconnected");
+				snapshots.push(path);
+				return { document: documents.get(path) ?? null };
+			},
+			apply: async request => {
+				if (request.path === failApplyPath) throw new Error("transport closed after delivery");
+				const current = documents.get(request.path)!;
+				expect(request.expectedVersion).toBe(current.documentVersion);
+				expect(request.expectedHash).toBe(current.sha256);
+				applied.push(request.path);
+				const next = doc(request.path, request.content, current.documentVersion + 1);
+				documents.set(request.path, next);
+				return { text: next.text, document: next, saved: false, undoPreserved: true };
+			},
+		},
+	};
+	const queue = new ToolChoiceQueue();
+	const session: ToolSession = {
+		cwd: dir,
+		hasUI: true,
+		getSessionFile: () => null,
+		getSessionSpawns: () => "*",
+		enableLsp: false,
+		settings: Settings.isolated({ "tools.xdev": false }),
+		getClientBridge: () => bridge,
+		getToolChoiceQueue: () => queue,
+		buildToolChoice: () => ({ type: "tool" as const, name: "resolve" }),
+		steer: () => {},
+	};
+	const tool = new AstEditTool(session);
+	return {
+		documents,
+		snapshots,
+		applied,
+		session,
+		failApply(path: string) {
+			failApplyPath = path;
+		},
+		raceDisk(path: string) {
+			raceDiskPath = path;
+		},
+		disableDisk() {
+			bridge.nativeEditor!.applyDisk = undefined;
+		},
+		disconnect() {
+			disconnected = true;
+		},
+		preview: (paths = ["*.ts"]) =>
+			tool.execute("preview", { paths, ops: [{ pat: "oldCall($$$ARGS)", out: "newCall($$$ARGS)" }] }),
+		apply: () => queue.peekPendingInvoker()!({ action: "apply", reason: "fixture acceptance" }),
+	};
