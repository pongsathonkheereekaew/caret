+		throw new TypeError("Caret native editor request requires a non-negative integer expectedVersion");
+	}
+	if (typeof params.expectedHash !== "string" || !/^[0-9a-fA-F]{64}$/.test(params.expectedHash)) {
+		throw new TypeError("Caret native editor request requires a SHA-256 expectedHash");
+	}
+	return {
+		path: params.path,
+		handle: { id, uri },
+		expectedVersion: params.expectedVersion,
+		expectedHash: params.expectedHash,
+	};
+}
+
+async function parseEditorCreateResponse(
+	result: unknown,
+	requestedPath: string,
+): Promise<ClientBridgeEditorApplyResponse> {
+	const parsed = textOutcome(result);
+	if (!isRecord(parsed)) throw new Error("Caret native editor response was malformed: expected an object");
+	if (parsed.saved !== false) {
+		throw new Error("Caret native editor response was malformed: create.saved must be false");
+	}
+	if (parsed.undoPreserved !== true) {
+		throw new Error("Caret native editor response was malformed: create.undoPreserved must be true");
+	}
