+
+async function parseEditorApplyResponse(
+	result: unknown,
+	requestedPath: string,
+): Promise<ClientBridgeEditorApplyResponse> {
+	const parsed = textOutcome(result);
+	if (!isRecord(parsed)) throw new Error("Caret native editor response was malformed: expected an object");
+	if (typeof parsed.text !== "string") {
+		throw new Error("Caret native editor response was malformed: apply.text must be a string");
+	}
+	if (parsed.saved !== false) {
+		throw new Error("Caret native editor response was malformed: apply.saved must be false");
+	}
