+import { AgentSession } from "@oh-my-pi/pi-coding-agent/session/agent-session";
+import { AuthStorage } from "@oh-my-pi/pi-coding-agent/session/auth-storage";
+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import { executeBuiltinSlashCommand } from "@oh-my-pi/pi-coding-agent/slash-commands/builtin-registry";
+import { TempDir } from "@oh-my-pi/pi-utils";
+
+describe("RPC TUI slash bridge", () => {
+	let authStorage: AuthStorage;
+	let modelRegistry: ModelRegistry;
+	let tempDir: TempDir;
+
+	beforeAll(async () => {
+		initTheme();
+		tempDir = TempDir.createSync("@pi-rpc-tui-slash-");
+		await Settings.init({ inMemory: true, cwd: tempDir.path() });
+		authStorage = await AuthStorage.create(`${tempDir.path()}/auth.db`);
+		modelRegistry = new ModelRegistry(authStorage);
+	});
+
+	afterEach(() => {
+		vi.restoreAllMocks();
+	});
+
+	afterAll(() => {
+		authStorage.close();
+		tempDir.removeSync();
+		resetSettingsForTest();
+	});
+
+	async function createHarness(): Promise<{
+		session: AgentSession;
+		mode: InteractiveMode;
+		ui: RpcVirtualUi;
+	}> {
+		const model = modelRegistry.find("anthropic", "claude-sonnet-4-5");
+		if (!model) throw new Error("Expected claude-sonnet-4-5 test model");
+		const settings = Settings.isolated({ "goal.enabled": true, "plan.enabled": true });
+		const session = new AgentSession({
+			agent: new Agent({ initialState: { model, systemPrompt: ["Test"], tools: [], messages: [] } }),
+			sessionManager: SessionManager.create(tempDir.path(), tempDir.path()),
+			settings,
+			modelRegistry,
+		});
+		const ui = new RpcVirtualUi({ output: () => {}, columns: 80, rows: 24, externalRenderer: true });
+		ui.start();
+		const mode = new InteractiveMode(
+			session,
+			"rpc-test",
+			undefined,
+			() => {},
+			undefined,
+			undefined,
+			undefined,
+			new Composer({ tui: ui.tui, preferences: { quiet: true } }),
+		);
+		return { session, mode, ui };
+	}
+
+	async function disposeHarness(harness: Awaited<ReturnType<typeof createHarness>>): Promise<void> {
+		harness.mode.stop();
+		harness.ui.close("test_done");
+		await harness.session.dispose();
+	}
+
+	it("isolates throwing extension disposers during shutdown", async () => {
+		const harness = await createHarness();
+		await harness.mode.prepareRpcTuiSurface();
+		const disposed: string[] = [];
+		harness.mode.composer.setExtensionHeader({
+			render: () => ["header"],
+			invalidate() {},
+			dispose() {
+				disposed.push("header");
+				throw new Error("fixture");
+			},
+		});
+		harness.mode.composer.setExtensionFooter({
+			render: () => ["footer"],
+			invalidate() {},
+			dispose() {
+				disposed.push("footer");
+				throw new Error("fixture");
+			},
+		});
+		expect(() => harness.mode.stop()).not.toThrow();
+		expect(disposed).toEqual(["header", "footer"]);
+		harness.ui.close("test_done");
+		await harness.session.dispose();
+	});
+
+	it("mounts one shared TUI and dispatches selector commands through it", async () => {
+		const harness = await createHarness();
+		try {
+			await harness.mode.prepareRpcTuiSurface();
+			const selector = vi.spyOn(harness.mode, "showSettingsSelector").mockImplementation(() => {});
+
+			expect(await executeBuiltinSlashCommand("/settings", { ctx: harness.mode })).toBe(true);
+			expect(selector).toHaveBeenCalledTimes(1);
+			expect(harness.mode.ui).toBe(harness.ui.tui);
+		} finally {
+			await disposeHarness(harness);
+		}
+	});
+
+	it("routes loop and goal TUI commands without installing the main editor submitter", async () => {
+		const harness = await createHarness();
+		try {
+			const received: SubmittedUserInput[] = [];
+			await harness.mode.prepareRpcTuiSurface({
+				onInput: input => {
+					received.push(input);
+				},
+			});
+
+			const loopPrompt = await executeBuiltinSlashCommand("/loop 2 repeat this", { ctx: harness.mode });
+			expect(loopPrompt).toBe("repeat this");
+			harness.mode.setLoopPrompt(loopPrompt as string);
+			const submission = harness.mode.startPendingSubmission({
+				text: loopPrompt as string,
+				streamingBehavior: "steer",
+			});
+			harness.mode.onInputCallback?.(submission);
+			expect(received).toHaveLength(1);
+			expect(received[0]?.text).toBe("repeat this");
+
+			const goal = vi.spyOn(harness.mode, "handleGoalModeCommand").mockResolvedValue(false);
+			expect(await executeBuiltinSlashCommand("/goal set ship it", { ctx: harness.mode })).toBe(true);
+			expect(goal).toHaveBeenCalledWith("set ship it", undefined);
+
+			const prompt = vi.spyOn(harness.session, "prompt").mockResolvedValue(true);
+			harness.mode.editor.submit();
+			expect(prompt).not.toHaveBeenCalled();
+		} finally {
+			await disposeHarness(harness);
+		}
+	});
+});
