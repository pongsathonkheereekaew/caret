+async function pathsReferToSameDocument(requestedPath: string, responsePath: string, untitled = false): Promise<boolean> {
+	if (requestedPath === responsePath) return true;
+	if (untitled || isUntitledEditorPath(requestedPath) || isUntitledEditorPath(responsePath)) {
+		return requestedPath === responsePath;
+	}
+	const [requested, response] = await Promise.all([
+		canonicalDocumentPath(requestedPath),
+		canonicalDocumentPath(responsePath),
+	]);
