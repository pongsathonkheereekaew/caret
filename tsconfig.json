{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["packages/**/*.ts", "apps/host/**/*.ts", "apps/macos/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["apps/ios", "apps/macos/agent-window", "**/node_modules", "**/dist"]
}
