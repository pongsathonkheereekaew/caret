{
	"name": "caret",
	"displayName": "%displayName%",
	"description": "%description%",
	"publisher": "caret",
	"version": "0.0.1",
	"license": "MIT",
	"private": true,
	"engines": {
		"vscode": "^1.138.0"
	},
	"categories": [
		"AI",
		"Other"
	],
	"activationEvents": [
		"onView:caretComposer"
	],
	"main": "./out/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "caretAgents",
					"title": "%viewsContainers.caretAgents%",
					"icon": "media/caret.svg"
				}
			]
		},
		"views": {
			"caretAgents": [
				{
					"id": "caretComposer",
					"name": "%views.caretComposer%",
					"type": "webview"
				}
			]
		},
		"commands": [
			{
				"command": "caret.reviewRun",
				"title": "%commands.reviewRun%",
				"category": "Caret"
			},
			{
				"command": "caret.rejectRun",
				"title": "%commands.rejectRun%",
				"category": "Caret"
			},
			{
				"command": "caret.toggleTab",
				"title": "%commands.toggleTab%",
				"category": "Caret"
			},
			{
				"command": "caret.snoozeTab",
				"title": "%commands.snoozeTab%",
				"category": "Caret"
			},
			{
				"command": "caret.inlineEdit",
				"title": "%commands.inlineEdit%",
				"category": "Caret"
			},
			{
				"command": "caret.refineProposal",
				"title": "%commands.refineProposal%",
				"category": "Caret"
			},
			{
				"command": "caret.applyProposal",
				"title": "%commands.applyProposal%",
				"category": "Caret"
			},
			{
				"command": "caret.rejectProposal",
				"title": "%commands.rejectProposal%",
				"category": "Caret"
			},
			{
				"command": "caret.generateCommand",
				"title": "%commands.generateCommand%",
				"category": "Caret"
			},
			{
				"command": "caret.sendToAgent",
				"title": "%commands.sendToAgent%",
				"category": "Caret"
			},
			{
				"command": "caret.searchExact",
				"title": "%commands.searchExact%",
				"category": "Caret"
			},
			{
				"command": "caret.initIgnore",
				"title": "%commands.initIgnore%",
				"category": "Caret"
			}
		],
		"keybindings": [
			{
				"command": "caret.inlineEdit",
				"key": "ctrl+k",
				"mac": "cmd+k",
				"when": "editorTextFocus && editorHasSelection && !editorReadonly"
			}
		],
		"configuration": {
			"title": "Caret Tab",
			"properties": {
				"caret.tab.endpoint": {
					"type": "string",
					"default": "http://127.0.0.1:8080",
					"description": "Caret FIM endpoint (llama-server /infill). Local-first; no code leaves the machine."
				},
				"caret.tab.timeoutMs": {
					"type": "number",
					"default": 1200,
					"description": "Per-request timeout. Slow responses are discarded, never queued."
				},
				"caret.tab.disabledLanguages": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"markdown",
						"plaintext"
					],
					"description": "Languages where ghost text never triggers."
				}
			}
		}
	},
	"scripts": {
		"compile": "tsc -p ./"
	},
	"devDependencies": {
		"@types/node": "^24.13.4"
	},
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false,
			"description": "Caret runs agent commands in your workspace. Open a trusted folder to use it."
		}
	}
}